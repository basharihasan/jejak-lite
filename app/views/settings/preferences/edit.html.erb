<% content_for :title, "Pengaturan Saya" %>

<div class="max-w-2xl space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Pengaturan Saya</h1>
    <p class="mt-1 text-sm text-slate-500">Preferensi tampilan berlaku untuk akun Anda di semua perangkat.</p>
  </div>

  <%= form_with model: current_user, url: update_appearance_settings_path, method: :patch,
        class: "bg-white rounded-2xl ring-1 ring-slate-200 shadow-sm p-6 space-y-6" do |f| %>
    <% if current_user.errors.any? %>
      <div class="rounded-lg bg-red-50 border border-red-200 p-3 text-sm text-red-800">
        <%= current_user.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <fieldset>
      <legend class="text-sm font-semibold text-slate-800">Mode warna</legend>
      <p class="text-xs text-slate-500 mb-3">Tombol matahari di topbar juga mengganti ini secara langsung.</p>
      <div class="grid grid-cols-3 gap-3">
        <% { "light" => "Terang", "dark" => "Gelap", "system" => "Ikuti sistem" }.each do |value, label| %>
          <label class="flex items-center gap-2 rounded-xl border border-slate-200 px-3 py-2.5 text-sm cursor-pointer hover:bg-slate-50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
            <%= f.radio_button :theme_preference, value, class: "text-indigo-600 focus:ring-indigo-500",
                  onchange: "window.applyAhsTheme(this.value)" %>
            <span><%= label %></span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <fieldset>
      <legend class="text-sm font-semibold text-slate-800">Ukuran huruf</legend>
      <p class="text-xs text-slate-500 mb-3">Seluruh antarmuka ikut membesar atau mengecil secara proporsional.</p>
      <div class="grid grid-cols-3 gap-3">
        <% { "small" => "Kecil", "normal" => "Normal", "large" => "Besar" }.each do |value, label| %>
          <label class="flex items-center gap-2 rounded-xl border border-slate-200 px-3 py-2.5 text-sm cursor-pointer hover:bg-slate-50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
            <%= f.radio_button :font_size_preference, value, class: "text-indigo-600 focus:ring-indigo-500",
                  onchange: "window.applyAhsFontSize(this.value)" %>
            <span><%= label %></span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <div class="flex justify-end">
      <%= f.submit "Simpan Preferensi", class: "inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
    </div>
  <% end %>

  <div class="bg-white rounded-2xl ring-1 ring-slate-200 shadow-sm p-6">
    <h2 class="text-sm font-semibold text-slate-800">Akun</h2>
    <p class="mt-1 text-xs text-slate-500">Ganti email atau kata sandi di <%= link_to "Pengaturan Akun", edit_user_registration_path, class: "text-indigo-600 font-medium" %>; data profil di <%= link_to "Edit Profil", edit_profile_path, class: "text-indigo-600 font-medium" %>.</p>
  </div>
</div>
