<div class="flex items-center justify-between">
  <h1 class="text-xl font-bold text-gray-900">Periode Akademik</h1>
  <%= link_to "+ Periode Baru", new_academic_period_path,
        class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl text-sm" %>
</div>

<div class="mt-4 space-y-2">
  <% @academic_periods.each do |period| %>
    <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-4 flex items-center justify-between">
      <div>
        <p class="font-semibold text-gray-800"><%= period.name %></p>
        <p class="text-xs text-gray-400 mt-0.5"><%= l(period.start_date, format: :long) %> — <%= l(period.end_date, format: :long) %></p>
      </div>
      <div class="flex items-center gap-3">
        <%= link_to "Sunting", edit_academic_period_path(period), class: "text-sm text-gray-600 hover:text-indigo-600 font-medium" %>
        <%= button_to "Hapus", academic_period_path(period), method: :delete,
              class: "text-sm text-rose-600 hover:underline",
              form: { data: { turbo_confirm: "Hapus periode ini? Rotasi yang mengacu ke periode ini juga akan terhapus." } } %>
      </div>
    </div>
  <% end %>
  <% if @academic_periods.empty? %>
    <p class="text-sm text-gray-400">Belum ada periode akademik.</p>
  <% end %>
</div>
