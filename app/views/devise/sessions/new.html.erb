<div class="max-w-md mx-auto bg-white rounded-2xl shadow-sm ring-1 ring-gray-200 p-8">
  <h2 class="text-xl font-bold mb-6">Masuk</h2>

  <%# Formulir autentikasi dikirim sebagai POST biasa (data-turbo=false):
    Turbo menolak jawaban yang "tidak diarahkan", dan ekstensi browser yang
    membungkus fetch bisa menghapus penanda redirect itu, sehingga login
    yang sebenarnya berhasil tampak diam. %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4", data: { turbo: false } }) do |f| %>
    <div>
      <%= f.label :email, "Email", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>

    <div>
      <%= f.label :password, "Kata Sandi", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.password_field :password, autocomplete: "current-password",
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2 text-sm text-gray-600">
        <%= f.check_box :remember_me, class: "rounded border-gray-300" %>
        <%= f.label :remember_me, "Ingat saya", class: "cursor-pointer" %>
      </label>
    <% end %>

    <%= f.submit "Masuk",
          class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-xl text-sm cursor-pointer" %>
  <% end %>

  <% if Devise.omniauth_providers.include?(:google_oauth2) %>
    <div class="mt-4">
      <%# OmniAuth hanya menerima POST dan mengarahkan ke domain Google — tanpa
          rails-ujs, link_to method: :post terkirim sebagai GET (gagal), dan
          fetch Turbo tak bisa mengikuti redirect lintas domain. %>
      <%= button_to "Masuk dengan Google", user_google_oauth2_omniauth_authorize_path, method: :post,
            form: { data: { turbo: false } },
            class: "block text-center w-full border border-gray-300 hover:bg-gray-50 font-semibold py-2.5 rounded-xl text-sm cursor-pointer" %>
    </div>
  <% end %>

  <div class="mt-6 text-sm text-gray-500">
    <%= render "devise/shared/links" %>
  </div>
</div>
