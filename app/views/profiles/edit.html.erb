<div class="max-w-lg bg-white rounded-2xl ring-1 ring-gray-200 p-6">
  <h1 class="text-lg font-bold mb-4">Sunting Profil</h1>

  <%= form_with model: @user, url: profile_path, method: :patch, html: { class: "space-y-4" } do |f| %>
    <% if @user.errors.any? %>
      <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
        <%= @user.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= f.label :full_name, "Nama Lengkap", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :full_name,
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>

    <div>
      <%= f.label :avatar, "Foto Profil", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.file_field :avatar, accept: "image/*", class: "text-sm" %>
    </div>

    <% if @user.has_role?("mahasiswa") %>
      <div>
        <%= f.label :study_program_id, "Program Studi", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.collection_select :study_program_id, StudyProgram.order(:name), :id, :name, { include_blank: "Pilih program studi..." },
              class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
      </div>
    <% end %>

    <%= f.submit "Simpan",
          class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl text-sm cursor-pointer" %>
  <% end %>
</div>
