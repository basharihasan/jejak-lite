<% content_for :title, "Enrolment Tutorial" %>
<div class="flex items-center justify-between flex-wrap gap-3">
  <div>
    <h1 class="text-xl font-bold text-gray-900">Enrolment Tutorial</h1>
    <p class="text-sm text-gray-500 mt-0.5">Mahasiswa ↔ blok/sistem ↔ dosen tutor per periode akademik (Sarjana Kedokteran).</p>
  </div>
  <% if current_user.has_role?("admin") %>
    <div class="flex items-center gap-2">
      <%= link_to "Kelola Periode", academic_periods_path, class: "text-sm text-gray-600 hover:text-indigo-600 font-medium" %>
      <%= link_to "+ Tambah Enrolment", new_tutorial_enrollment_path,
            class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl text-sm" %>
    </div>
  <% end %>
</div>

<div class="mt-4 space-y-2">
  <% @enrollments.each do |enrollment| %>
    <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
      <div class="flex items-start justify-between gap-3 flex-wrap">
        <div class="min-w-0">
          <span class="text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full <%= enrollment.active? ? 'bg-emerald-50 text-emerald-700' : 'bg-gray-100 text-gray-500' %>">
            <%= enrollment.status_label %>
          </span>
          <p class="mt-1.5 font-semibold text-gray-800">
            <%= enrollment.block_name %>
            <% if enrollment.group_name.present? %><span class="text-gray-400 font-normal">· <%= enrollment.group_name %></span><% end %>
          </p>
          <p class="text-xs text-gray-400 mt-1">
            <% if enrollment.start_date && enrollment.end_date %>
              <%= l(enrollment.start_date, format: :long) %> — <%= l(enrollment.end_date, format: :long) %> ·
            <% end %>
            <%= enrollment.academic_period.name %>
          </p>
          <p class="text-xs text-gray-400 mt-0.5">
            <% if enrollment.user != current_user %>Mahasiswa: <%= enrollment.user.full_name %><% end %>
            <% if enrollment.tutor.present? %>
              <%= " · " if enrollment.user != current_user %>Tutor: <%= enrollment.tutor.full_name %>
            <% end %>
          </p>
        </div>
        <% if current_user.has_role?("admin") %>
          <div class="flex items-center gap-2 shrink-0">
            <%= button_to (enrollment.active? ? "Tandai Selesai" : "Aktifkan"), toggle_active_tutorial_enrollment_path(enrollment), method: :patch,
                  class: "text-sm text-gray-600 hover:text-indigo-600 font-medium" %>
            <%= link_to "Sunting", edit_tutorial_enrollment_path(enrollment), class: "text-sm text-gray-600 hover:text-indigo-600 font-medium" %>
            <%= button_to "Hapus", tutorial_enrollment_path(enrollment), method: :delete,
                  class: "text-sm text-rose-600 hover:underline",
                  form: { data: { turbo_confirm: "Hapus enrolment ini?" } } %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  <% if @enrollments.empty? %>
    <p class="text-sm text-gray-400">Belum ada enrolment tutorial.</p>
  <% end %>
</div>
