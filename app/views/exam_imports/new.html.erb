<div class="max-w-lg">
  <h1 class="text-xl font-bold text-gray-900 mb-1">Impor Skor Ujian</h1>
  <p class="text-sm text-gray-500 mb-6">Format CSV: kolom <code class="bg-gray-100 px-1 rounded">email</code>, <code class="bg-gray-100 px-1 rounded">score</code>, <code class="bg-gray-100 px-1 rounded">exam_date</code>, dan <code class="bg-gray-100 px-1 rounded">max_score</code> (opsional, default 100).</p>

  <% if flash[:alert] %>
    <div class="mb-4 rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm"><%= flash[:alert] %></div>
  <% end %>

  <%= form_with url: exam_imports_path, method: :post, multipart: true, class: "space-y-4" do %>
    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-1">Jenis Ujian</label>
      <%= select_tag :kind, options_for_select(ExamImport::KINDS.invert),
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>

    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-1">Nama Batch (opsional)</label>
      <%= text_field_tag :name, nil, placeholder: "Contoh: CBT Blok Kardiovaskular Sept 2026",
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>

    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-1">Berkas CSV</label>
      <%= file_field_tag :file, accept: ".csv", class: "text-sm" %>
    </div>

    <%= submit_tag "Impor", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm cursor-pointer" %>
  <% end %>

  <%= link_to "← Riwayat Impor", exam_imports_path, class: "mt-6 inline-block text-sm text-gray-500 hover:text-indigo-600" %>
</div>
