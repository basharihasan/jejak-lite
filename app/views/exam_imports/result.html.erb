<div class="max-w-lg">
  <h1 class="text-xl font-bold text-gray-900 mb-6">Hasil Impor</h1>

  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5 space-y-2">
    <p class="text-sm text-gray-700">Batch: <span class="font-semibold"><%= @import_result.exam_import.name %></span> (<%= @import_result.exam_import.kind_label %>)</p>
    <p class="text-sm text-emerald-600 font-semibold"><%= @import_result.imported_count %> skor berhasil diimpor</p>

    <% if @import_result.unmatched_emails.any? %>
      <div class="mt-3">
        <p class="text-xs font-semibold text-amber-600 uppercase mb-1">Email tidak dikenali (<%= @import_result.unmatched_emails.size %>)</p>
        <ul class="text-xs text-gray-500 list-disc list-inside">
          <% @import_result.unmatched_emails.each do |email| %>
            <li><%= email %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if @import_result.errors.any? %>
      <div class="mt-3">
        <p class="text-xs font-semibold text-rose-600 uppercase mb-1">Baris gagal (<%= @import_result.errors.size %>)</p>
        <ul class="text-xs text-gray-500 list-disc list-inside">
          <% @import_result.errors.each do |err| %>
            <li><%= err %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>

  <div class="mt-4 flex items-center gap-3">
    <%= link_to "Lihat Detail Batch", exam_import_path(@import_result.exam_import), class: "text-sm text-indigo-600 font-medium" %>
    <%= link_to "Impor Lagi", new_exam_import_path, class: "text-sm text-gray-500 hover:text-indigo-600" %>
  </div>
</div>
