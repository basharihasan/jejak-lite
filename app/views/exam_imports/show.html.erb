<div class="max-w-xl">
  <h1 class="text-xl font-bold text-gray-900"><%= @exam_import.name %></h1>
  <p class="text-sm text-gray-400 mt-1"><%= @exam_import.kind_label %> · <%= @exam_scores.count %> skor</p>

  <div class="mt-4 space-y-1.5">
    <% @exam_scores.each do |score| %>
      <div class="flex items-center justify-between text-sm bg-white ring-1 ring-gray-200 rounded-xl px-4 py-2.5">
        <span class="text-gray-700"><%= score.student.full_name %></span>
        <span class="font-semibold text-indigo-600"><%= score.score %>/<%= score.max_score %> (<%= score.percentage %>%)</span>
      </div>
    <% end %>
  </div>

  <%= link_to "← Riwayat Impor", exam_imports_path, class: "mt-6 inline-block text-sm text-gray-500 hover:text-indigo-600" %>
</div>
