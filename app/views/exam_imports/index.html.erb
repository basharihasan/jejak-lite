<div class="flex items-center justify-between">
  <h1 class="text-xl font-bold text-gray-900">Riwayat Impor Skor Ujian</h1>
  <%= link_to "+ Impor Baru", new_exam_import_path,
        class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl text-sm" %>
</div>

<div class="mt-4 space-y-2">
  <% @exam_imports.each do |import| %>
    <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-4 flex items-center justify-between">
      <div>
        <p class="font-semibold text-gray-800"><%= import.name %> <span class="text-xs font-normal text-gray-400">(<%= import.kind_label %>)</span></p>
        <p class="text-xs text-gray-400 mt-0.5">
          <%= import.row_count %> skor · diimpor oleh <%= import.imported_by.full_name %> · <%= l(import.created_at.to_date, format: :long) %>
          <% if import.unmatched_count.positive? %> · <%= import.unmatched_count %> email tak dikenali<% end %>
        </p>
      </div>
      <div class="flex items-center gap-3">
        <%= link_to "Detail", exam_import_path(import), class: "text-sm text-indigo-600 font-medium" %>
        <%= button_to "Hapus", exam_import_path(import), method: :delete,
              class: "text-sm text-rose-600 hover:underline",
              form: { data: { turbo_confirm: "Hapus batch ini beserta semua skornya?" } } %>
      </div>
    </div>
  <% end %>
  <% if @exam_imports.empty? %>
    <p class="text-sm text-gray-400">Belum ada impor.</p>
  <% end %>
</div>
