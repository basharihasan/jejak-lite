<%# Bingkai satu modul "Mahasiswa Bimbingan Anda" — dipakai lewat
    render layout: "dashboard/mentee_panel". Locals: title, dot (kelas warna
    titik), count (jumlah mahasiswa unik). %>
<div class="rounded-xl bg-white shadow-sm border border-slate-200 overflow-hidden">
  <div class="border-b border-slate-100 px-5 py-4 bg-slate-50 flex justify-between items-center gap-3">
    <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
      <span class="h-2 w-2 rounded-full <%= dot %>"></span>
      <%= title %>
    </h3>
    <span class="text-xs text-slate-500 font-medium"><%= count %> mahasiswa</span>
  </div>
  <%= yield %>
</div>
