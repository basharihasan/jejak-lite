<%# "Mahasiswa Bimbingan Anda" — dikelompokkan menurut peran pengajar terhadap
    mahasiswa: preseptor rotasi klinik yang sedang berjalan, tutor blok aktif,
    dan pembimbing tugas akhir yang belum selesai. Panel preseptor selalu tampil
    bagi peran aktif preseptor (dengan keadaan kosong); panel lain hanya bila
    berisi. Tiap kartu menaut ke Dasbor Mahasiswa (hanya-baca). %>
<%
  button_primary = "flex-1 text-center rounded px-2 py-1.5 text-xs font-semibold text-white"
  button_secondary = "flex-1 text-center rounded bg-slate-100 px-2 py-1.5 text-xs font-semibold text-slate-700 hover:ring-1 hover:ring-slate-300"
  any_panel = @show_preceptor_panel || @tutor_enrollments.any? || @supervised_projects.any?
%>

<% if @show_preceptor_panel %>
  <%= render layout: "dashboard/mentee_panel", locals: { title: "Modul Preseptor Klinis", dot: "bg-emerald-500", count: @preceptor_rotations.map(&:user_id).uniq.size } do %>
    <% if @preceptor_rotations.any? %>
      <ul class="max-h-80 overflow-y-auto divide-y divide-slate-500/10" data-testid="preceptor-mentees">
        <% @preceptor_rotations.each do |rotation| %>
          <% student = rotation.user %>
          <li class="p-4">
            <div class="flex items-start gap-3 mb-3">
              <span class="h-10 w-10 shrink-0 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-sm font-bold"><%= student.full_name.first.upcase %></span>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-bold text-slate-900"><%= link_to student.full_name, student_dashboard_path(student), class: "hover:text-indigo-600 hover:underline" %></p>
                <p class="text-xs text-slate-500"><%= student.identifier_number.presence || "—" %><% if student.study_program %> <span class="mx-1 text-slate-300">•</span> <%= student.study_program.name %><% end %></p>
                <div class="flex flex-wrap gap-1 mt-1">
                  <span class="inline-flex items-center rounded-md px-1.5 py-0.5 text-[10px] font-semibold ring-1 ring-inset bg-teal-50 text-teal-700 ring-teal-600/20">🏥 <%= [ rotation.station_name, rotation.institution_name.presence ].compact.join(" · ") %></span>
                  <span class="inline-flex items-center rounded-md px-1.5 py-0.5 text-[10px] font-semibold ring-1 ring-inset bg-slate-50 text-slate-700 ring-slate-600/20">s.d. <%= agenda_date(rotation.end_date) %></span>
                </div>
              </div>
            </div>
            <div class="flex gap-2">
              <%= link_to "Dasbor", student_dashboard_path(student), class: button_secondary %>
              <%= link_to "DOPS & Mini-CEX", assessments_path(student_id: student.id), class: "#{button_primary} bg-emerald-600 hover:bg-emerald-500" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="p-8 text-center">
        <p class="text-sm text-slate-500 mb-2">Tidak sedang mem-preseptori rotasi klinis saat ini.</p>
        <%= link_to "Lihat jadwal rotasi", clinical_rotations_path, class: "text-xs font-medium text-emerald-600 hover:text-emerald-800 underline" %>
      </div>
    <% end %>
  <% end %>
<% end %>

<% if @tutor_enrollments.any? %>
  <%= render layout: "dashboard/mentee_panel", locals: { title: "Modul Tutor (Blok Aktif)", dot: "bg-sky-500", count: @tutor_enrollments.map(&:user_id).uniq.size } do %>
    <ul class="max-h-72 overflow-y-auto divide-y divide-slate-500/10" data-testid="tutor-mentees">
      <% @tutor_enrollments.each do |enrollment| %>
        <% student = enrollment.user %>
        <li class="p-4">
          <div class="flex items-start gap-3 mb-3">
            <span class="h-10 w-10 shrink-0 rounded-full bg-sky-100 text-sky-700 flex items-center justify-center text-sm font-bold"><%= student.full_name.first.upcase %></span>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-bold text-slate-900"><%= link_to student.full_name, student_dashboard_path(student), class: "hover:text-indigo-600 hover:underline" %></p>
              <p class="text-xs text-slate-500"><%= student.identifier_number.presence || "—" %></p>
              <div class="flex flex-wrap gap-1 mt-1">
                <span class="inline-flex items-center rounded-md px-1.5 py-0.5 text-[10px] font-semibold ring-1 ring-inset bg-sky-50 text-sky-700 ring-sky-600/20"><%= enrollment.block_name %></span>
                <% if enrollment.group_name.present? %>
                  <span class="inline-flex items-center rounded-md px-1.5 py-0.5 text-[10px] font-semibold ring-1 ring-inset bg-slate-50 text-slate-700 ring-slate-600/20"><%= enrollment.group_name %></span>
                <% end %>
              </div>
            </div>
          </div>
          <div class="flex gap-2">
            <%= link_to "Dasbor", student_dashboard_path(student), class: button_secondary %>
            <%= link_to term("nav.academic_assessments"), exam_scores_path(student_id: student.id), class: "#{button_primary} bg-sky-600 hover:bg-sky-500" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<% if @supervised_projects.any? %>
  <%= render layout: "dashboard/mentee_panel", locals: { title: "Pembimbing Tugas Akhir", dot: "bg-amber-500", count: @supervised_projects.map(&:student_id).uniq.size } do %>
    <ul class="max-h-72 overflow-y-auto divide-y divide-slate-500/10" data-testid="final-project-mentees">
      <% @supervised_projects.each do |project| %>
        <%
          milestones = project.final_project_milestones
          done = milestones.count(&:completed?)
          next_milestone = milestones.reject(&:completed?).min_by(&:target_date)
        %>
        <li class="p-4 flex items-center justify-between gap-3">
          <div class="flex items-start gap-3 min-w-0">
            <span class="h-10 w-10 shrink-0 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center text-sm font-bold"><%= project.student.full_name.first.upcase %></span>
            <div class="min-w-0">
              <p class="text-sm font-bold text-slate-900"><%= link_to project.student.full_name, student_dashboard_path(project.student), class: "hover:text-indigo-600 hover:underline" %></p>
              <p class="text-xs text-slate-600 truncate"><%= project.title %></p>
              <p class="mt-1 text-[11px] text-slate-500">
                <span class="font-semibold"><%= project.status_label %></span> · milestone <%= done %>/<%= milestones.size %>
                <% if next_milestone %>
                  · <span class="<%= next_milestone.overdue? ? 'font-semibold text-rose-600' : '' %>">berikutnya: <%= next_milestone.title %> (<%= agenda_date(next_milestone.target_date) %>)</span>
                <% end %>
              </p>
            </div>
          </div>
          <%= link_to "Buka", final_project_path(project), class: "shrink-0 rounded-lg bg-amber-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-amber-500" %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<% unless any_panel %>
  <div class="rounded-xl bg-white shadow-sm border border-slate-200 p-8 text-center" data-testid="mentee-empty">
    <p class="text-sm text-slate-500">Belum ada mahasiswa yang ditautkan ke Anda sebagai preseptor rotasi, tutor blok, atau pembimbing tugas akhir.</p>
    <p class="mt-1 text-xs text-slate-400">Penautan diatur admin lewat Jadwal Rotasi, Enrolment Tutorial, dan Tugas Akhir.</p>
    <%= link_to term("nav.student_directory"), search_path, class: "mt-3 inline-block text-xs font-medium text-indigo-600 hover:text-indigo-800 underline" %>
  </div>
<% end %>
