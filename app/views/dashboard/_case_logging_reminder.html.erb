<%# Pengingat pencatatan kasus (Paket Dasar Pilar A). Kasus yang dicatat
    menyusul ditulis dari ingatan; Beranda adalah halaman yang pasti dibuka.
    Memakai @case_logging_gap dari DashboardController#load_case_logging_reminder. %>
<% if (gap = @case_logging_gap).present? %>
  <div class="rounded-2xl border border-sky-200 bg-sky-50 p-4 shadow-sm">
    <div class="flex items-start gap-3">
      <svg class="h-5 w-5 shrink-0 text-sky-600 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div class="min-w-0 flex-1">
        <p class="text-sm font-bold text-sky-900">
          <% if gap[:days] %>
            Sudah <%= gap[:days] %> hari tidak ada kasus baru yang Anda catat
          <% else %>
            Belum ada satu pun kasus yang Anda catat
          <% end %>
        </p>
        <p class="mt-1 text-sm text-sky-800 leading-relaxed">
          <% if gap[:last_at] %>Catatan terakhir Anda <strong><%= agenda_date(gap[:last_at].to_date) %></strong>.<% end %>
          Kasus yang dicatat menyusul biasanya ditulis dari ingatan — pemeriksaan, obat, dan alasan keputusannya sudah kabur.
          Luangkan beberapa menit selagi masih di wahana.
        </p>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <%= link_to "Catat Kasus Baru", new_clinical_case_path,
                class: "inline-flex items-center rounded-lg bg-sky-600 px-3 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-sky-700" %>
          <%= link_to "Lihat logbook saya →", clinical_cases_path, class: "text-xs font-semibold text-sky-900 underline" %>
        </div>
      </div>
    </div>
  </div>
<% end %>
