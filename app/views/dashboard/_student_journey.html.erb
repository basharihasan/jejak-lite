<%# Perjalanan mahasiswa — padanan dashboard/_student_journey jejak.pro yang
    dipersempit ke data Essential: tahap studi dari jenjang prodi (Sarjana →
    Profesi), fokus rotasi/blok yang sedang berjalan, kelengkapan profil, dan
    "Perhatian Akademik" (pengganti EWS: rekomendasi remediasi & skor
    DOPS/Mini-CEX di bawah harapan dalam 30 hari terakhir). %>
<%
  program = current_user.study_program
  stages = [
    { label: "Pre-Klinik (Sarjana)", active: program&.sarjana?, past: program&.profesi? },
    { label: "Klinik (Profesi)",     active: program&.profesi?, past: false }
  ]
  stats = @student_stats
%>

<% if program %>
  <div class="overflow-x-auto scrollbar-hide" data-testid="study-stages">
    <div class="flex items-center min-w-max gap-3 px-1">
      <% stages.each_with_index do |stage, idx| %>
        <div class="flex items-center gap-2">
          <span class="h-8 w-8 rounded-full flex items-center justify-center shadow-sm <%= stage[:active] ? 'bg-indigo-600 text-white ring-4 ring-indigo-100' : (stage[:past] ? 'bg-emerald-500 text-white' : 'bg-slate-200 text-slate-400') %>">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <% if stage[:past] %>
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              <% else %>
                <circle cx="12" cy="12" r="3.5" fill="currentColor" stroke="none" />
              <% end %>
            </svg>
          </span>
          <span class="text-[11px] font-bold uppercase tracking-tight <%= stage[:active] ? 'text-indigo-600' : 'text-slate-400' %>"><%= stage[:label] %></span>
        </div>
        <% if idx < stages.size - 1 %>
          <span class="h-0.5 w-10 sm:w-16 rounded-full <%= stages[idx + 1][:active] || stages[idx + 1][:past] ? 'bg-emerald-400' : 'bg-slate-200' %>"></span>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6">
  <%# ── Fokus yang sedang berjalan ── %>
  <div class="lg:col-span-2 rounded-2xl bg-white p-6 shadow-sm border border-slate-200 relative overflow-hidden" data-testid="student-focus">
    <div class="pointer-events-none absolute top-0 right-0 -mt-4 -mr-4 h-24 w-24 rounded-full bg-indigo-500/10" aria-hidden="true"></div>
    <div class="relative">
      <%
        if @ongoing_rotation
          badge = "Rotasi Berjalan"
          focus_title = @ongoing_rotation.station_name
          focus_lines = [
            [ @ongoing_rotation.institution_name.presence, "s.d. #{agenda_date(@ongoing_rotation.end_date)}" ].compact.join(" · "),
            (@ongoing_rotation.preceptor ? "Preseptor: #{@ongoing_rotation.preceptor.full_name}" : nil)
          ]
        elsif @active_tutorial
          badge = "Blok Berjalan"
          focus_title = @active_tutorial.block_name
          focus_lines = [
            [ @active_tutorial.group_name.presence, (@active_tutorial.end_date ? "s.d. #{agenda_date(@active_tutorial.end_date)}" : nil) ].compact.join(" · ").presence,
            (@active_tutorial.tutor ? "Tutor: #{@active_tutorial.tutor.full_name}" : nil)
          ]
        elsif @upcoming_rotation
          badge = "Rotasi Berikutnya"
          focus_title = @upcoming_rotation.station_name
          focus_lines = [ [ @upcoming_rotation.institution_name.presence, "mulai #{agenda_date(@upcoming_rotation.start_date)}" ].compact.join(" · ") ]
        else
          badge = "Belum Dijadwalkan"
          focus_title = "Rotasi / blok belum ditetapkan"
          focus_lines = [ "Jadwal rotasi klinik dan blok tutorial diatur admin prodi — akan muncul di sini begitu ditetapkan." ]
        end
        # Mahasiswa yang berotasi sekaligus terdaftar di blok: blok jadi baris tambahan.
        focus_lines << "Blok: #{@active_tutorial.block_name}" if @ongoing_rotation && @active_tutorial
      %>
      <div class="flex items-center justify-between gap-3 mb-3">
        <span class="rounded-full bg-indigo-50 px-3 py-1 text-[10px] font-bold text-indigo-600 uppercase tracking-wider"><%= badge %></span>
        <span class="text-xs text-slate-400"><%= t("date.month_names")[Date.current.month] %> <%= Date.current.year %></span>
      </div>
      <h2 class="text-xl sm:text-2xl font-black text-slate-900"><%= focus_title %></h2>
      <% focus_lines.compact_blank.each do |line| %>
        <p class="mt-0.5 text-sm text-slate-500"><%= line %></p>
      <% end %>

      <div class="mt-5 grid grid-cols-3 gap-3">
        <% [
             [ stats[:activities_this_month], "Kegiatan", "bulan ini", activity_logs_path ],
             [ "#{stats[:cases_verified]}/#{stats[:cases_total]}", "Kasus", "terverifikasi", clinical_cases_path ],
             [ stats[:reflections], "Refleksi", "entri", reflection_entries_path ]
           ].each do |value, label, unit, path| %>
          <%= link_to path, class: "rounded-xl bg-slate-50 p-3 sm:p-4 border border-slate-100 hover:border-indigo-200 transition-colors" do %>
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest"><%= label %></p>
            <p class="mt-1 text-lg font-bold text-slate-900 tabular-nums"><%= value %> <span class="text-xs font-normal text-slate-500"><%= unit %></span></p>
          <% end %>
        <% end %>
      </div>

      <div class="mt-4 flex flex-wrap gap-2">
        <% [ [ "Catat Kasus", new_clinical_case_path ], [ "Catat Kegiatan", new_activity_log_path ], [ "Tulis Refleksi", new_reflection_entry_path ] ].each do |label, path| %>
          <%= link_to path, class: "inline-flex items-center gap-1.5 rounded-lg border border-indigo-200 px-3 py-1.5 text-xs font-semibold text-indigo-700 hover:border-indigo-400 transition-colors" do %>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            <%= label %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <%# ── Kelengkapan profil ── %>
  <div class="rounded-2xl bg-indigo-600 p-6 text-white shadow-xl shadow-indigo-200 flex flex-col justify-between" data-testid="profile-completeness">
    <div>
      <h3 class="text-lg font-bold">Kelengkapan Profil</h3>
      <p class="text-xs text-indigo-100">Identitas, prodi, dan angkatan untuk portofolio Anda</p>
    </div>
    <div class="mt-4">
      <div class="flex items-end justify-between mb-2">
        <span class="text-3xl font-black tabular-nums"><%= @profile_completeness %>%</span>
        <span class="text-xs text-indigo-100 pb-1"><%= @profile_completeness >= 100 ? "Lengkap" : "Belum lengkap" %></span>
      </div>
      <div class="h-2 w-full bg-indigo-400/50 rounded-full">
        <div class="h-2 bg-[#fff] rounded-full" style="width: <%= @profile_completeness %>%"></div>
      </div>
      <% if @missing_profile_fields.any? %>
        <p class="mt-3 text-xs text-indigo-100">Belum diisi: <%= @missing_profile_fields.first(3).join(", ") %><%= "…" if @missing_profile_fields.size > 3 %></p>
      <% end %>
    </div>
    <% if @profile_completeness >= 100 %>
      <%= link_to "Lihat Profil →", profile_path, class: "mt-5 block w-full text-center py-2 bg-white/10 hover:bg-white/20 rounded-lg text-xs font-bold transition-colors" %>
    <% else %>
      <%= link_to "Lengkapi Profil Sekarang →", edit_profile_path, class: "mt-5 block w-full text-center py-2 bg-white/10 hover:bg-white/20 rounded-lg text-xs font-bold transition-colors" %>
    <% end %>
  </div>
</div>

<%# ── Perhatian Akademik (pengganti banner EWS) ── %>
<% if @academic_flags.present? %>
  <% severe = @academic_flags.any? { |f| f[:severity] == :high } %>
  <div class="rounded-xl border p-4 flex items-start gap-4 <%= severe ? 'bg-rose-50 border-rose-200' : 'bg-amber-50 border-amber-200' %>" data-testid="academic-flags">
    <svg class="h-6 w-6 mt-0.5 shrink-0 <%= severe ? 'text-rose-600' : 'text-amber-600' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
    <div class="flex-1 min-w-0">
      <h3 class="font-bold <%= severe ? 'text-rose-800' : 'text-amber-800' %>">Perhatian Akademik</h3>
      <ul class="mt-1 list-disc list-inside text-sm <%= severe ? 'text-rose-800' : 'text-amber-800' %>">
        <% @academic_flags.each do |flag| %>
          <li><span class="font-semibold"><%= flag[:label] %></span> — <%= flag[:detail] %></li>
        <% end %>
      </ul>
      <div class="mt-3 pt-3 border-t flex flex-wrap items-center gap-2 <%= severe ? 'border-rose-200' : 'border-amber-200' %>">
        <span class="text-xs font-semibold <%= severe ? 'text-rose-800' : 'text-amber-800' %>">Apa langkah Anda selanjutnya?</span>
        <%= link_to "Baca Umpan Balik", student_feedback_journal_path,
              class: "inline-flex items-center rounded-lg border bg-white px-3 py-1.5 text-xs font-bold shadow-sm #{severe ? 'border-rose-300 text-rose-700' : 'border-amber-300 text-amber-700'}" %>
        <%= link_to "Tulis Refleksi", new_reflection_entry_path,
              class: "inline-flex items-center rounded-lg border bg-white px-3 py-1.5 text-xs font-bold shadow-sm #{severe ? 'border-rose-300 text-rose-700' : 'border-amber-300 text-amber-700'}" %>
      </div>
    </div>
  </div>
<% end %>
