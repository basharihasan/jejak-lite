<%# Sapaan Beranda — padanan dashboard/_welcome_header jejak.pro. Peran • prodi
    • angkatan/unit kerja menjadi satu-satunya identitas di beranda (tidak ada
    kartu "Informasi Anda" terpisah). Jam dicetak server (WIB) lalu dijaga
    berjalan oleh live_clock_controller. Teks putih di atas gradien tetap
    terbaca di mode gelap, jadi tidak perlu retrofit. %>
<%
  now = Time.current
  program = current_user.study_program
  meta = [
    program&.name,
    (current_user.cohort_year.present? ? "Angkatan #{current_user.cohort_year}" : nil),
    (@dashboard_mode == :student ? nil : current_user.work_unit.presence)
  ].compact
%>
<div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-indigo-600 via-indigo-700 to-violet-700 p-5 sm:p-6 shadow-xl shadow-indigo-300/30"
     data-testid="welcome-header">
  <div class="pointer-events-none absolute -top-8 -right-8 h-40 w-40 rounded-full bg-white/10" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-10 right-24 h-28 w-28 rounded-full bg-white/5" aria-hidden="true"></div>
  <div class="pointer-events-none absolute top-6 right-1/3 h-1.5 w-1.5 rounded-full bg-yellow-300/60 animate-pulse" aria-hidden="true"></div>

  <div class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center gap-4">
    <div class="h-12 w-12 sm:h-14 sm:w-14 shrink-0 rounded-2xl bg-white/15 flex items-center justify-center ring-1 ring-white/20 text-[#fff]" aria-hidden="true">
      <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
      </svg>
    </div>

    <div class="flex-1 min-w-0">
      <p class="text-[10px] sm:text-xs font-bold text-indigo-200 uppercase tracking-[0.15em]">JEJAK Essential<% if program %> &middot; <%= program.level_label %><% end %></p>
      <h1 class="mt-0.5 text-lg sm:text-2xl font-black text-[#fff] leading-tight tracking-tight">
        Selamat datang, <span class="text-yellow-300"><%= current_user.full_name %></span>!
      </h1>
      <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1">
        <span class="inline-flex items-center gap-1.5 text-xs text-indigo-200">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
          <%= @active_role&.name || "Belum ada peran" %>
        </span>
        <% meta.each do |part| %>
          <span class="text-xs text-indigo-200 hidden sm:inline">&bull; <%= part %></span>
        <% end %>
      </div>
    </div>

    <div class="hidden sm:flex flex-col items-end gap-0.5 shrink-0" data-controller="live-clock">
      <span class="text-xl font-black text-[#fff] tabular-nums" data-live-clock-target="time"><%= now.strftime("%H:%M") %></span>
      <span class="text-[10px] text-indigo-200 font-semibold uppercase tracking-wide">WIB &bull; <%= now.day %> <%= t("date.abbr_month_names")[now.month] %> <%= now.year %></span>
    </div>
  </div>
</div>
