<%# Agenda Mendatang — semua hal berjadwal milik pengguna ini dalam 7 hari ke
    depan, apa pun perannya: kegiatan kalender, rotasi klinik & blok tutorial
    yang mulai/berakhir, jadwal DOPS/Mini-CEX, ujian & batas pengumpulan
    asesmen, serta tenggat tugas akhir. @upcoming_agenda berisi
    DashboardController::AgendaItem; pemformatannya di DashboardHelper. %>
<%
  agenda_all     = @upcoming_agenda.to_a
  agenda_visible = agenda_all.first(DashboardHelper::AGENDA_DISPLAY_LIMIT)
  agenda_hidden  = agenda_all.size - agenda_visible.size
%>
<div id="agenda-mendatang" class="rounded-xl bg-white shadow-sm border border-indigo-200 overflow-hidden scroll-mt-24" data-testid="upcoming-agenda">
  <div class="border-b border-indigo-100 px-5 py-4 bg-indigo-50 flex justify-between items-start gap-3">
    <div>
      <h3 class="text-sm font-bold text-indigo-900 flex items-center gap-2">
        <svg class="w-4 h-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
        </svg>
        Agenda Mendatang
      </h3>
      <p class="mt-1 text-xs text-indigo-700">7 hari ke depan — kegiatan, jadwal, dan tenggat Anda</p>
    </div>
    <% if agenda_all.any? %>
      <span class="shrink-0 inline-flex items-center rounded-full bg-indigo-100 px-2 py-0.5 text-[11px] font-bold text-indigo-700">
        <%= agenda_all.size %> agenda
      </span>
    <% end %>
  </div>

  <% if agenda_all.empty? %>
    <div class="px-5 py-8 text-center">
      <div class="mx-auto h-10 w-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"/></svg>
      </div>
      <p class="mt-3 text-sm font-semibold text-slate-700">Tidak ada agenda dalam 7 hari ke depan.</p>
      <p class="mt-1 text-xs text-slate-500">Rotasi, jadwal penilaian, ujian, dan tenggat yang menyangkut Anda akan muncul di sini.</p>
    </div>
  <% else %>
    <div class="divide-y divide-slate-500/10">
      <% agenda_visible.each do |item| %>
        <%= link_to item.path, class: "flex items-start gap-3 px-5 py-4 hover:bg-slate-500/5 transition-colors" do %>
          <span class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full <%= agenda_kind_dot_class(item.kind) %>"></span>

          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-slate-800 truncate"><%= item.title %></p>

            <p class="mt-1 flex items-center gap-1.5 text-xs text-slate-600">
              <svg class="w-3.5 h-3.5 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
              </svg>
              <span class="truncate"><%= agenda_date_line(item) %></span>
            </p>

            <% if item.location.present? || item.person.present? %>
              <p class="mt-0.5 flex items-center gap-1.5 text-xs text-slate-500">
                <svg class="w-3.5 h-3.5 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0Z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0Z"/>
                </svg>
                <span class="truncate"><%= [ item.person, item.location ].compact_blank.join(" • ") %></span>
              </p>
            <% end %>

            <% if item.status_label.present? %>
              <span class="mt-2 inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold ring-1 ring-inset <%= agenda_status_class(item.status_tone) %>">
                <%= item.status_label %>
              </span>
            <% end %>
          </div>

          <p class="shrink-0 text-right text-[11px] font-bold <%= item.days_away.zero? ? 'text-rose-600' : 'text-indigo-700' %>"><%= agenda_countdown(item) %></p>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <div class="px-5 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between gap-3">
    <p class="text-[11px] text-slate-400">
      <% if agenda_hidden.positive? %>
        +<%= agenda_hidden %> agenda lainnya dalam 7 hari ke depan.
      <% else %>
        Agenda dalam 7 hari ke depan.
      <% end %>
    </p>
    <%= link_to "Lihat kalender lengkap →", activity_logs_calendar_path, class: "shrink-0 text-[11px] text-indigo-600 font-semibold hover:underline" %>
  </div>
</div>
