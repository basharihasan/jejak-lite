<h1 class="text-2xl font-bold text-gray-900">Halo, <%= current_user.full_name %> 👋</h1>
<p class="mt-1 text-gray-500">
  Peran aktif: <span class="font-semibold text-indigo-600"><%= @active_role&.name || "Belum ada peran" %></span>
</p>

<div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
    <p class="text-xs font-semibold text-gray-500 uppercase">Kegiatan Bulan Ini</p>
    <p class="text-2xl font-bold text-gray-900 mt-1"><%= @this_month_count %></p>
    <%= link_to "Lihat Logbook →", activity_logs_path, class: "text-xs text-indigo-600 font-medium mt-2 inline-block" %>
  </div>
  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5 sm:col-span-2">
    <p class="text-xs font-semibold text-gray-500 uppercase mb-2">Kegiatan Terbaru</p>
    <% if @recent_activity_logs.any? %>
      <div class="space-y-1.5">
        <% @recent_activity_logs.each do |log| %>
          <%= link_to log, class: "flex items-center justify-between text-sm hover:text-indigo-600" do %>
            <span class="truncate"><%= log.title %></span>
            <span class="text-xs text-gray-400 shrink-0 ml-2"><%= l(log.activity_date, format: :short) %></span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-400">Belum ada kegiatan. <%= link_to "Catat sekarang", new_activity_log_path, class: "text-indigo-600 font-medium" %>.</p>
    <% end %>
  </div>
</div>

<% if @unread_notifications.any? %>
  <div class="mt-4 bg-indigo-50/60 ring-1 ring-indigo-100 rounded-2xl p-5">
    <p class="text-xs font-semibold text-indigo-600 uppercase mb-2">Notifikasi Belum Dibaca</p>
    <div class="space-y-1">
      <% @unread_notifications.each do |n| %>
        <p class="text-sm text-gray-700">• <%= n.title %></p>
      <% end %>
    </div>
    <%= link_to "Lihat semua →", notifications_path, class: "text-xs text-indigo-600 font-medium mt-2 inline-block" %>
  </div>
<% end %>

<h2 class="mt-8 text-sm font-semibold text-gray-500 uppercase tracking-wide">Langkah Berikutnya</h2>
<div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-4">
  <% @next_steps.each do |step| %>
    <%= link_to send(step[:path]), class: "block bg-white rounded-2xl ring-1 ring-gray-200 p-5 hover:ring-indigo-300 transition" do %>
      <p class="text-sm font-semibold text-gray-700"><%= step[:title] %></p>
      <span class="mt-2 inline-block text-sm text-indigo-600 font-medium">Buka →</span>
    <% end %>
  <% end %>
</div>
