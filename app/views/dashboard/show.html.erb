<% content_for(:title) { "Beranda — JEJAK Essential" } %>

<%# Beranda per peran aktif — lihat DashboardController. Urutannya mengikuti
    beranda jejak.pro: sapaan → (mahasiswa) agenda & peringatan → perjalanan
    belajar, atau (pengajar) ringkasan hari ini → tindakan → mahasiswa
    bimbingan dengan agenda di kolom samping. Kartu sponsor AIPKI dan narasi
    jejak.pro tetap tampil untuk semua peran. %>
<div class="space-y-6">
  <%= render "dashboard/welcome_header" %>
  <%= render "dashboard/aipki_card" %>

  <% case @dashboard_mode %>
  <% when :student %>
    <%# Agenda kosong tidak ditampilkan di beranda mahasiswa — tidak mendorong
        peringatan di bawahnya turun tanpa isi. %>
    <%= render "dashboard/upcoming_agenda" if @upcoming_agenda.any? %>
    <%= render "dashboard/student_case_alerts" %>
    <%= render "dashboard/case_logging_reminder" %>
    <%= render "dashboard/student_journey" %>

    <div><%= render "dashboard/assessment_hub" %></div>

    <% if @own_dops_radar || @own_mini_cex_radar %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% if @own_dops_radar %>
          <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
            <p class="text-sm font-semibold text-gray-700 mb-2">Peta Kompetensi DOPS Anda</p>
            <div data-controller="radar-chart"
                 data-radar-chart-labels-value="<%= DopsEvaluation::DIMENSIONS.values.to_json %>"
                 data-radar-chart-datasets-value="<%= [ { label: "Rata-rata", data: DopsEvaluation::DIMENSIONS.keys.map { |k| @own_dops_radar[k] || 0 }, borderColor: "#4f46e5", backgroundColor: "rgba(79,70,229,0.15)" } ].to_json %>">
              <canvas data-radar-chart-target="canvas" height="200"></canvas>
            </div>
          </div>
        <% end %>
        <% if @own_mini_cex_radar %>
          <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
            <p class="text-sm font-semibold text-gray-700 mb-2">Peta Kompetensi Mini-CEX Anda</p>
            <div data-controller="radar-chart"
                 data-radar-chart-labels-value="<%= MiniCexEvaluation::DIMENSIONS.values.to_json %>"
                 data-radar-chart-datasets-value="<%= [ { label: "Rata-rata", data: MiniCexEvaluation::DIMENSIONS.keys.map { |k| @own_mini_cex_radar[k] || 0 }, borderColor: "#059669", backgroundColor: "rgba(5,150,105,0.15)" } ].to_json %>">
              <canvas data-radar-chart-target="canvas" height="200"></canvas>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

  <% when :faculty %>
    <%
      action_scope = [
        ("verifikasi kasus & kegiatan" if @can_verify),
        "penilaian DOPS/Mini-CEX & asesmen",
        "mahasiswa yang perlu perhatian",
        ("jadwal evaluasi dari prodi" if @show_schedule_tile)
      ].compact
    %>
    <%= render "dashboard/faculty_action_summary" %>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 items-start">
      <%# ── Kolom utama: hal yang perlu ditindaklanjuti, lalu mahasiswa bimbingan ── %>
      <div class="xl:col-span-2 space-y-6 min-w-0">
        <%= render "dashboard/section_heading",
              title: "Perlu Tindakan Anda",
              subtitle: "#{action_scope.to_sentence(two_words_connector: ' dan ', last_word_connector: ', dan ').upcase_first}.",
              tone: "amber" %>

        <% if @action_total.zero? %>
          <div class="rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-6 flex items-center gap-4" data-testid="all-clear">
            <div class="h-11 w-11 shrink-0 rounded-2xl bg-emerald-500 text-white flex items-center justify-center shadow-sm">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
            </div>
            <div>
              <p class="text-sm font-bold text-emerald-900">Semua beres — tidak ada tugas yang menunggu Anda.</p>
              <p class="mt-0.5 text-xs text-emerald-700">Verifikasi, penilaian, dan jadwal evaluasi Anda sudah tuntas. Panel akan muncul kembali di sini begitu ada yang perlu ditindaklanjuti.</p>
            </div>
          </div>
        <% end %>

        <%= render "dashboard/pending_verifications" %>
        <%= render "dashboard/pending_grading" %>
        <%= render "dashboard/attention_students" %>
        <%= render "dashboard/scheduled_evaluations" %>

        <%= render "dashboard/section_heading",
              title: "Mahasiswa Bimbingan Anda",
              subtitle: "Dikelompokkan menurut peran Anda terhadap mahasiswa: preseptor klinis, tutor blok, dan pembimbing tugas akhir.",
              tone: "indigo",
              link_label: "#{term('nav.analytics')} →",
              link_path: analytics_path %>

        <%= render "dashboard/mentee_panels" %>
      </div>

      <%# ── Kolom samping: agenda, ringkasan bimbingan, akses cepat ── %>
      <aside class="space-y-6 min-w-0">
        <%= render "dashboard/upcoming_agenda" %>
        <%= render "dashboard/faculty_mentoring_summary" %>
        <%= render "dashboard/faculty_quick_links" %>
      </aside>
    </div>

  <% else %>
    <%= render "dashboard/upcoming_agenda" %>
    <div class="rounded-2xl bg-white shadow-sm border border-slate-200 p-6">
      <p class="text-sm font-semibold text-slate-800">Akun Anda belum memiliki peran.</p>
      <p class="mt-1 text-sm text-slate-500">Hubungi admin prodi untuk menetapkan peran (mahasiswa, dosen, atau preseptor). Sementara itu, lengkapi profil Anda.</p>
      <div class="mt-3 flex flex-wrap gap-3">
        <%= link_to "Lengkapi profil →", edit_profile_path, class: "text-sm font-semibold text-indigo-600 hover:underline" %>
        <%= link_to "Baca Panduan Pengguna →", panduan_path, class: "text-sm font-semibold text-indigo-600 hover:underline" %>
      </div>
    </div>
  <% end %>
</div>

<%= render "dashboard/jejak_pro_upgrade" %>
