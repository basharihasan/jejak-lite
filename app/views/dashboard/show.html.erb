<h1 class="text-2xl font-bold text-gray-900">Halo, <%= current_user.full_name %> 👋</h1>
<p class="mt-1 text-gray-500">
  Peran aktif: <span class="font-semibold text-indigo-600"><%= @active_role&.name || "Belum ada peran" %></span>
</p>

<div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
    <p class="text-xs font-semibold text-gray-500 uppercase">Kegiatan Bulan Ini</p>
    <p class="text-2xl font-bold text-gray-900 mt-1"><%= @this_month_count %></p>
    <%= link_to "Lihat Logbook →", activity_logs_path, class: "text-xs text-indigo-600 font-medium mt-2 inline-block" %>
  </div>
  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5 sm:col-span-2">
    <p class="text-xs font-semibold text-gray-500 uppercase mb-2">Kegiatan Terbaru</p>
    <% if @recent_activity_logs.any? %>
      <div class="space-y-1.5">
        <% @recent_activity_logs.each do |log| %>
          <%= link_to log, class: "flex items-center justify-between text-sm hover:text-indigo-600" do %>
            <span class="truncate"><%= log.title %></span>
            <span class="text-xs text-gray-400 shrink-0 ml-2"><%= l(log.activity_date, format: :short) %></span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-400">Belum ada kegiatan. <%= link_to "Catat sekarang", new_activity_log_path, class: "text-indigo-600 font-medium" %>.</p>
    <% end %>
  </div>
</div>

<% if @ongoing_rotation || @upcoming_rotation %>
  <div class="mt-4 bg-emerald-50/60 ring-1 ring-emerald-100 rounded-2xl p-5">
    <% if @ongoing_rotation %>
      <p class="text-xs font-semibold text-emerald-600 uppercase mb-1">Rotasi Sedang Berlangsung</p>
      <p class="text-sm font-semibold text-gray-800"><%= @ongoing_rotation.station_name %></p>
      <p class="text-xs text-gray-500 mt-0.5">
        s.d. <%= l(@ongoing_rotation.end_date, format: :long) %>
        <% if @ongoing_rotation.institution_name.present? %> · <%= @ongoing_rotation.institution_name %><% end %>
      </p>
    <% elsif @upcoming_rotation %>
      <p class="text-xs font-semibold text-emerald-600 uppercase mb-1">Rotasi Berikutnya</p>
      <p class="text-sm font-semibold text-gray-800"><%= @upcoming_rotation.station_name %></p>
      <p class="text-xs text-gray-500 mt-0.5">Mulai <%= l(@upcoming_rotation.start_date, format: :long) %></p>
    <% end %>
    <%= link_to "Lihat Jadwal Rotasi →", clinical_rotations_path, class: "text-xs text-emerald-700 font-medium mt-2 inline-block" %>
  </div>
<% end %>

<% if @upcoming_schedules.any? || @pending_assessments.any? %>
  <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
    <% if @upcoming_schedules.any? %>
      <div class="bg-sky-50/60 ring-1 ring-sky-100 rounded-2xl p-5">
        <p class="text-xs font-semibold text-sky-700 uppercase mb-2">Jadwal DOPS / Mini-CEX Mendatang</p>
        <div class="space-y-1.5">
          <% @upcoming_schedules.each do |s| %>
            <div class="text-sm text-gray-800"><span class="font-semibold"><%= s.kind_label %></span> · <%= l(s.scheduled_at, format: :short) %>
              <span class="text-xs text-gray-500">· <%= s.student_id == current_user.id ? (s.evaluator&.full_name || "penilai belum ditetapkan") : s.student.full_name %><%= " · #{s.topic}" if s.topic.present? %></span></div>
          <% end %>
        </div>
      </div>
    <% end %>
    <% if @pending_assessments.any? %>
      <div class="bg-amber-50/60 ring-1 ring-amber-100 rounded-2xl p-5">
        <p class="text-xs font-semibold text-amber-700 uppercase mb-2">Asesmen Menunggu</p>
        <div class="space-y-1.5">
          <% @pending_assessments.each do |i| %>
            <%= link_to student_assessment_path(i), class: "block text-sm text-gray-800 hover:text-indigo-600" do %>
              <span class="font-semibold"><%= i.assessment_event.name %></span> <span class="text-xs text-gray-500">· <%= i.type_label %> · <%= i.status_label %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<% if @unread_notifications.any? %>
  <div class="mt-4 bg-indigo-50/60 ring-1 ring-indigo-100 rounded-2xl p-5">
    <p class="text-xs font-semibold text-indigo-600 uppercase mb-2">Notifikasi Belum Dibaca</p>
    <div class="space-y-1">
      <% @unread_notifications.each do |n| %>
        <p class="text-sm text-gray-700">• <%= n.title %></p>
      <% end %>
    </div>
    <%= link_to "Lihat semua →", notifications_path, class: "text-xs text-indigo-600 font-medium mt-2 inline-block" %>
  </div>
<% end %>

<% if @draft_evaluations_count || @pending_verifications_count %>
  <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
    <% if @draft_evaluations_count&.positive? %>
      <%= link_to assessments_path, class: "block bg-amber-50/60 ring-1 ring-amber-100 rounded-2xl p-5 hover:ring-amber-300 transition" do %>
        <p class="text-xs font-semibold text-amber-600 uppercase">Evaluasi Draf Belum Dikirim</p>
        <p class="text-2xl font-bold text-gray-900 mt-1"><%= @draft_evaluations_count %></p>
      <% end %>
    <% end %>
    <% if @pending_verifications_count&.positive? && current_user.can_verify_clinical_cases? %>
      <%= link_to clinical_cases_path(scope: "to_verify"), class: "block bg-rose-50/60 ring-1 ring-rose-100 rounded-2xl p-5 hover:ring-rose-300 transition" do %>
        <p class="text-xs font-semibold text-rose-600 uppercase">Kasus Klinis Menunggu Verifikasi</p>
        <p class="text-2xl font-bold text-gray-900 mt-1"><%= @pending_verifications_count %></p>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if @own_dops_radar || @own_mini_cex_radar %>
  <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
    <% if @own_dops_radar %>
      <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
        <p class="text-sm font-semibold text-gray-700 mb-2">Peta Kompetensi DOPS Anda</p>
        <div data-controller="radar-chart"
             data-radar-chart-labels-value="<%= DopsEvaluation::DIMENSIONS.values.to_json %>"
             data-radar-chart-datasets-value="<%= [ { label: "Rata-rata", data: DopsEvaluation::DIMENSIONS.keys.map { |k| @own_dops_radar[k] || 0 }, borderColor: "#4f46e5", backgroundColor: "rgba(79,70,229,0.15)" } ].to_json %>">
          <canvas data-radar-chart-target="canvas" height="200"></canvas>
        </div>
      </div>
    <% end %>
    <% if @own_mini_cex_radar %>
      <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
        <p class="text-sm font-semibold text-gray-700 mb-2">Peta Kompetensi Mini-CEX Anda</p>
        <div data-controller="radar-chart"
             data-radar-chart-labels-value="<%= MiniCexEvaluation::DIMENSIONS.values.to_json %>"
             data-radar-chart-datasets-value="<%= [ { label: "Rata-rata", data: MiniCexEvaluation::DIMENSIONS.keys.map { |k| @own_mini_cex_radar[k] || 0 }, borderColor: "#059669", backgroundColor: "rgba(5,150,105,0.15)" } ].to_json %>">
          <canvas data-radar-chart-target="canvas" height="200"></canvas>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<h2 class="mt-8 text-sm font-semibold text-gray-500 uppercase tracking-wide">Langkah Berikutnya</h2>
<div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-4">
  <% @next_steps.each do |step| %>
    <%= link_to send(step[:path]), class: "block bg-white rounded-2xl ring-1 ring-gray-200 p-5 hover:ring-indigo-300 transition" do %>
      <p class="text-sm font-semibold text-gray-700"><%= step[:title] %></p>
      <span class="mt-2 inline-block text-sm text-indigo-600 font-medium">Buka →</span>
    <% end %>
  <% end %>
</div>
