<h1 class="text-2xl font-bold text-gray-900">Halo, <%= current_user.full_name %> 👋</h1>
<p class="mt-1 text-gray-500">
  Peran aktif: <span class="font-semibold text-indigo-600"><%= @active_role&.name || "Belum ada peran" %></span>
</p>

<div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
    <p class="text-sm font-semibold text-gray-700">Profil</p>
    <p class="text-xs text-gray-400 mt-1">Lengkapi data diri Anda.</p>
    <%= link_to "Buka Profil →", profile_path, class: "mt-3 inline-block text-sm text-indigo-600 font-medium" %>
  </div>
</div>
