  links = []
  if @can_verify
    links << { label: term("nav.case_validation"), hint: "antrean verifikasi logbook kasus", path: clinical_cases_path(scope: "to_verify"), icon: :case }
    links << { label: term("nav.activity_validation"), hint: "antrean validasi logbook kegiatan", path: activity_logs_path(scope: "to_verify"), icon: :calendar }
  end
  links << { label: term("nav.workplace_assessment"), hint: "DOPS & Mini-CEX", path: assessments_path, icon: :check }
  links << { label: term("nav.rubric_assessment"), hint: "lembar penguji asesmen", path: examiner_evaluations_path, icon: :star }
  links << { label: term("nav.analytics"), hint: "mahasiswa bimbingan & prodi", path: analytics_path, icon: :chart }
  links << { label: term("nav.student_directory"), hint: "cari & buka dasbor mahasiswa", path: search_path, icon: :users }
  links << { label: term("nav.calendar"), hint: "kegiatan & jadwal lengkap", path: activity_logs_calendar_path, icon: :calendar }
  if current_user.has_role?("admin")
    links << { label: term("nav.evaluation_schedules"), hint: "jadwalkan penilai DOPS/Mini-CEX", path: admin_evaluation_schedules_path, icon: :cog }
    links << { label: term("nav.users"), hint: "kelola akun & peran", path: admin_users_path, icon: :cog }
  end
%>
<div id="akses-cepat" class="rounded-xl bg-white shadow-sm border border-slate-200 overflow-hidden" data-testid="faculty-quick-links">
  <div class="border-b border-slate-100 px-5 py-4 bg-slate-50">
    <h3 class="text-sm font-bold text-slate-900">Akses Cepat</h3>
    <p class="mt-1 text-xs text-slate-500">Halaman yang paling sering Anda buka.</p>
  </div>
  <ul class="divide-y divide-slate-500/10">
    <% links.each do |l| %>
      <li>
        <%= link_to l[:path], class: "group flex items-center gap-3 px-5 py-3 hover:bg-indigo-500/5 transition-colors" do %>
          <span class="h-8 w-8 shrink-0 rounded-lg bg-slate-100 text-slate-500 flex items-center justify-center group-hover:text-indigo-600 transition-colors">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="<%= icons.fetch(l[:icon]) %>"/></svg>
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-sm font-semibold text-slate-800 group-hover:text-indigo-700 truncate"><%= l[:label] %></span>
            <span class="block text-[11px] text-slate-400 truncate"><%= l[:hint] %></span>
          </span>
          <svg class="h-4 w-4 shrink-0 text-slate-300 group-hover:text-indigo-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
