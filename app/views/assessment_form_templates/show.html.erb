<div class="max-w-2xl">
  <div class="flex items-center justify-between flex-wrap gap-3">
    <div>
      <h1 class="text-xl font-bold text-gray-900"><%= @template.name %></h1>
      <p class="text-sm text-gray-500 mt-1"><%= @template.description %></p>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <% if @template.is_active? %>
        <%= link_to "Isi Formulir", new_assessment_form_template_assessment_form_submission_path(@template),
              class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl text-sm" %>
      <% end %>
      <% if policy(@template).update? %>
        <%= link_to "Sunting", edit_assessment_form_template_path(@template), class: "text-sm text-gray-600 hover:text-indigo-600 font-medium" %>
        <%= button_to "Hapus", @template, method: :delete,
              class: "text-sm text-rose-600 hover:underline",
              form: { data: { turbo_confirm: "Hapus formulir ini beserta semua jawabannya?" } } %>
      <% end %>
    </div>
  </div>

  <% if policy(@template).update? %>
    <div class="mt-6 bg-white rounded-2xl ring-1 ring-gray-200 p-5">
      <div class="flex items-center justify-between mb-3">
        <p class="text-sm font-semibold text-gray-700">Pertanyaan</p>
        <%= link_to "+ Tambah Pertanyaan", new_assessment_form_template_assessment_form_field_path(@template),
              class: "text-xs text-indigo-600 font-medium" %>
      </div>
      <% fields = @template.assessment_form_fields.ordered.to_a %>
      <% scorable = fields.select(&:scorable?) %>
      <% if scorable.any? %>
        <p class="text-[11px] text-gray-500 mb-2 bg-indigo-50/60 rounded-lg px-3 py-2">
          Rubrik bernilai: <%= scorable.size %> pertanyaan skor, total bobot <%= scorable.sum { |f| f.weight.to_f }.round(2) %>,
          <%= scorable.count(&:mapped?) %> dipetakan ke ranah kompetensi.
          Nilai asesmen dihitung otomatis dari jawaban penguji (rata-rata terbobot).
        </p>
      <% elsif fields.any? %>
        <p class="text-[11px] text-gray-500 mb-2 bg-amber-50 rounded-lg px-3 py-2">
          Belum ada pertanyaan bertipe skor — formulir ini naratif saja, jadi nilai asesmen tetap diketik penguji.
        </p>
      <% end %>
      <div class="space-y-2">
        <% fields.each_with_index do |field, index| %>
          <div class="flex items-center justify-between text-sm bg-gray-50 rounded-lg px-3 py-2 gap-3">
            <div class="min-w-0">
              <span class="text-gray-400 text-xs mr-1"><%= index + 1 %>.</span>
              <span class="text-gray-700"><%= field.label %></span>
              <span class="text-xs text-gray-400 ml-2">
                (<%= field.field_type_label %><%= field.required? ? ", wajib" : "" %><%= field.scorable? ? ", bobot #{field.weight.to_f.round(2)}" : "" %>)
              </span>
              <% if field.competency_item %>
                <span class="ml-1 text-[10px] font-bold px-2 py-0.5 rounded-full bg-violet-50 text-violet-700"><%= field.competency_item.title %></span>
              <% elsif field.scorable? %>
                <span class="ml-1 text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-50 text-amber-700">belum dipetakan</span>
              <% end %>
              <% if field.help_text.present? %><span class="block text-[11px] text-gray-400 mt-0.5"><%= field.help_text %></span><% end %>
              <% if field.option_based? %>
                <span class="block text-[11px] text-gray-500 mt-0.5">
                  <%= field.option_rows.map { |row| field.field_type == "select" ? row[:label] : "#{row[:label]} (#{row[:score]})" }.join(" · ") %>
                </span>
              <% end %>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <% unless index.zero? %>
                <%= button_to "↑", move_up_assessment_form_template_assessment_form_field_path(@template, field), method: :patch,
                      class: "text-xs text-gray-500 hover:text-indigo-600", form: { class: "inline" } %>
              <% end %>
              <% unless index == fields.size - 1 %>
                <%= button_to "↓", move_down_assessment_form_template_assessment_form_field_path(@template, field), method: :patch,
                      class: "text-xs text-gray-500 hover:text-indigo-600", form: { class: "inline" } %>
              <% end %>
              <%= link_to "Sunting", edit_assessment_form_template_assessment_form_field_path(@template, field), class: "text-xs text-gray-500 hover:text-indigo-600" %>
              <%= button_to "Hapus", assessment_form_template_assessment_form_field_path(@template, field), method: :delete,
                    class: "text-xs text-rose-500 hover:underline", form: { class: "inline", data: { turbo_confirm: "Hapus pertanyaan ini#{field.answered? ? ' beserta jawaban yang sudah masuk' : ''}?" } } %>
            </div>
          </div>
        <% end %>
        <% if @template.assessment_form_fields.empty? %>
          <p class="text-sm text-gray-400">Belum ada pertanyaan. Tambahkan dulu sebelum formulir bisa diisi.</p>
        <% end %>
      </div>
    </div>

    <% events = AssessmentEvent.where(assessment_form_template: @template).ordered %>
    <% if events.any? %>
      <div class="mt-4 bg-white rounded-2xl ring-1 ring-gray-200 p-5">
        <p class="text-sm font-semibold text-gray-700 mb-2">Dipakai sebagai rubrik pada Assessment Event</p>
        <ul class="space-y-1 text-sm">
          <% events.each do |event| %>
            <li><%= link_to event.name, admin_assessment_event_path(event), class: "text-indigo-600 hover:underline" %>
              <span class="text-xs text-gray-400">· <%= event.type_label %> · <%= event.status_label %></span></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mt-4">
      <p class="text-sm font-semibold text-gray-700 mb-2">Jawaban Masuk (<%= @template.assessment_form_submissions.count %>)</p>
      <div class="space-y-1.5">
        <% @template.assessment_form_submissions.recent.limit(10).each do |submission| %>
          <%= link_to assessment_form_submission_path(submission), class: "block bg-white rounded-xl ring-1 ring-gray-200 p-3 text-sm hover:ring-indigo-300" do %>
            <%= submission.respondent_visible_to?(current_user) ? submission.respondent.full_name : "Anonim" %>
            <span class="text-xs text-gray-400">· <%= l(submission.submitted_at, format: :long) %></span>
          <% end %>
        <% end %>
        <% if @template.assessment_form_submissions.empty? %>
          <p class="text-sm text-gray-400">Belum ada jawaban masuk.</p>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= link_to "← Kembali ke Formulir Evaluasi", assessment_form_templates_path, class: "mt-6 inline-block text-sm text-gray-500 hover:text-indigo-600" %>
</div>
