<% content_for :title, "Jurnal Umpan Balik" %>
<div class="max-w-3xl space-y-4">
  <div>
    <h1 class="text-xl font-bold text-gray-900">Jurnal Umpan Balik Penguji</h1>
    <p class="text-sm text-gray-500 mt-0.5">Seluruh umpan balik tertulis dari penguji — rubrik, CBD/Long Case, DOPS, Mini-CEX — dalam satu linimasa.</p>
  </div>

  <% if @entries.empty? %>
    <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-6 text-sm text-gray-400">Belum ada umpan balik tertulis.</div>
  <% end %>

  <div class="space-y-3">
    <% @entries.each do |entry| %>
      <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
        <div class="flex items-baseline justify-between flex-wrap gap-2">
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700"><%= entry[:kind] %></span>
            <span class="ml-2 text-sm font-semibold text-gray-800"><%= entry[:title] %></span>
          </div>
          <p class="text-xs text-gray-400"><%= entry[:at] ? l(entry[:at], format: :long) : "" %><%= " · #{entry[:by]}" if entry[:by] %><%= " · #{entry[:score]}#{entry[:kind] =~ /DOPS|Mini/ ? '' : '%'}" if entry[:score] %></p>
        </div>
        <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3">
          <% if entry[:keep].present? %>
            <div class="bg-emerald-50 rounded-xl p-3"><p class="text-[10px] font-bold uppercase text-emerald-700">Pertahankan</p><p class="text-sm text-gray-700 mt-1 whitespace-pre-line"><%= entry[:keep] %></p></div>
          <% end %>
          <% if entry[:improve].present? %>
            <div class="bg-amber-50 rounded-xl p-3 <%= 'sm:col-span-2' if entry[:keep].blank? %>"><p class="text-[10px] font-bold uppercase text-amber-700"><%= entry[:kind] =~ /DOPS|Mini/ ? "Umpan balik" : "Tingkatkan" %></p><p class="text-sm text-gray-700 mt-1 whitespace-pre-line"><%= entry[:improve] %></p></div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
