<h1 class="text-xl font-bold text-gray-900">Pencarian</h1>

<%= form_with url: search_path, method: :get, class: "mt-4" do |f| %>
  <%= f.text_field :q, value: @query, placeholder: "Cari nama atau email pengguna...",
        class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
<% end %>

<% if @query.present? %>
  <div class="mt-6 space-y-2">
    <% if @users.any? %>
      <% @users.each do |user| %>
        <%# Seluruh kartu jadi tautan: admin → sunting pengguna; pengajar/
            kaprodi → Peta EPA mahasiswa. Selain itu kartu tetap tanpa tautan. %>
        <% target = if current_user.has_role?("admin") then edit_admin_user_path(user)
                    elsif current_user.can_view_students? && user.has_role?("mahasiswa") then entrustment_decisions_path(student_id: user.id)
                    end %>
        <%= content_tag (target ? :a : :div), (target ? { href: target } : {}).merge(class: "bg-white rounded-xl ring-1 ring-gray-200 p-4 flex items-center gap-3 #{'hover:ring-indigo-300 hover:bg-indigo-50/40 transition-colors' if target}") do %>
          <span class="h-9 w-9 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center text-sm font-semibold">
            <%= user.full_name.first.upcase %>
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold text-gray-800"><%= user.full_name %></p>
            <p class="text-xs text-gray-400"><%= user.email %><%= " · #{user.roles.map(&:name).join(', ')}" if user.roles.any? %></p>
          </div>
          <% if target %>
            <span class="shrink-0 text-xs font-semibold text-indigo-600"><%= current_user.has_role?("admin") ? "Sunting" : "Peta EPA" %> →</span>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <p class="text-sm text-gray-400">Tidak ada pengguna yang cocok dengan "<%= @query %>".</p>
    <% end %>
  </div>
<% end %>
