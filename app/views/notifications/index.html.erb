<style>
  .pagination { display: flex; gap: 0.25rem; margin-top: 1.5rem; justify-content: center; }
  .pagination span, .pagination a { padding: 0.4rem 0.75rem; border-radius: 0.5rem; font-size: 0.8rem; }
  .pagination a { color: #4f46e5; border: 1px solid #e5e7eb; }
  .pagination a:hover { background: #eef2ff; }
  .pagination .current { background: #4f46e5; color: white; font-weight: 600; }
  .pagination .page.disabled { color: #d1d5db; }
</style>

<div class="flex items-center justify-between flex-wrap gap-2">
  <h1 class="text-xl font-bold text-gray-900">Notifikasi</h1>
  <% if current_user.notifications.unread.any? %>
    <%= button_to "Tandai semua dibaca", mark_all_read_notifications_path, method: :patch,
          class: "text-sm text-indigo-600 font-medium hover:underline" %>
  <% end %>
</div>

<div data-controller="push-subscription" class="mt-3 flex items-center gap-3 bg-indigo-50/60 ring-1 ring-indigo-100 rounded-xl px-4 py-3">
  <button type="button" data-push-subscription-target="button" data-action="push-subscription#toggle"
          class="text-sm font-semibold text-indigo-700 bg-white ring-1 ring-indigo-200 rounded-lg px-3 py-1.5 hover:bg-indigo-100">
    Aktifkan Notifikasi Push
  </button>
  <span data-push-subscription-target="status" class="text-xs text-gray-500"></span>
</div>

<div id="notifications-list" class="mt-4 space-y-2">
  <% if @notifications.any? %>
    <%= render @notifications %>
  <% else %>
    <p class="text-sm text-gray-400">Belum ada notifikasi.</p>
  <% end %>
</div>

<%= paginate @notifications %>
