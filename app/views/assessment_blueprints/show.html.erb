<div class="max-w-2xl">
  <div class="flex items-center justify-between flex-wrap gap-3">
    <div>
      <h1 class="text-xl font-bold text-gray-900"><%= @assessment_blueprint.name %></h1>
      <p class="text-sm text-gray-400 mt-1"><%= @assessment_blueprint.description %></p>
    </div>
    <% if policy(@assessment_blueprint).update? %>
      <div class="flex items-center gap-2 shrink-0">
        <%= link_to "Sunting", edit_assessment_blueprint_path(@assessment_blueprint), class: "text-sm text-gray-600 hover:text-indigo-600 font-medium" %>
        <%= button_to "Hapus", assessment_blueprint_path(@assessment_blueprint), method: :delete,
              class: "text-sm text-rose-600 hover:underline",
              form: { data: { turbo_confirm: "Hapus blueprint ini?" } } %>
      </div>
    <% end %>
  </div>

  <div class="mt-4 bg-white rounded-2xl ring-1 ring-gray-200 p-5">
    <div class="flex items-center justify-between mb-3">
      <p class="text-sm font-semibold text-gray-700">Peta Bobot Kompetensi</p>
      <span class="text-xs font-bold px-2 py-0.5 rounded-full <%= @assessment_blueprint.total_weight == 100 ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
        Total <%= @assessment_blueprint.total_weight.round(1) %>%
      </span>
    </div>
    <% if @assessment_blueprint.competency_mapping.present? %>
      <%= pie_chart @assessment_blueprint.competency_mapping, height: "260px" %>
    <% else %>
      <p class="text-sm text-gray-400">Belum ada peta bobot.</p>
    <% end %>
  </div>

  <% if @assessment_blueprint.learning_outcomes.present? %>
    <div class="mt-4 bg-indigo-50/50 rounded-2xl ring-1 ring-indigo-100 p-5">
      <p class="text-xs font-semibold text-indigo-500 uppercase mb-2">Capaian Pembelajaran</p>
      <ul class="list-disc list-inside space-y-1 text-sm text-gray-700">
        <% @assessment_blueprint.learning_outcomes.each do |outcome| %>
          <li><%= outcome %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= link_to "← Kembali ke Daftar Blueprint", assessment_blueprints_path, class: "mt-6 inline-block text-sm text-gray-500 hover:text-indigo-600" %>
</div>
