<div class="flex items-center justify-between">
  <h1 class="text-xl font-bold text-gray-900">Blueprint Asesmen</h1>
  <%= link_to "+ Blueprint Baru", new_assessment_blueprint_path,
        class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl text-sm" %>
</div>
<p class="text-sm text-gray-400 mt-1">Rencana cakupan asesmen — seberapa besar bobot tiap ranah kompetensi.</p>

<div class="mt-4 space-y-2">
  <% @assessment_blueprints.each do |blueprint| %>
    <%= link_to assessment_blueprint_path(blueprint), class: "block bg-white rounded-2xl ring-1 ring-gray-200 p-4 hover:ring-indigo-300" do %>
      <div class="flex items-center justify-between">
        <p class="font-semibold text-gray-800"><%= blueprint.name %></p>
        <span class="text-xs font-bold px-2 py-0.5 rounded-full <%= blueprint.total_weight == 100 ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
          <%= blueprint.total_weight.round(1) %>%
        </span>
      </div>
      <p class="text-xs text-gray-400 mt-1"><%= blueprint.description %></p>
    <% end %>
  <% end %>
  <% if @assessment_blueprints.empty? %>
    <p class="text-sm text-gray-400">Belum ada blueprint asesmen.</p>
  <% end %>
</div>
