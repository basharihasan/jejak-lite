<h1 class="text-xl font-bold text-gray-900">Dashboard Analitik</h1>
<p class="text-sm text-gray-400 mt-1">Ringkasan progres mahasiswa dari sudut pandang peran Anda.</p>

<% if @mentee_snapshots %>
  <div class="mt-6">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Mahasiswa Bimbingan</h2>
    <% if @mentee_snapshots.any? %>
      <div class="bg-white rounded-2xl ring-1 ring-gray-200 overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-xs text-gray-400 uppercase border-b border-gray-100">
              <th class="px-4 py-2.5">Mahasiswa</th>
              <th class="px-4 py-2.5">Kegiatan Bulan Ini</th>
              <th class="px-4 py-2.5">Rata-rata DOPS</th>
              <th class="px-4 py-2.5">Rata-rata Mini-CEX</th>
              <th class="px-4 py-2.5">Kasus Klinis</th>
            </tr>
          </thead>
          <tbody>
            <% @mentee_snapshots.each do |s| %>
              <tr class="border-b border-gray-50 last:border-0">
                <td class="px-4 py-2.5 font-medium text-gray-800"><%= s[:user].full_name %></td>
                <td class="px-4 py-2.5"><%= s[:activity_logs_this_month] %></td>
                <td class="px-4 py-2.5"><%= s[:avg_dops] || "-" %><%= "/9" if s[:avg_dops] %></td>
                <td class="px-4 py-2.5"><%= s[:avg_mini_cex] || "-" %><%= "/9" if s[:avg_mini_cex] %></td>
                <td class="px-4 py-2.5"><%= s[:cases_verified] %>/<%= s[:cases_total] %> terverifikasi</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-gray-400">Belum ada mahasiswa bimbingan (belum membimbing tugas akhir atau menilai DOPS/Mini-CEX siapa pun).</p>
    <% end %>
  </div>
<% end %>

<% if @preceptor_rotation_snapshots %>
  <div class="mt-8">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Mahasiswa di Wahana Anda</h2>
    <% if @preceptor_rotation_snapshots.any? %>
      <div class="bg-white rounded-2xl ring-1 ring-gray-200 overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-xs text-gray-400 uppercase border-b border-gray-100">
              <th class="px-4 py-2.5">Mahasiswa</th>
              <th class="px-4 py-2.5">Stase</th>
              <th class="px-4 py-2.5">Status</th>
              <th class="px-4 py-2.5">Kegiatan Selama Rotasi</th>
              <th class="px-4 py-2.5">DOPS / Mini-CEX</th>
            </tr>
          </thead>
          <tbody>
            <% @preceptor_rotation_snapshots.each do |s| %>
              <tr class="border-b border-gray-50 last:border-0">
                <td class="px-4 py-2.5 font-medium text-gray-800"><%= s[:rotation].user.full_name %></td>
                <td class="px-4 py-2.5"><%= s[:rotation].station_name %></td>
                <td class="px-4 py-2.5">
                  <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-gray-100 text-gray-600"><%= s[:rotation].status_label %></span>
                </td>
                <td class="px-4 py-2.5"><%= s[:activity_logs_during] %></td>
                <td class="px-4 py-2.5"><%= s[:dops_count] %> / <%= s[:mini_cex_count] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-gray-400">Belum ada mahasiswa yang dibimbing di rotasi mana pun.</p>
    <% end %>
  </div>
<% end %>

<% if @study_programs %>
  <div class="mt-8">
    <div class="flex items-center justify-between flex-wrap gap-3 mb-3">
      <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Program Studi</h2>
      <% if @study_programs.size > 1 %>
        <%= form_with url: analytics_path, method: :get do %>
          <select name="study_program_id" onchange="this.form.requestSubmit()"
                class="rounded-xl border-0 py-1.5 px-3 text-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500">
            <% @study_programs.each do |program| %>
              <option value="<%= program.id %>" <%= "selected" if @selected_program == program %>><%= program.name %></option>
            <% end %>
          </select>
        <% end %>
      <% elsif @selected_program %>
        <span class="text-sm font-semibold text-indigo-600"><%= @selected_program.name %></span>
      <% end %>
    </div>

    <% if @selected_program.nil? %>
      <p class="text-sm text-gray-400">Belum ada program studi yang terhubung dengan akun Anda.</p>
    <% elsif @program_snapshots.empty? %>
      <p class="text-sm text-gray-400">Belum ada mahasiswa terdaftar di <%= @selected_program.name %>.</p>
    <% else %>
      <div class="grid sm:grid-cols-3 gap-4 mb-4">
        <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-4">
          <p class="text-xs font-semibold text-gray-500 uppercase">Total Mahasiswa</p>
          <p class="text-2xl font-bold text-gray-900 mt-1"><%= @program_snapshots.size %></p>
        </div>
        <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-4">
          <p class="text-xs font-semibold text-gray-500 uppercase">Rata-rata DOPS Prodi</p>
          <% scores = @program_snapshots.filter_map { |s| s[:avg_dops] } %>
          <p class="text-2xl font-bold text-gray-900 mt-1"><%= scores.any? ? (scores.sum / scores.size).round(1) : "-" %></p>
        </div>
        <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-4">
          <p class="text-xs font-semibold text-gray-500 uppercase">Kasus Klinis Terverifikasi</p>
          <p class="text-2xl font-bold text-gray-900 mt-1">
            <%= @program_snapshots.sum { |s| s[:cases_verified] } %>/<%= @program_snapshots.sum { |s| s[:cases_total] } %>
          </p>
        </div>
      </div>

      <div class="bg-white rounded-2xl ring-1 ring-gray-200 overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-xs text-gray-400 uppercase border-b border-gray-100">
              <th class="px-4 py-2.5">Mahasiswa</th>
              <th class="px-4 py-2.5">Kegiatan Bulan Ini</th>
              <th class="px-4 py-2.5">Rata-rata DOPS</th>
              <th class="px-4 py-2.5">Rata-rata Mini-CEX</th>
              <th class="px-4 py-2.5">Kasus Klinis</th>
            </tr>
          </thead>
          <tbody>
            <% @program_snapshots.each do |s| %>
              <tr class="border-b border-gray-50 last:border-0">
                <td class="px-4 py-2.5 font-medium text-gray-800"><%= s[:user].full_name %></td>
                <td class="px-4 py-2.5"><%= s[:activity_logs_this_month] %></td>
                <td class="px-4 py-2.5"><%= s[:avg_dops] || "-" %><%= "/9" if s[:avg_dops] %></td>
                <td class="px-4 py-2.5"><%= s[:avg_mini_cex] || "-" %><%= "/9" if s[:avg_mini_cex] %></td>
                <td class="px-4 py-2.5"><%= s[:cases_verified] %>/<%= s[:cases_total] %> terverifikasi</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
<% end %>
