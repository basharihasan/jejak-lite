<!DOCTYPE html>
<html class="h-full" lang="id">
  <head>
    <title>Persetujuan Pasien — JEJAK</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link href="/vendor/fonts/inter/inter.css" rel="stylesheet">
    <%= stylesheet_link_tag :tailwind, "data-turbo-track": "reload" %>
    <style>* { font-family: 'Inter', system-ui, -apple-system, sans-serif; }</style>
  </head>
  <body class="min-h-full bg-slate-50 antialiased">
    <main class="mx-auto max-w-lg px-4 py-8">
      <% if notice.present? %>
        <div class="rounded-lg bg-green-50 border border-green-200 text-green-800 px-4 py-3 text-sm mb-4"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="rounded-lg bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm mb-4"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
