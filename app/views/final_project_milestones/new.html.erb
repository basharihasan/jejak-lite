<div class="max-w-md">
  <h1 class="text-xl font-bold text-gray-900 mb-6">Tambah Milestone</h1>
  <%= form_with model: @milestone, url: final_project_final_project_milestones_path(@final_project), class: "space-y-4" do |f| %>
    <% if @milestone.errors.any? %>
      <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
        <%= @milestone.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= f.label :title, "Judul Milestone", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :title, placeholder: "Contoh: Seminar Proposal",
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>

    <div>
      <%= f.label :target_date, "Target Tanggal", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.date_field :target_date,
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>

    <%= f.submit "Simpan", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm cursor-pointer" %>
  <% end %>
</div>
