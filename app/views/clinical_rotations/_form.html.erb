<%= form_with model: clinical_rotation, class: "space-y-4" do |f| %>
  <% if clinical_rotation.errors.any? %>
    <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
      <%= clinical_rotation.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :user_id, "Mahasiswa", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.collection_select :user_id, @students, :id, :full_name, { include_blank: "Pilih mahasiswa..." },
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm", data: { controller: "searchable-select" } %>
    </div>
    <div>
      <%= f.label :preceptor_id, "Preseptor (opsional)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.collection_select :preceptor_id, @preceptors, :id, :full_name, { include_blank: "-" },
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm", data: { controller: "searchable-select" } %>
    </div>
  </div>

  <div>
    <%= f.label :academic_period_id, "Periode Akademik", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.collection_select :academic_period_id, @academic_periods, :id, :name, { include_blank: "Pilih periode..." },
          class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    <% if @academic_periods.empty? %>
      <p class="text-xs text-amber-600 mt-1"><%= link_to "Belum ada periode akademik — buat dulu di sini.", new_academic_period_path, class: "underline" %></p>
    <% end %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :station_name, "Bagian/Departemen", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :station_name, placeholder: "Contoh: Ilmu Penyakit Dalam",
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
    <div>
      <%= f.label :institution_name, "Wahana (opsional)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :institution_name, placeholder: "Contoh: RSUP Dr. Hasan Sadikin",
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :start_date, "Tanggal Mulai", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.date_field :start_date,
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
    <div>
      <%= f.label :end_date, "Tanggal Selesai", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.date_field :end_date,
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
  </div>

  <%= f.submit "Simpan", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm cursor-pointer" %>
<% end %>
