<% status_colors = {
  "akan_datang" => "bg-sky-50 text-sky-700",
  "berlangsung" => "bg-emerald-50 text-emerald-700",
  "selesai" => "bg-gray-100 text-gray-500"
} %>

<div class="flex items-center justify-between flex-wrap gap-3">
  <h1 class="text-xl font-bold text-gray-900">Jadwal Rotasi</h1>
  <% if current_user.has_role?("admin") %>
    <div class="flex items-center gap-2">
      <%= link_to "Kelola Periode", academic_periods_path, class: "text-sm text-gray-600 hover:text-indigo-600 font-medium" %>
      <%= link_to "+ Tambah Rotasi", new_clinical_rotation_path,
            class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl text-sm" %>
    </div>
  <% end %>
</div>

<div class="mt-4 space-y-2">
  <% @rotations.each do |rotation| %>
    <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
      <div class="flex items-start justify-between gap-3 flex-wrap">
        <div class="min-w-0">
          <span class="text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full <%= status_colors[rotation.status] %>">
            <%= rotation.status_label %>
          </span>
          <p class="mt-1.5 font-semibold text-gray-800"><%= rotation.station_name %></p>
          <p class="text-xs text-gray-400 mt-1">
            <%= l(rotation.start_date, format: :long) %> — <%= l(rotation.end_date, format: :long) %>
            <% if rotation.institution_name.present? %> · <%= rotation.institution_name %><% end %>
          </p>
          <p class="text-xs text-gray-400 mt-0.5">
            <% if rotation.user != current_user %>Mahasiswa: <%= rotation.user.full_name %><% end %>
            <% if rotation.preceptor.present? %>
              <%= " · " if rotation.user != current_user %>Preseptor: <%= rotation.preceptor.full_name %>
            <% end %>
            · <%= rotation.academic_period.name %>
          </p>
        </div>
        <% if current_user.has_role?("admin") %>
          <div class="flex items-center gap-2 shrink-0">
            <%= link_to "Sunting", edit_clinical_rotation_path(rotation), class: "text-sm text-gray-600 hover:text-indigo-600 font-medium" %>
            <%= button_to "Hapus", clinical_rotation_path(rotation), method: :delete,
                  class: "text-sm text-rose-600 hover:underline",
                  form: { data: { turbo_confirm: "Hapus rotasi ini?" } } %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  <% if @rotations.empty? %>
    <p class="text-sm text-gray-400">Belum ada rotasi terjadwal.</p>
  <% end %>
</div>
