<% content_for :title, "Dasbor Mahasiswa — #{@student.full_name}" %>
<div class="space-y-6">
  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-6 flex items-start gap-4 flex-wrap">
    <span class="h-14 w-14 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center text-xl font-bold shrink-0"><%= @student.full_name.first.upcase %></span>
    <div class="min-w-0 flex-1">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Dasbor Mahasiswa</p>
      <h1 class="text-xl font-bold text-gray-900"><%= @student.full_name %></h1>
      <p class="text-sm text-gray-500"><%= @student.email %>
        <% if @student.identifier_number.present? %> · <%= @student.identifier_label %> <%= @student.identifier_number %><% end %>
        <% if @student.study_program %> · <%= @student.study_program.name %><% end %>
        <% if @student.cohort_year %> · angkatan <%= @student.cohort_year %><% end %></p>
      <% if @ongoing_rotation %>
        <p class="text-xs text-emerald-700 mt-1">Rotasi berjalan: <strong><%= @ongoing_rotation.station_name %></strong> s.d. <%= l(@ongoing_rotation.end_date, format: :long) %></p>
      <% end %>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <% if @can_edit %>
        <%= link_to "Sunting akun", edit_admin_user_path(@student), class: "text-xs font-semibold rounded-xl ring-1 ring-gray-300 px-3 py-2 hover:bg-gray-50" %>
      <% end %>
      <%= link_to "Peta EPA", entrustment_decisions_path(student_id: @student.id), class: "text-xs font-semibold rounded-xl bg-indigo-600 text-white px-3 py-2 hover:bg-indigo-700" %>
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4" data-testid="student-stats">
    <% [ [ @scored_count, "Nilai tercatat" ], [ @pending_count, "Asesmen menunggu" ], [ @activity_count, "Kegiatan logbook" ], [ @verified_case_count, "Kasus terverifikasi" ] ].each do |val, label| %>
      <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-4">
        <p class="text-2xl font-bold text-gray-900"><%= val %></p>
        <p class="text-[10px] font-semibold uppercase tracking-wide text-gray-400"><%= label %></p>
      </div>
    <% end %>
  </div>

  <%= render "dashboard/assessment_hub", student: @student, pending_count: @pending_count %>
</div>
