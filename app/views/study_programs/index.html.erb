<% content_for :title, "Program Studi" %>
<div class="flex items-center justify-between flex-wrap gap-3">
  <div>
    <h1 class="text-xl font-bold text-gray-900">Program Studi</h1>
    <p class="text-sm text-gray-500 mt-0.5">Kode mengikuti JEJAK: <code>pssk</code> Sarjana Kedokteran, <code>pspd</code> Profesi Dokter.</p>
  </div>
  <%= link_to "+ Tambah Prodi", new_study_program_path,
        class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl text-sm" %>
</div>

<div class="mt-4 bg-white rounded-2xl ring-1 ring-gray-200 overflow-hidden">
  <table class="min-w-full text-sm">
    <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
      <tr>
        <th class="text-left px-5 py-3">Nama</th>
        <th class="text-left px-5 py-3">Kode</th>
        <th class="text-left px-5 py-3">Jenjang</th>
        <th class="text-right px-5 py-3">Pengguna</th>
        <th class="px-5 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @study_programs.each do |sp| %>
        <tr>
          <td class="px-5 py-3 font-semibold text-gray-800"><%= sp.name %></td>
          <td class="px-5 py-3"><code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded"><%= sp.code %></code></td>
          <td class="px-5 py-3 text-gray-600"><%= sp.level_label %></td>
          <td class="px-5 py-3 text-right text-gray-600"><%= sp.users.size %></td>
          <td class="px-5 py-3 text-right"><%= link_to "Sunting", edit_study_program_path(sp), class: "text-indigo-600 font-medium hover:underline" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
