<%= form_with model: study_program, class: "space-y-4" do |f| %>
  <% if study_program.errors.any? %>
    <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
      <%= study_program.errors.full_messages.to_sentence %>
    </div>
  <% end %>
  <div>
    <%= f.label :name, "Nama", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :code, "Kode", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :code, placeholder: "pssk", class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
    <div>
      <%= f.label :level, "Jenjang", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.select :level, StudyProgram::LEVELS.invert, {}, class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
  </div>
  <%= f.submit "Simpan", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm cursor-pointer" %>
<% end %>
