<div class="flex items-center justify-between flex-wrap gap-3">
  <h1 class="text-xl font-bold text-gray-900">Portfolio Saya</h1>
  <%= link_to "Unduh CSV", export_portfolio_path,
        class: "text-sm bg-indigo-50 text-indigo-700 font-medium px-4 py-2 rounded-xl hover:bg-indigo-100" %>
</div>

<div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
    <p class="text-xs font-semibold text-gray-500 uppercase">Total Kegiatan</p>
    <p class="text-2xl font-bold text-gray-900 mt-1"><%= @total %></p>
  </div>
  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
    <p class="text-xs font-semibold text-sky-600 uppercase">Klinis</p>
    <p class="text-2xl font-bold text-gray-900 mt-1"><%= @klinis_count %></p>
  </div>
  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
    <p class="text-xs font-semibold text-emerald-600 uppercase">Non-Klinis</p>
    <p class="text-2xl font-bold text-gray-900 mt-1"><%= @non_klinis_count %></p>
  </div>
</div>

<% if @total.positive? %>
  <div class="mt-4 bg-white rounded-2xl ring-1 ring-gray-200 p-5">
    <p class="text-sm font-semibold text-gray-700 mb-3">Tren 6 Bulan Terakhir</p>
    <%= column_chart @monthly_counts, colors: [ "#4f46e5" ], height: "220px" %>
  </div>

  <% if @type_counts.any? %>
    <div class="mt-4 bg-white rounded-2xl ring-1 ring-gray-200 p-5">
      <p class="text-sm font-semibold text-gray-700 mb-3">Jenis Kegiatan Terbanyak</p>
      <%= bar_chart @type_counts, colors: [ "#6366f1" ], height: "220px" %>
    </div>
  <% end %>
<% else %>
  <p class="mt-6 text-sm text-gray-400">Belum ada kegiatan untuk ditampilkan. Mulai catat di Logbook.</p>
<% end %>

<%= link_to "← Kembali ke Logbook", activity_logs_path, class: "mt-6 inline-block text-sm text-gray-500 hover:text-indigo-600" %>
