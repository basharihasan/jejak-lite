<% content_for :title, "Relabel Prodi Mahasiswa" %>
<% input_class = "block w-full rounded-xl border-0 py-2 px-3 text-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500" %>
<div class="max-w-5xl space-y-5">
  <div>
    <% unless prodi_bound_viewer? %>
      <%= link_to "← Pengguna", admin_users_path, class: "text-xs text-gray-500 hover:text-indigo-600" %>
    <% end %>
    <h1 class="text-xl font-bold text-gray-900 mt-1">Relabel Prodi Mahasiswa</h1>
    <p class="text-sm text-gray-500 mt-0.5">
      Perbarui program studi mahasiswa secara massal dari CSV — misalnya lulusan Sarjana Kedokteran yang lanjut ke
      Profesi Dokter dengan NPM baru. Sistem menampilkan pratinjau dulu; tidak ada yang berubah sebelum Anda menekan
      <strong>Terapkan</strong>.
    </p>
  </div>

  <%= form_with url: admin_student_relabel_path, method: :post, multipart: true,
        class: "bg-white rounded-2xl ring-1 ring-gray-200 p-6 space-y-5" do %>
    <% if prodi_bound_viewer? %>
      <fieldset>
        <legend class="block text-sm font-semibold text-gray-700 mb-2">Aksi</legend>
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          <label class="inline-flex items-center gap-2 text-sm text-gray-700">
            <%= radio_button_tag :mode, "pindah", @mode == "pindah" %>
            Pindahkan mahasiswa <%= own_study_program.name %> ke prodi lain
          </label>
          <label class="inline-flex items-center gap-2 text-sm text-gray-700">
            <%= radio_button_tag :mode, "klaim", @mode == "klaim" %>
            Label ke prodi saya (<%= own_study_program.name %>)
          </label>
        </div>
      </fieldset>
    <% else %>
      <%= hidden_field_tag :mode, "pindah" %>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= label_tag :target_study_program_id, "Prodi tujuan", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= select_tag :target_study_program_id,
              options_for_select(@study_programs.map { |s| [ s.name, s.id ] }, @target_study_program_id),
              include_blank: "— Pilih prodi tujuan —", class: input_class %>
        <% if prodi_bound_viewer? %>
          <p class="text-xs text-gray-400 mt-1">Untuk “Label ke prodi saya”, tujuan selalu <%= own_study_program.name %> — pilihan ini diabaikan.</p>
        <% end %>
      </div>
      <div>
        <%= label_tag :default_cohort_year, "Angkatan default (opsional)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= number_field_tag :default_cohort_year, @default_cohort_year, min: 1951, max: Date.current.year + 1,
              placeholder: "mis. #{Date.current.year}", class: input_class %>
        <p class="text-xs text-gray-400 mt-1">Dipakai untuk baris yang kolom <code>angkatan</code>-nya kosong. Kosongkan agar angkatan tidak diubah.</p>
      </div>
    </div>

    <div>
      <div class="flex items-center justify-between gap-3 mb-1">
        <%= label_tag :csv_file, "Berkas CSV (email, npm, angkatan)", class: "block text-sm font-semibold text-gray-700" %>
        <%= link_to "Unduh template CSV", template_admin_student_relabel_path(format: :csv),
              class: "text-xs font-semibold text-indigo-600 hover:text-indigo-800" %>
      </div>
      <%= file_field_tag :csv_file, accept: ".csv,text/csv", required: true,
            class: "block w-full text-sm text-gray-700 file:mr-3 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-indigo-700 hover:file:bg-indigo-100" %>
      <ul class="mt-2 text-xs text-gray-500 space-y-0.5 list-disc pl-5">
        <li><strong>email</strong> wajib — boleh diisi NPM/NIM lama sebagai pengganti email.</li>
        <li><strong>npm</strong> = NPM/NIM baru di prodi tujuan; kosongkan untuk mempertahankan yang lama.</li>
        <li><strong>angkatan</strong> = tahun angkatan di prodi tujuan (4 digit); kosong = angkatan default di atas.</li>
        <li>Hanya akun berperan Mahasiswa yang diproses. Maksimal <%= StudentProgramRelabeler::MAX_ROWS %> baris per unggahan.</li>
      </ul>
    </div>

    <%= submit_tag "Pratinjau", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm cursor-pointer" %>
  <% end %>

  <%# ── PRATINJAU ── %>
  <% if @matches.present? %>
    <% eligible = @matches.count(&:eligible?) %>
    <div class="bg-white rounded-2xl ring-1 ring-gray-200 overflow-hidden">
      <div class="px-5 py-3 bg-gray-50 border-b border-gray-100 flex flex-wrap items-center justify-between gap-2">
        <span class="text-sm font-semibold text-gray-800">Pratinjau — <%= eligible %> dari <%= @matches.size %> baris siap diproses</span>
        <span class="text-xs text-gray-500">
          <%= @mode == "klaim" ? "Label ke prodi saya" : "Pindah prodi" %> → <strong><%= @target_study_program.name %></strong>
        </span>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
            <tr>
              <th class="text-left px-4 py-2">Baris</th>
              <th class="text-left px-4 py-2">Email / NPM</th>
              <th class="text-left px-4 py-2">Nama</th>
              <th class="text-left px-4 py-2">Prodi saat ini</th>
              <th class="text-left px-4 py-2">NPM</th>
              <th class="text-left px-4 py-2">Angkatan</th>
              <th class="text-left px-4 py-2">Catatan</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @matches.each do |m| %>
              <tr>
                <td class="px-4 py-2 text-xs text-gray-400"><%= m.line %></td>
                <td class="px-4 py-2 font-mono text-xs text-gray-600"><%= m.identifier %></td>
                <td class="px-4 py-2 text-gray-800"><%= m.user&.full_name || "—" %></td>
                <td class="px-4 py-2 text-gray-600"><%= m.user ? (m.from_program&.name || "(belum ada)") : "—" %></td>
                <td class="px-4 py-2 font-mono text-xs text-gray-600">
                  <% if m.new_npm %>
                    <%= m.old_npm.presence || "—" %> → <strong class="text-gray-900"><%= m.new_npm %></strong>
                  <% else %>
                    <%= m.old_npm.presence || "—" %>
                  <% end %>
                </td>
                <td class="px-4 py-2 font-mono text-xs text-gray-600">
                  <% if m.new_cohort_year %>
                    <%= m.old_cohort_year || "—" %> → <strong class="text-gray-900"><%= m.new_cohort_year %></strong>
                  <% else %>
                    <%= m.old_cohort_year || "—" %>
                  <% end %>
                </td>
                <td class="px-4 py-2">
                  <span class="inline-flex rounded-full px-2 py-0.5 text-[11px] font-semibold <%= m.eligible? ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
                    <%= m.note %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if eligible.positive? %>
        <div class="px-5 py-4 bg-gray-50 border-t border-gray-100">
          <%= form_with url: admin_student_relabel_path, method: :post,
                data: { turbo_confirm: "Terapkan ke #{eligible} akun? Program studi mereka akan diganti menjadi #{@target_study_program.name}." } do %>
            <%= hidden_field_tag :apply, "1" %>
            <%= hidden_field_tag :mode, @mode, id: nil %>
            <%= hidden_field_tag :target_study_program_id, @target_study_program_id, id: nil %>
            <%= hidden_field_tag :default_cohort_year, @default_cohort_year, id: nil %>
            <%= hidden_field_tag :csv_raw, @csv_raw %>
            <%= submit_tag "Terapkan ke #{eligible} akun", class: "bg-rose-600 hover:bg-rose-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm cursor-pointer" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
