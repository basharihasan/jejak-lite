<% content_for :title, "Pengguna" %>
<div class="flex items-center justify-between flex-wrap gap-3">
  <div>
    <h1 class="text-xl font-bold text-gray-900">Pengguna</h1>
    <p class="text-sm text-gray-500 mt-0.5"><%= @users.total_count %> akun · peran & program studi diatur di sini.</p>
  </div>
  <div class="flex items-center gap-2">
    <%= link_to "Impor CSV", import_admin_users_path,
          class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl text-sm" %>
  </div>
</div>

<%= form_with url: admin_users_path, method: :get, class: "mt-4 flex flex-wrap items-end gap-3" do |f| %>
  <div class="flex-1 min-w-48">
    <%= f.label :q, "Cari nama / email", class: "block text-xs font-semibold text-gray-500 mb-1" %>
    <%= f.text_field :q, value: @query, class: "block w-full rounded-xl border-0 py-2 px-3 text-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500" %>
  </div>
  <div>
    <%= f.label :role, "Peran", class: "block text-xs font-semibold text-gray-500 mb-1" %>
    <%= f.select :role, options_for_select(@roles.map { |r| [ r.name, r.code ] }, @role_code), { include_blank: "Semua" },
          class: "rounded-xl border-0 py-2 pl-3 pr-8 text-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500" %>
  </div>
  <div>
    <%= f.label :study_program_id, "Prodi", class: "block text-xs font-semibold text-gray-500 mb-1" %>
    <%= f.select :study_program_id, options_for_select(@study_programs.map { |s| [ s.name, s.id ] }, @study_program_id), { include_blank: "Semua" },
          class: "rounded-xl border-0 py-2 pl-3 pr-8 text-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500" %>
  </div>
  <%= f.submit "Saring", class: "rounded-xl bg-slate-800 text-white text-sm font-semibold px-4 py-2 cursor-pointer" %>
<% end %>

<div class="mt-4 bg-white rounded-2xl ring-1 ring-gray-200 overflow-x-auto">
  <table class="min-w-full text-sm">
    <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
      <tr>
        <th class="text-left px-5 py-3">Nama</th>
        <th class="text-left px-5 py-3">Email</th>
        <th class="text-left px-5 py-3">Peran</th>
        <th class="text-left px-5 py-3">Prodi</th>
        <th class="px-5 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @users.each do |u| %>
        <tr>
          <td class="px-5 py-3 font-semibold text-gray-800"><%= u.full_name %></td>
          <td class="px-5 py-3 text-gray-600"><%= u.email %></td>
          <td class="px-5 py-3">
            <% u.roles.each do |r| %>
              <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold <%= r == u.active_role ? 'bg-indigo-100 text-indigo-700' : 'bg-gray-100 text-gray-600' %>"><%= r.name %></span>
            <% end %>
          </td>
          <td class="px-5 py-3 text-gray-600"><%= u.study_program&.name || "—" %></td>
          <td class="px-5 py-3 text-right"><%= link_to "Sunting", edit_admin_user_path(u), class: "text-indigo-600 font-medium hover:underline" %></td>
        </tr>
      <% end %>
      <% if @users.empty? %>
        <tr><td colspan="5" class="px-5 py-6 text-center text-gray-400">Tidak ada pengguna yang cocok.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
<div class="mt-4"><%= paginate @users %></div>
