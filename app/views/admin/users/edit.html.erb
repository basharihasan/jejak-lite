<% content_for :title, "Sunting Pengguna" %>
<div class="max-w-2xl space-y-5">
  <div>
    <%= link_to "← Pengguna", admin_users_path, class: "text-xs text-gray-500 hover:text-indigo-600" %>
    <h1 class="text-xl font-bold text-gray-900 mt-1"><%= @user.full_name %></h1>
    <p class="text-sm text-gray-500"><%= @user.email %></p>
  </div>

  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-6 flex items-center justify-between gap-4 flex-wrap">
    <div>
      <h2 class="text-sm font-semibold text-gray-800">Konfirmasi email</h2>
      <% if @user.confirmed? %>
        <p class="text-xs text-emerald-700 mt-0.5">Terkonfirmasi <%= l(@user.confirmed_at.to_date, format: :long) %>.</p>
      <% else %>
        <p class="text-xs text-rose-700 mt-0.5">Belum terkonfirmasi<%= User.email_delivery_enabled? ? " — pengguna tidak bisa masuk sebelum mengonfirmasi." : " (tidak diwajibkan karena server email belum diatur)." %></p>
      <% end %>
    </div>
    <% unless @user.confirmed? %>
      <%= button_to "Konfirmasi Sekarang", confirm_email_admin_user_path(@user), method: :patch,
            class: "rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-4 py-2 cursor-pointer" %>
    <% end %>
  </div>

  <%= form_with model: @user, url: admin_user_path(@user), method: :patch,
        class: "bg-white rounded-2xl ring-1 ring-gray-200 p-6 space-y-5" do |f| %>
    <% if @user.errors.any? %>
      <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
        <%= @user.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= f.label :full_name, "Nama Lengkap", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :full_name, class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>

    <div>
      <%= f.label :study_program_id, "Program Studi", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.collection_select :study_program_id, @study_programs, :id, :name, { include_blank: "—" },
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>

    <fieldset>
      <legend class="text-sm font-semibold text-gray-700 mb-2">Peran</legend>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
        <% @roles.each do |role| %>
          <label class="flex items-center gap-2 rounded-xl border border-gray-200 px-3 py-2 text-sm cursor-pointer hover:bg-gray-50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
            <%= check_box_tag "user[role_ids][]", role.id, @user.role_ids.include?(role.id), id: "user_role_#{role.code}", class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
            <span><%= role.name %></span>
          </label>
        <% end %>
      </div>
      <p class="text-xs text-gray-400 mt-2">Peran aktif saat ini: <strong><%= @user.active_role&.name || "—" %></strong>. Bila dicabut, peran pertama yang tersisa menjadi aktif.</p>
    </fieldset>

    <div class="flex justify-end">
      <%= f.submit "Simpan", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm cursor-pointer" %>
    </div>
  <% end %>

  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-6 flex items-center justify-between gap-4 flex-wrap">
    <div>
      <h2 class="text-sm font-semibold text-gray-800">Reset kata sandi</h2>
      <p class="text-xs text-gray-500 mt-0.5">Mengembalikan ke kata sandi bawaan <code class="bg-gray-100 px-1 rounded"><%= User::DEFAULT_PASSWORD %></code>. Minta pengguna segera menggantinya di Pengaturan Akun.</p>
    </div>
    <%= button_to "Reset ke Bawaan", reset_password_admin_user_path(@user), method: :patch,
          form: { data: { turbo_confirm: "Reset kata sandi #{@user.full_name} ke bawaan?" } },
          class: "rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold px-4 py-2 cursor-pointer" %>
  </div>
</div>
