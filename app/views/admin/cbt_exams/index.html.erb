<% content_for :title, "Kelola Ujian CBT" %>
<div class="space-y-4">
  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div>
      <h1 class="text-xl font-bold text-gray-900">Kelola Ujian CBT</h1>
      <p class="text-sm text-gray-500 mt-0.5">Ujian CBT & Progress Test yang terdaftar — hasil impor CSV maupun buatan admin. Klik judul atau tanggal untuk menyunting; petakan dimensi nilai ke ranah kompetensi kurikulum.</p>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to "Riwayat Impor", admin_glide_syncs_path, class: "text-sm text-indigo-600 font-medium hover:underline" %>
      <%= link_to "📁 Impor Hasil CBT Baru", csv_import_admin_glide_syncs_path(type: "cbt"), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl text-sm" %>
    </div>
  </div>

  <%= form_with url: admin_cbt_exams_path, method: :get, class: "flex items-center gap-2" do |f| %>
    <%= f.search_field :q, value: params[:q], placeholder: "Cari judul ujian…",
          class: "w-full max-w-sm rounded-xl border-0 py-2 px-3 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    <%= f.submit "Cari", class: "rounded-xl bg-slate-800 text-white text-sm font-semibold px-4 py-2 cursor-pointer" %>
  <% end %>

  <div class="bg-white rounded-2xl ring-1 ring-gray-200 overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
        <tr>
          <th class="text-left px-5 py-3">Kode ujian</th>
          <th class="text-left px-5 py-3">Judul ujian</th>
          <th class="text-left px-5 py-3">Tipe</th>
          <th class="text-right px-5 py-3">Peserta</th>
          <th class="text-left px-5 py-3">Tanggal ujian</th>
          <th class="text-left px-5 py-3">Pemetaan</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @exams.each do |exam| %>
          <% mapped, total = @mapping.fetch(exam.id, [ 0, 0 ]) %>
          <tr class="hover:bg-gray-50/60">
            <td class="px-5 py-3 font-mono text-xs font-semibold text-indigo-600 whitespace-nowrap"><%= exam.external_code || "—" %></td>
            <td class="px-5 py-3 font-medium text-gray-800 max-w-xs">
              <%= turbo_frame_tag dom_id(exam, :name) do %>
                <%= link_to edit_admin_cbt_exam_path(exam, field: "name", q: params[:q].presence), class: "group inline-flex items-center gap-1.5 hover:text-indigo-600", title: "Sunting judul" do %>
                  <span class="truncate"><%= exam.name %></span><span class="text-gray-300 group-hover:text-indigo-500 text-xs">✎</span>
                <% end %>
              <% end %>
              <p class="text-[11px] text-gray-400 font-normal"><%= exam.academic_period.name %> · <%= exam.study_program&.name || "Semua prodi" %></p>
            </td>
            <td class="px-5 py-3 text-gray-600 whitespace-nowrap"><%= exam.type_label %><%= " · #{exam.exam_purpose_label}" if exam.exam_purpose %></td>
            <td class="px-5 py-3 text-right font-semibold text-gray-700"><%= exam.participants_count %> mahasiswa</td>
            <td class="px-5 py-3 text-gray-600 whitespace-nowrap">
              <%= turbo_frame_tag dom_id(exam, :exam_date) do %>
                <%= link_to edit_admin_cbt_exam_path(exam, field: "exam_date", q: params[:q].presence), class: "group inline-flex items-center gap-1.5 hover:text-indigo-600", title: "Sunting tanggal" do %>
                  <span><%= exam.exam_date ? l(exam.exam_date, format: :long) : "belum diisi" %></span><span class="text-gray-300 group-hover:text-indigo-500 text-xs">✎</span>
                <% end %>
              <% end %>
            </td>
            <td class="px-5 py-3 whitespace-nowrap">
              <% if total.zero? %>
                <span class="text-xs text-gray-400">tanpa dimensi</span>
              <% else %>
                <span class="text-xs font-semibold <%= mapped == total ? 'text-emerald-600' : 'text-amber-600' %>"><%= mapped %>/<%= total %> dimensi</span>
              <% end %>
            </td>
            <td class="px-5 py-3 text-right whitespace-nowrap">
              <%= link_to "Kelola Pemetaan", admin_assessment_event_path(exam, tab: "dimensi"), class: "text-indigo-600 font-semibold hover:underline mr-3" %>
              <%= link_to "Nilai", admin_assessment_event_path(exam), class: "text-gray-600 hover:text-indigo-600 mr-3" %>
              <%= button_to "Hapus", admin_cbt_exam_path(exam), method: :delete, form_class: "inline",
                    class: "text-rose-600 hover:underline font-semibold cursor-pointer bg-transparent border-0 p-0",
                    form: { data: { turbo_confirm: "Hapus ujian #{exam.name}? Ujian yang sudah bernilai tidak dapat dihapus — batalkan lewat rollback impor." } } %>
            </td>
          </tr>
        <% end %>
        <% if @exams.empty? %>
          <tr><td colspan="7" class="px-5 py-8 text-center text-gray-400">Belum ada ujian CBT. <%= link_to "Impor hasil CBT", csv_import_admin_glide_syncs_path(type: "cbt"), class: "text-indigo-600 hover:underline" %>.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div><%= paginate @exams %></div>
</div>
