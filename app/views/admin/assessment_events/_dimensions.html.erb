<%# Dimensi asesmen (mata uji CBT / station OSCE) + pemetaannya ke ranah
    kompetensi. Dimensi yang belum dipetakan tetap menghitung nilai total,
    tetapi tidak menyumbang ke Peta Kompetensi mahasiswa. %>
<% cls = "rounded-xl border-0 py-2 px-3 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
<% unmapped = dimensions.reject(&:mapped?) %>

<div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
  <div class="flex items-baseline justify-between flex-wrap gap-2">
    <div>
      <p class="text-sm font-semibold text-gray-800">Dimensi <%= event.assessment_type == "osce" ? "(station OSCE)" : "(mata uji / tinjauan)" %></p>
      <p class="text-xs text-gray-500 mt-0.5">Nilai total = rata-rata terbobot persentase tiap dimensi × maks <%= event.max_score %>. Pemetaan ke ranah kompetensi mengisi Peta Kompetensi mahasiswa.</p>
    </div>
    <% if dimensions.any? %>
      <p class="text-xs"><span class="font-bold <%= unmapped.empty? ? 'text-emerald-600' : 'text-amber-600' %>"><%= dimensions.size - unmapped.size %>/<%= dimensions.size %></span> dimensi sudah dipetakan</p>
    <% end %>
  </div>

  <% if competency_items.empty? %>
    <p class="mt-3 text-xs text-amber-700 bg-amber-50 rounded-lg px-3 py-2">Belum ada Kerangka Kompetensi. Buat dulu di <%= link_to "Konfigurasi → Kerangka Kompetensi", competency_frameworks_path, class: "underline" %> agar dimensi bisa dipetakan.</p>
  <% end %>

  <%# Formulir pemetaan sengaja kosong & berdiri sendiri: pilihan ranah dan
      tombol Simpan terhubung lewat atribut form="dimension-map-form". Dulu
      tabelnya dibungkus formulir ini, padahal tiap baris memuat formulir
      "Hapus" (button_to) — formulir bersarang membuat browser menutup
      formulir luar di baris pertama, sehingga hanya dimensi pertama yang
      tersimpan. %>
  <%= form_with url: bulk_map_admin_assessment_event_assessment_dimensions_path(event), method: :patch,
        id: "dimension-map-form", class: "hidden" do %><% end %>
  <div class="mt-4">
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
          <tr>
            <th class="text-left px-3 py-2">Dimensi</th>
            <th class="text-left px-3 py-2">Kode</th>
            <th class="text-right px-3 py-2">Maks</th>
            <th class="text-right px-3 py-2">Bobot</th>
            <th class="text-left px-3 py-2">Ranah kompetensi</th>
            <th class="text-right px-3 py-2">Nilai masuk</th>
            <th class="px-3 py-2"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% dimensions.each do |dimension| %>
            <tr class="<%= 'bg-amber-50/40' unless dimension.mapped? %>">
              <td class="px-3 py-2 font-medium text-gray-800"><%= dimension.name %></td>
              <td class="px-3 py-2 text-gray-500"><%= dimension.code %></td>
              <td class="px-3 py-2 text-right text-gray-600"><%= dimension.max_score.to_f.round(1) %></td>
              <td class="px-3 py-2 text-right text-gray-600"><%= dimension.weight.to_f.round(2) %></td>
              <td class="px-3 py-2">
                <%= select_tag "competency_item_ids[#{dimension.id}]",
                      options_for_select(competency_items, dimension.competency_item_id),
                      include_blank: "— belum dipetakan —", form: "dimension-map-form", class: "#{cls} w-full min-w-48" %>
              </td>
              <td class="px-3 py-2 text-right text-gray-600"><%= dimension.assessment_dimension_scores.size %></td>
              <td class="px-3 py-2 text-right">
                <%= button_to "Hapus", admin_assessment_dimension_path(dimension), method: :delete,
                      class: "text-xs text-rose-600 hover:underline",
                      form: { data: { turbo_confirm: "Hapus dimensi #{dimension.name}?" } } %>
              </td>
            </tr>
          <% end %>
          <% if dimensions.empty? %>
            <tr><td colspan="7" class="px-3 py-6 text-center text-gray-400">Belum ada dimensi. Tambahkan di bawah, atau buat otomatis dari kolom berkas saat Impor CSV.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if dimensions.any? %>
      <%= submit_tag "Simpan Pemetaan", form: "dimension-map-form", name: nil,
            class: "mt-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-4 py-2 cursor-pointer" %>
    <% end %>
  </div>
</div>

<div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
  <p class="text-sm font-semibold text-gray-800 mb-3">Tambah dimensi</p>
  <%= form_with url: admin_assessment_event_assessment_dimensions_path(event), method: :post, scope: :assessment_dimension,
        class: "flex flex-wrap items-end gap-3" do |f| %>
    <div class="flex-1 min-w-48">
      <label class="block text-xs font-semibold text-gray-500 mb-1">Nama</label>
      <%= f.text_field :name, required: true, placeholder: (event.assessment_type == "osce" ? "Station 3 — Anamnesis" : "Penalaran Klinis"), class: "#{cls} w-full" %>
    </div>
    <div class="w-28">
      <label class="block text-xs font-semibold text-gray-500 mb-1">Kode</label>
      <%= f.text_field :code, placeholder: "ST3", class: "#{cls} w-full" %>
    </div>
    <div class="w-24">
      <label class="block text-xs font-semibold text-gray-500 mb-1">Maks</label>
      <%= f.number_field :max_score, value: event.max_score, step: "0.01", min: 0.01, class: "#{cls} w-full" %>
    </div>
    <div class="w-24">
      <label class="block text-xs font-semibold text-gray-500 mb-1">Bobot</label>
      <%= f.number_field :weight, value: 1, step: "0.01", min: 0.01, class: "#{cls} w-full" %>
    </div>
    <div class="min-w-48">
      <label class="block text-xs font-semibold text-gray-500 mb-1">Ranah kompetensi</label>
      <%= f.select :competency_item_id, options_for_select(competency_items), { include_blank: "— nanti saja —" }, class: "#{cls} w-full" %>
    </div>
    <%= f.submit "Tambah", class: "rounded-xl bg-slate-800 text-white text-sm font-semibold px-4 py-2 cursor-pointer" %>
  <% end %>
</div>
