<% content_for :title, "Petakan Kolom — #{@event.name}" %>
<% cls = "block w-full rounded-xl border-0 py-2 px-3 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
<div class="max-w-3xl space-y-5">
  <div>
    <%= link_to "← Ulangi unggah", import_admin_assessment_event_path(@event), class: "text-xs text-gray-500 hover:text-indigo-600" %>
    <h1 class="text-xl font-bold text-gray-900 mt-1">Petakan Kolom</h1>
    <p class="text-sm text-gray-500 mt-0.5">Langkah 2 dari 3 — cocokkan header berkas dengan kolom sistem. Tebakan awal sudah diisi bila nama headernya dikenal.</p>
  </div>

  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5 overflow-x-auto">
    <p class="text-xs font-semibold text-gray-500 uppercase mb-2">Cuplikan berkas (<%= @headers.size %> kolom)</p>
    <table class="min-w-full text-xs">
      <thead><tr><% @headers.each do |h| %><th class="text-left px-2 py-1 font-semibold text-gray-700 bg-gray-50"><%= h %></th><% end %></tr></thead>
      <tbody>
        <% @sample_rows.each do |row| %>
          <tr><% row.each do |v| %><td class="px-2 py-1 text-gray-600 border-t border-gray-100"><%= v %></td><% end %></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= form_with url: import_create_admin_assessment_event_path(@event), method: :post, class: "bg-white rounded-2xl ring-1 ring-gray-200 p-6 space-y-4" do |f| %>
    <%= hidden_field_tag :csv_text, @csv_text %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <% { "email" => [ "Email mahasiswa", true ], "score" => [ "Skor total (opsional bila memetakan dimensi)", false ], "max_score" => [ "Nilai maksimum (opsional, bawaan #{@event.max_score})", false ],
           "attempt" => [ "Nomor percobaan (opsional#{@event.allow_multiple_attempts? ? '' : ' — diabaikan, event ini sekali jalan'})", false ],
           "date" => [ "Tanggal ujian (opsional#{@event.exam_date ? ", bawaan #{l(@event.exam_date, format: :long)}" : ''})", false ] }.each do |key, (label, required)| %>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1"><%= label %><%= " *" if required %></label>
          <%= select_tag "mapping[#{key}]", options_for_select([ [ "— tidak dipetakan —", "" ] ] + @headers.map { |h| [ h, h ] }, @suggested[key]), required: required, class: cls %>
        </div>
      <% end %>
    </div>
    <%# ── Nilai per dimensi (mata uji CBT / station OSCE) ── %>
    <div class="border-t border-gray-100 pt-4">
      <p class="text-sm font-semibold text-gray-800">Nilai per dimensi <span class="font-normal text-gray-400">(opsional)</span></p>
      <p class="text-[11px] text-gray-500 mb-3">
        Bila berkas memuat satu kolom per mata uji/station, petakan di sini. Nilai total dihitung dari dimensi
        (rata-rata terbobot) kecuali Anda memetakan kolom skor total di atas. Pemetaan dimensi → ranah kompetensi
        diatur di tab <strong>Dimensi &amp; Pemetaan Kompetensi</strong>.
      </p>

      <% if @dimensions.any? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <% @dimensions.each do |dimension| %>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1">
                <%= dimension.label %>
                <span class="font-normal text-gray-400">· maks <%= dimension.max_score.to_f.round(1) %> · <%= dimension.competency_item&.title || "belum dipetakan" %></span>
              </label>
              <%= select_tag "dimension_mapping[#{dimension.id}]",
                    options_for_select([ [ "— tidak diimpor —", "" ] ] + @headers.map { |h| [ h, h ] }, @suggested_dimensions[dimension.id]),
                    class: cls %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-xs text-gray-400">Event ini belum punya dimensi.</p>
      <% end %>

      <%# Kolom penanda dari templat (nama, NPM) bukan calon dimensi. %>
      <% leftover = (@headers - @suggested.values.compact - @suggested_dimensions.values)
                      .reject { |h| Admin::AssessmentEventsController::INFO_HEADERS.include?(h.to_s.strip.downcase.tr(" ", "_")) } %>
      <% if leftover.any? %>
        <div class="mt-4 rounded-xl bg-indigo-50/60 ring-1 ring-indigo-100 p-3">
          <p class="text-xs font-semibold text-gray-700 mb-2">Buat dimensi baru dari kolom yang belum dikenal</p>
          <div class="flex flex-wrap gap-2">
            <% leftover.each do |column| %>
              <label class="inline-flex items-center gap-1.5 rounded-full bg-white border border-indigo-200 px-2.5 py-1 text-xs cursor-pointer hover:bg-indigo-50">
                <%= check_box_tag "create_dimensions[]", column, false, id: "create_dim_#{column.parameterize}", class: "rounded border-gray-300 text-indigo-600" %>
                <%= column %>
              </label>
            <% end %>
          </div>
          <p class="text-[11px] text-gray-500 mt-2">Kolom yang dicentang menjadi dimensi baru (maks <%= @event.max_score %>, bobot 1) dan nilainya langsung diimpor. Pemetaan ke ranah kompetensi dilakukan setelah impor.</p>
        </div>
      <% end %>
    </div>

    <%= f.submit "Jalankan impor →", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm cursor-pointer" %>
  <% end %>
</div>
