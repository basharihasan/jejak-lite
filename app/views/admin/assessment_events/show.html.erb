<% content_for :title, @event.name %>
<% cls = "rounded-xl border-0 py-2 px-3 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
<div class="space-y-5">
  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div>
      <%= link_to "← Assessment Events", admin_assessment_events_path, class: "text-xs text-gray-500 hover:text-indigo-600" %>
      <h1 class="text-xl font-bold text-gray-900 mt-1"><%= @event.name %></h1>
      <p class="text-sm text-gray-500 mt-0.5">
        <%= @event.type_label %> · <%= @event.family_label %> · <%= @event.academic_period.name %> · <%= @event.study_program&.name || "Semua prodi" %>
        <%= " · #{@event.block_name}" if @event.block_name.present? %> · maks <%= @event.max_score %>
        <%= " · percobaan berulang" if @event.allow_multiple_attempts? %>
        <%= " · #{@event.exam_purpose_label}" if @event.exam_purpose %>
        <% if @event.external_code %> · kode <span class="font-mono"><%= @event.external_code %></span><% end %>
      </p>
      <span class="mt-1 inline-block text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full <%= { 'draft' => 'bg-gray-100 text-gray-600', 'published' => 'bg-emerald-50 text-emerald-700', 'closed' => 'bg-rose-50 text-rose-700' }[@event.status] %>"><%= @event.status_label %></span>
    </div>
    <div class="flex items-center gap-2">
      <% if @event.importable? %>
        <%= link_to "Impor CSV", import_admin_assessment_event_path(@event), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl text-sm" %>
      <% end %>
      <%= link_to "Sunting", edit_admin_assessment_event_path(@event), class: "text-sm text-gray-600 hover:text-indigo-600 font-medium" %>
      <%= button_to "Hapus", admin_assessment_event_path(@event), method: :delete, class: "text-sm text-rose-600 hover:underline",
            form: { data: { turbo_confirm: "Hapus event ini beserta #{@instances.size} percobaan?" } } %>
    </div>
  </div>

  <%# ── Tab: Peserta & Nilai / Dimensi & Kompetensi ── %>
  <div class="flex items-center gap-2">
    <%= link_to "Peserta & Nilai", admin_assessment_event_path(@event),
          class: "text-xs px-3 py-1.5 rounded-full font-medium #{@tab == 'peserta' ? 'bg-indigo-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
    <%= link_to "Dimensi & Pemetaan Kompetensi (#{@dimensions.size})", admin_assessment_event_path(@event, tab: "dimensi"),
          class: "text-xs px-3 py-1.5 rounded-full font-medium #{@tab == 'dimensi' ? 'bg-indigo-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
    <% if @station_count.positive? %>
      <%= link_to "Station OSCE (#{@station_count})", admin_assessment_event_path(@event, tab: "station"),
            class: "text-xs px-3 py-1.5 rounded-full font-medium #{@tab == 'station' ? 'bg-indigo-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
    <% end %>
  </div>

  <% if @tab == "dimensi" %>
    <%= render "dimensions", event: @event, dimensions: @dimensions, competency_items: @competency_items %>
  <% elsif @tab == "station" %>
    <%= render "osce_stations", stations: @stations, global_ratings: @global_ratings, dimension_means: @dimension_means %>
  <% else %>
  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
    <p class="text-sm font-semibold text-gray-800 mb-3">Daftarkan mahasiswa <span class="text-gray-400 font-normal">(percobaan baru / ujian ulang)</span></p>
    <%= form_with url: add_instance_admin_assessment_event_path(@event), method: :post, class: "flex flex-wrap items-end gap-3" do |f| %>
      <div class="flex-1 min-w-48">
        <label class="block text-xs font-semibold text-gray-500 mb-1">Mahasiswa</label>
        <%= f.collection_select :student_id, @students, :id, :full_name, { include_blank: "Pilih..." }, required: true, class: "#{cls} w-full", data: { controller: "searchable-select" } %>
      </div>
      <div class="min-w-48">
        <label class="block text-xs font-semibold text-gray-500 mb-1">Penguji (opsional)</label>
        <%= f.collection_select :examiner_id, @examiners, :id, :full_name, { include_blank: "—" }, class: "#{cls} w-full", data: { controller: "searchable-select" } %>
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-500 mb-1">Jadwal (opsional)</label>
        <%= f.datetime_local_field :scheduled_at, class: cls %>
      </div>
      <%= f.submit "Daftarkan", class: "rounded-xl bg-slate-800 text-white text-sm font-semibold px-4 py-2 cursor-pointer" %>
    <% end %>
  </div>

  <div class="bg-white rounded-2xl ring-1 ring-gray-200 overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
        <tr>
          <th class="text-left px-4 py-3">Mahasiswa</th>
          <th class="text-left px-4 py-3">Ke-</th>
          <th class="text-left px-4 py-3">Status</th>
          <th class="text-left px-4 py-3">Penguji · Jadwal</th>
          <th class="text-left px-4 py-3">Nilai</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @instances.each do |i| %>
          <tr>
            <td class="px-4 py-2.5 font-medium text-gray-800"><%= i.student.full_name %></td>
            <td class="px-4 py-2.5 text-gray-500"><%= i.attempt_number %></td>
            <td class="px-4 py-2.5"><span class="text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full <%= i.status == 'scored' ? 'bg-emerald-50 text-emerald-700' : (i.status == 'submitted' ? 'bg-amber-50 text-amber-700' : 'bg-gray-100 text-gray-600') %>"><%= i.status_label %></span></td>
            <td class="px-4 py-2.5">
              <%= form_with model: i, url: admin_assessment_instance_path(i), method: :patch, class: "flex flex-wrap items-center gap-2" do |f| %>
                <%= f.collection_select :examiner_id, @examiners, :id, :full_name, { include_blank: "— penguji —" }, class: "#{cls} py-1", data: { controller: "searchable-select", searchable_select_placeholder_value: "Cari penguji…" } %>
                <%= f.datetime_local_field :scheduled_at, value: i.scheduled_at&.strftime("%Y-%m-%dT%H:%M"), class: "#{cls} py-1" %>
                <%= f.submit "Simpan", class: "text-xs font-semibold text-indigo-600 hover:underline cursor-pointer bg-transparent border-0" %>
              <% end %>
            </td>
            <td class="px-4 py-2.5">
              <%= form_with model: i, url: admin_assessment_instance_path(i), method: :patch, class: "flex items-center gap-1" do |f| %>
                <%= f.number_field :score, step: "0.01", min: 0, max: i.max_score, placeholder: "nilai", class: "#{cls} py-1 w-24" %>
                <span class="text-xs text-gray-400">/ <%= i.max_score %></span>
                <%= f.submit "Isi", class: "text-xs font-semibold text-indigo-600 hover:underline cursor-pointer bg-transparent border-0" %>
              <% end %>
              <% if i.percentage %><p class="text-[10px] text-gray-400 mt-0.5"><%= i.percentage %>% · <%= i.source %><%= " · #{i.examiner.full_name}" if i.examiner %></p><% end %>
            </td>
            <td class="px-4 py-2.5 text-right">
              <%= button_to "Hapus", admin_assessment_instance_path(i), method: :delete, class: "text-xs text-rose-600 hover:underline",
                    form: { data: { turbo_confirm: "Hapus percobaan ini?" } } %>
            </td>
          </tr>
        <% end %>
        <% if @instances.empty? %>
          <tr><td colspan="6" class="px-4 py-6 text-center text-gray-400">Belum ada percobaan. Daftarkan mahasiswa atau impor CSV.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% end %>
</div>
