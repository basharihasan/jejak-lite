<% cls = "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
<%= form_with model: [ :admin, record ], class: "space-y-4" do |f| %>
  <% if record.errors.any? %>
    <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm"><%= record.errors.full_messages.to_sentence %></div>
  <% end %>
  <div>
    <%= f.label :name, "Nama obat (generik)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.text_field :name, placeholder: "Parasetamol", class: cls %>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div>
      <%= f.label :strength, "Kekuatan", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :strength, placeholder: "500 mg", class: cls %>
    </div>
    <div>
      <%= f.label :dosage_form, "Sediaan", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.select :dosage_form, MedicationDefinition::DOSAGE_FORMS, { include_blank: "—" }, class: cls %>
    </div>
    <div>
      <%= f.label :category, "Kelas terapi", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :category, placeholder: "Analgesik-Antipiretik", class: cls %>
    </div>
  </div>
  <div>
    <%= f.label :usual_dosage, "Dosis lazim (opsional)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.text_field :usual_dosage, placeholder: "3-4 x 500 mg", class: cls %>
    <p class="text-[11px] text-gray-400 mt-1">Tampil sebagai petunjuk di datalist — bukan pengganti pertimbangan klinis.</p>
  </div>
  <label class="inline-flex items-center gap-2 text-sm text-gray-700"><%= f.check_box :active, class: "rounded border-gray-300 text-indigo-600" %> Aktif (tampil di datalist)</label>
  <div><%= f.submit "Simpan", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm cursor-pointer" %></div>
<% end %>
