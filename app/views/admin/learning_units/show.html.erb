<% content_for :title, @unit.name %>
<% cls = "rounded-xl border-0 py-2 px-3 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
<div class="space-y-5">
  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div>
      <%= link_to "← Learning Unit", admin_learning_units_path, class: "text-xs text-gray-500 hover:text-indigo-600" %>
      <h1 class="text-xl font-bold text-gray-900 mt-1"><%= @unit.name %> <span class="text-sm font-normal text-gray-400"><%= @unit.code %></span></h1>
      <p class="text-sm text-gray-500 mt-0.5"><%= @unit.study_program.name %> · <%= @unit.academic_period&.name || "semua periode" %><%= " · #{@unit.credits} SKS" if @unit.credits %><%= " · blueprint: #{@unit.assessment_blueprint.name}" if @unit.assessment_blueprint %></p>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "Sunting", edit_admin_learning_unit_path(@unit), class: "text-sm text-gray-600 hover:text-indigo-600 font-medium" %>
      <%= button_to "Hapus", admin_learning_unit_path(@unit), method: :delete, class: "text-sm text-rose-600 hover:underline",
            form: { data: { turbo_confirm: "Hapus unit ini beserta pemetaannya?" } } %>
    </div>
  </div>

  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
    <div class="flex items-baseline justify-between flex-wrap gap-2">
      <p class="text-sm font-semibold text-gray-800">Assessment Matrix</p>
      <p class="text-xs">Total bobot: <span class="font-bold <%= @unit.weights_complete? ? 'text-emerald-600' : 'text-amber-600' %>"><%= @unit.total_weight.round(1) %>%</span>
        <% unless @unit.weights_complete? %><span class="text-gray-400">· belum 100%; nilai unit dihitung dari bobot yang terisi</span><% end %></p>
    </div>

    <table class="min-w-full text-sm mt-3">
      <thead class="text-xs uppercase tracking-wide text-gray-500">
        <tr><th class="text-left py-2">Event asesmen</th><th class="text-left py-2">Tipe</th><th class="text-right py-2">Bobot</th><th></th></tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @mappings.each do |m| %>
          <tr>
            <td class="py-2 font-medium text-gray-800"><%= link_to m.assessment_event.name, admin_assessment_event_path(m.assessment_event), class: "hover:text-indigo-600" %></td>
            <td class="py-2 text-gray-500"><%= m.assessment_event.type_label %></td>
            <td class="py-2 text-right font-semibold text-gray-700"><%= m.weight %>%</td>
            <td class="py-2 text-right"><%= button_to "Hapus", remove_mapping_admin_learning_unit_path(@unit, mapping_id: m.id), method: :delete, class: "text-xs text-rose-600 hover:underline" %></td>
          </tr>
        <% end %>
        <% if @mappings.empty? %><tr><td colspan="4" class="py-4 text-center text-gray-400">Belum ada komponen.</td></tr><% end %>
      </tbody>
    </table>

    <%= form_with url: add_mapping_admin_learning_unit_path(@unit), method: :post, class: "mt-4 flex flex-wrap items-end gap-3" do |f| %>
      <div class="flex-1 min-w-56">
        <label class="block text-xs font-semibold text-gray-500 mb-1">Tambah event</label>
        <%= f.select :assessment_event_id, @available_events.map { |e| [ "#{e.name} — #{e.type_label}", e.id ] }, { include_blank: "Pilih event..." }, required: true, class: "#{cls} w-full" %>
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-500 mb-1">Bobot (%)</label>
        <%= f.number_field :weight, step: "0.01", min: 0.01, max: 100, required: true, class: "#{cls} w-28" %>
      </div>
      <%= f.submit "Tambah", class: "rounded-xl bg-slate-800 text-white text-sm font-semibold px-4 py-2 cursor-pointer" %>
    <% end %>
  </div>

  <div class="bg-white rounded-2xl ring-1 ring-gray-200 overflow-x-auto">
    <div class="px-5 py-4 border-b border-gray-100">
      <p class="text-sm font-semibold text-gray-800">Rekap nilai unit per mahasiswa</p>
      <p class="text-xs text-gray-500 mt-0.5">Rata-rata terbobot komponen yang sudah dinilai; percobaan tertinggi mewakili tiap event.</p>
    </div>
    <table class="min-w-full text-sm">
      <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
        <tr><th class="text-left px-5 py-3">Mahasiswa</th><th class="text-left px-5 py-3">Nilai unit</th><th class="text-left px-5 py-3">Komponen</th></tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @recap.each do |row| %>
          <tr>
            <td class="px-5 py-3 font-medium text-gray-800"><%= row[:student].full_name %></td>
            <td class="px-5 py-3"><%= row[:score] ? "#{row[:score][:percentage]}% (dari #{row[:score][:weight_covered]}% bobot)" : "—" %></td>
            <td class="px-5 py-3 text-xs text-gray-500"><%= row[:components].map { |c| "#{c[:event].name}: #{c[:percentage] ? "#{c[:percentage]}%" : '—'}" }.join(" · ") %></td>
          </tr>
        <% end %>
        <% if @recap.empty? %><tr><td colspan="3" class="px-5 py-6 text-center text-gray-400">Belum ada mahasiswa pada prodi ini.</td></tr><% end %>
      </tbody>
    </table>
  </div>
</div>
