<% content_for :title, "Tambah #{term('terms.activity_template')}" %>
<div class="max-w-xl space-y-5">
  <div>
    <%= link_to "← #{term('nav.activity_taxonomy')}", admin_academic_activity_domains_path(anchor: "domain-#{@subdomain.academic_activity_domain_id}"), class: "text-sm text-indigo-600 hover:text-indigo-800" %>
    <h1 class="mt-2 text-xl font-bold text-gray-900">Tambah <%= term("terms.activity_template") %></h1>
  </div>
  <%= render "admin/academic_activity_domains/name_form",
        record: @record, model: (@record.persisted? ? [ :admin, @record ] : [ :admin, @subdomain, @record ]),
        parent_label: "#{@subdomain.academic_activity_domain.name} → #{term('terms.activity_subdomain')}", parent_name: @subdomain.name,
        anchor_domain_id: @subdomain.academic_activity_domain_id, placeholder: "Contoh: Juara-1 Perorangan" %>
</div>
