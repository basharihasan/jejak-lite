<% cls = "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
<%= form_with model: [ :admin, target ], class: "space-y-4" do |f| %>
  <% if target.errors.any? %>
    <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm"><%= target.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :study_program_id, "Program Studi", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.collection_select :study_program_id, @study_programs, :id, :name, { include_blank: "Pilih prodi..." }, class: cls %>
    </div>
    <div>
      <%= f.label :academic_period_id, "Periode (opsional)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.collection_select :academic_period_id, @academic_periods, :id, :name, { include_blank: "Umum (semua periode)" }, class: cls %>
    </div>
    <div>
      <%= f.label :facility_type, "Jenis Fasilitas", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.select :facility_type, LogbookCaseTarget::FACILITY_TYPES.invert, {}, class: cls %>
    </div>
    <div>
      <%= f.label :target_count, "Target jumlah kasus terverifikasi", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.number_field :target_count, min: 0, class: cls %>
    </div>
  </div>
  <div>
    <%= f.label :notes, "Catatan (opsional)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.text_field :notes, class: cls %>
  </div>
  <div><%= f.submit "Simpan", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm cursor-pointer" %></div>
<% end %>
