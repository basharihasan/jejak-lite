<% content_for :title, "Riwayat Impor CBT & OSCE" %>
<div class="space-y-4">
  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div>
      <h1 class="text-xl font-bold text-gray-900">Riwayat Impor CBT & OSCE</h1>
      <p class="text-sm text-gray-500 mt-0.5">Setiap unggahan berkas CSV Glide beserta ringkasannya. Unggahan yang keliru dapat di-rollback dari halaman rinciannya.</p>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to "Kelola Ujian CBT", admin_cbt_exams_path, class: "text-sm text-indigo-600 font-medium hover:underline" %>
      <%= link_to "+ Upload CSV", csv_import_admin_glide_syncs_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl text-sm" %>
    </div>
  </div>

  <div class="bg-white rounded-2xl ring-1 ring-gray-200 overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
        <tr>
          <th class="text-left px-5 py-3">#</th>
          <th class="text-left px-5 py-3">Tipe · Berkas</th>
          <th class="text-left px-5 py-3">Waktu · Pengunggah</th>
          <th class="text-right px-5 py-3">Masuk</th>
          <th class="text-right px-5 py-3">Dilewati</th>
          <th class="text-right px-5 py-3">Galat</th>
          <th class="text-left px-5 py-3">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @imports.each do |import| %>
          <tr>
            <td class="px-5 py-3 text-gray-500"><%= link_to "##{import.id}", admin_glide_sync_path(import), class: "font-semibold text-indigo-600 hover:underline" %></td>
            <td class="px-5 py-3">
              <p class="font-semibold text-gray-800"><%= import.importer_label %></p>
              <p class="text-[11px] font-mono text-gray-400 truncate max-w-xs"><%= import.filename %></p>
            </td>
            <td class="px-5 py-3 text-gray-600"><%= l(import.created_at, format: :short) %><span class="block text-[11px] text-gray-400"><%= import.imported_by&.full_name || "—" %></span></td>
            <td class="px-5 py-3 text-right font-semibold text-gray-800"><%= import.created_count + import.updated_count %></td>
            <td class="px-5 py-3 text-right text-gray-600"><%= import.skipped_count %></td>
            <td class="px-5 py-3 text-right <%= import.error_count.positive? ? 'text-rose-600 font-semibold' : 'text-gray-400' %>"><%= import.error_count %></td>
            <td class="px-5 py-3"><span class="text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full <%= import.rolled_back? ? 'bg-gray-100 text-gray-500' : 'bg-emerald-50 text-emerald-700' %>"><%= import.status_label %></span></td>
          </tr>
        <% end %>
        <% if @imports.empty? %>
          <tr><td colspan="7" class="px-5 py-8 text-center text-gray-400">Belum ada unggahan. <%= link_to "Upload CSV pertama", csv_import_admin_glide_syncs_path, class: "text-indigo-600 hover:underline" %>.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div><%= paginate @imports %></div>
</div>
