<% content_for :title, "Impor ##{@import.id} — #{@import.importer_label}" %>
<% osce = @import.importer_key == "osce" %>
<div class="max-w-3xl space-y-5">
  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div>
      <%= link_to "← Riwayat Impor", admin_glide_syncs_path, class: "text-xs text-gray-500 hover:text-indigo-600" %>
      <h1 class="text-xl font-bold text-gray-900 mt-1">Impor #<%= @import.id %> — <%= @import.importer_label %></h1>
      <p class="text-sm text-gray-500 mt-0.5">
        <span class="font-mono"><%= @import.filename %></span> · <%= l(@import.created_at, format: :long) %><%= " · #{@import.imported_by.full_name}" if @import.imported_by %>
      </p>
      <span class="mt-1 inline-block text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full <%= @import.rolled_back? ? 'bg-gray-100 text-gray-500' : 'bg-emerald-50 text-emerald-700' %>"><%= @import.status_label %></span>
      <% if @import.rolled_back? %>
        <span class="text-xs text-gray-500">— <%= l(@import.rolled_back_at, format: :short) %><%= " oleh #{@import.rolled_back_by.full_name}" if @import.rolled_back_by %></span>
      <% end %>
    </div>
    <%= link_to "Upload CSV lagi", csv_import_admin_glide_syncs_path(type: @import.importer_key), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl text-sm" %>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" data-testid="import-summary">
    <% [ [ @import.total_rows, "Baris dibaca", "text-gray-900" ],
         [ @import.created_count + @import.updated_count, osce ? "Station masuk" : "Nilai masuk", "text-emerald-600" ],
         [ @import.skipped_count, "Dilewati", "text-amber-600" ],
         [ @import.error_count, "Galat", @import.error_count.positive? ? "text-rose-600" : "text-gray-400" ] ].each do |value, label, tone| %>
      <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-4">
        <p class="text-2xl font-bold <%= tone %>"><%= value %></p>
        <p class="text-[10px] font-semibold uppercase tracking-wide text-gray-400"><%= label %></p>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5 space-y-3 text-sm">
    <p class="text-gray-700">
      <%= @import.created_event_ids.size %> event baru · <%= @import.created_instance_ids.size %> peserta baru
      <% if @import.filled_instance_ids.any? %> · <%= @import.filled_instance_ids.size %> peserta terdaftar diisi nilainya<% end %>
    </p>
    <% if @import.skip_reasons.any? %>
      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Alasan dilewati</p>
        <ul class="mt-1 space-y-0.5 text-xs text-gray-700">
          <% @import.skip_reasons.sort_by { |_, count| -count }.each do |reason, count| %>
            <li><span class="font-semibold"><%= count %></span> — <%= GlideImport::SKIP_REASON_LABELS.fetch(reason, reason) %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <% if @import.error_messages.any? %>
      <div>
        <p class="text-xs font-semibold text-rose-600 uppercase tracking-wide">Galat<%= " (#{GlideImport::MAX_ERROR_MESSAGES} pertama dari #{@import.error_count})" if @import.error_count > @import.error_messages.size %></p>
        <ul class="mt-1 list-disc pl-5 space-y-0.5 text-xs text-rose-700">
          <% @import.error_messages.each do |message| %><li><%= message %></li><% end %>
        </ul>
      </div>
    <% end %>
  </div>

  <% if @events.any? %>
    <div class="bg-white rounded-2xl ring-1 ring-gray-200 overflow-x-auto">
      <div class="px-5 py-3 border-b border-gray-100 flex items-center justify-between gap-2 flex-wrap">
        <p class="text-sm font-semibold text-gray-800">Event yang terisi (<%= @import.event_ids_touched.size %>)</p>
        <% unless osce %><%= link_to "Petakan dimensi di Kelola Ujian CBT →", admin_cbt_exams_path, class: "text-xs text-indigo-600 hover:underline" %><% end %>
      </div>
      <table class="min-w-full text-sm">
        <tbody class="divide-y divide-gray-100">
          <% @events.each do |event| %>
            <tr>
              <td class="px-5 py-2.5">
                <%= link_to event.name, admin_assessment_event_path(event, tab: (osce ? "station" : nil)), class: "font-medium text-gray-800 hover:text-indigo-600" %>
                <% if @import.created_event_ids.include?(event.id) %><span class="ml-1 text-[10px] font-bold uppercase text-emerald-600">baru</span><% end %>
                <p class="text-[11px] text-gray-400"><%= event.type_label %> · <%= event.academic_period.name %><%= " · #{event.external_code}" if event.external_code %></p>
              </td>
              <td class="px-5 py-2.5 text-right text-gray-500 whitespace-nowrap"><%= event.exam_date ? l(event.exam_date, format: :long) : "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if @import.rollbackable? %>
    <div class="bg-rose-50 rounded-2xl ring-1 ring-rose-200 p-5">
      <p class="text-sm font-semibold text-rose-800">Rollback unggahan ini</p>
      <p class="text-xs text-rose-700 mt-1">Menghapus <%= osce ? "seluruh station" : "seluruh nilai" %> yang dimasukkan unggahan ini<%= ", termasuk #{@import.created_event_ids.size} event yang dibuatnya bila tidak berisi nilai lain" if @import.created_event_ids.any? %>. Peserta yang sebelumnya sudah terdaftar dikembalikan ke status Terdaftar. Tidak dapat dibatalkan.</p>
      <%= button_to "Rollback impor ##{@import.id}", rollback_admin_glide_sync_path(@import), method: :post,
            class: "mt-3 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-sm font-semibold px-4 py-2 cursor-pointer",
            form: { data: { turbo_confirm: "Rollback impor ##{@import.id}? Nilai yang dimasukkan unggahan ini akan dihapus." } } %>
    </div>
  <% end %>
</div>
