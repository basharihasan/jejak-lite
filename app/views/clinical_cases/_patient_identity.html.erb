<%# Kartu Identitas Pasien — disamarkan selama Privacy Mode menyala kecuali
    bagi pembimbing kasus; tombol Break Glass membuka untuk 30 menit dengan
    alasan tertulis yang tercatat. %>
<% if clinical_case.patient_identity_present? %>
  <div class="mt-4 bg-white rounded-2xl ring-1 <%= identity_visible && privacy_mode ? 'ring-rose-300' : 'ring-gray-200' %> p-5">
    <div class="flex items-start justify-between gap-3 flex-wrap">
      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase">Identitas Pasien</p>
        <% if privacy_mode && !identity_visible %>
          <p class="text-[11px] text-amber-700 mt-0.5">🔒 Disamarkan oleh Privacy Mode. Buka hanya bila diperlukan untuk verifikasi/pelayanan.</p>
        <% elsif privacy_mode && break_glass %>
          <p class="text-[11px] text-rose-700 mt-0.5">🔓 Terbuka lewat Break Glass sampai <%= l(break_glass.expires_at, format: :short) %> — akses ini tercatat.</p>
        <% elsif privacy_mode %>
          <p class="text-[11px] text-rose-700 mt-0.5">🔓 Terbuka untuk Anda sebagai pembimbing kasus ini (preseptor rotasi atau verifier). Jangan sebarkan di luar keperluan pelayanan/pembelajaran.</p>
        <% else %>
          <p class="text-[11px] text-gray-400 mt-0.5">Privacy Mode sedang dimatikan oleh admin.</p>
        <% end %>
      </div>
      <% if privacy_mode && !identity_visible && policy(clinical_case).break_glass? %>
        <details class="relative">
          <summary class="list-none cursor-pointer inline-flex items-center gap-1.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold px-3 py-2">
            🔓 Break Glass
          </summary>
          <div class="absolute right-0 mt-2 w-80 bg-white rounded-2xl shadow-2xl ring-1 ring-gray-200 p-4 z-20">
            <p class="text-xs font-semibold text-gray-800">Alasan membuka identitas pasien</p>
            <p class="text-[11px] text-gray-500 mt-0.5 mb-2">Wajib, minimal <%= BreakGlassAccess::MIN_REASON_LENGTH %> karakter. Tercatat permanen beserta nama Anda dan waktunya.</p>
            <%= form_with url: break_glass_clinical_case_path(clinical_case), method: :post, class: "space-y-2" do |f| %>
              <%= f.text_area :reason, rows: 3, required: true, minlength: BreakGlassAccess::MIN_REASON_LENGTH,
                    placeholder: "Contoh: verifikasi kesesuaian identitas dengan rekam medis",
                    class: "block w-full rounded-xl border-0 py-2 px-3 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-rose-500 text-sm resize-none" %>
              <%= f.submit "Buka 30 menit", class: "w-full rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold px-3 py-2 cursor-pointer" %>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>

    <dl class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-sm">
      <% rows = [
           [ "Nama", clinical_case.patient_name, clinical_case.masked_patient_name ],
           [ "No. RM", clinical_case.patient_medical_record_number, clinical_case.masked_medical_record_number ],
           [ "Tanggal lahir", (clinical_case.patient_birth_date_as_date && l(clinical_case.patient_birth_date_as_date, format: :long)), (clinical_case.patient_birth_date.present? ? "••••" : nil) ],
           [ "Telepon", clinical_case.patient_phone, (clinical_case.patient_phone.present? ? "••••" : nil) ],
           [ "Alamat", clinical_case.patient_address, (clinical_case.patient_address.present? ? "••••" : nil) ]
         ] %>
      <% rows.each do |label, real, masked| %>
        <% next if real.blank? %>
        <div>
          <dt class="text-xs text-gray-400"><%= label %></dt>
          <dd class="font-medium text-gray-800 <%= 'tracking-widest text-gray-400' unless identity_visible %>"><%= identity_visible ? real : masked %></dd>
        </div>
      <% end %>
    </dl>
  </div>
<% end %>
