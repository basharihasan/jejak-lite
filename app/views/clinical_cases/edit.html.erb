<div class="max-w-2xl">
  <h1 class="text-xl font-bold text-gray-900 mb-6">Sunting Kasus Klinis</h1>
  <% latest_revision_comment = @clinical_case.case_verification_comments.where(action: "revision_requested").last %>
  <% if @clinical_case.status == "needs_revision" && latest_revision_comment&.body.present? %>
    <div class="mb-4 rounded-lg bg-amber-50 border border-amber-200 text-amber-800 px-4 py-3 text-sm">
      <p class="font-semibold">Catatan revisi dari <%= latest_revision_comment.user.full_name %>:</p>
      <p class="mt-1"><%= latest_revision_comment.body %></p>
    </div>
  <% end %>
  <%= render "form", clinical_case: @clinical_case %>
</div>
