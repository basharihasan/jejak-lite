<div data-controller="wizard" class="bg-white rounded-2xl ring-1 ring-gray-200 p-6">
  <div class="flex items-center justify-between mb-4">
    <p data-wizard-target="label" class="text-xs font-bold text-indigo-600 uppercase tracking-wide">Langkah 1 dari 4</p>
    <div class="flex items-center gap-1.5">
      <% 4.times do %>
        <span data-wizard-target="dot" class="h-1.5 w-8 rounded-full bg-gray-200"></span>
      <% end %>
    </div>
  </div>

  <%= form_with model: clinical_case, class: "space-y-4" do |f| %>
    <% if clinical_case.errors.any? %>
      <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
        <%= clinical_case.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div data-wizard-target="step">
      <h2 class="text-lg font-bold text-gray-900 mb-4">Informasi Dasar</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <%= f.label :case_date, "Tanggal Kasus", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <%= f.date_field :case_date,
                class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
        </div>
        <div>
          <%= f.label :patient_age_group, "Kelompok Usia Pasien", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <%= f.select :patient_age_group, ClinicalCase::AGE_GROUPS, { include_blank: "-" },
                class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
        </div>
        <div>
          <%= f.label :patient_gender, "Jenis Kelamin Pasien", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <%= f.select :patient_gender, ClinicalCase::GENDERS, { include_blank: "-" },
                class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
        </div>
      </div>

      <%# Identitas pasien — terenkripsi di basis data dan disamarkan di
          halaman kasus (Privacy Mode); hanya pemilik kasus yang melihatnya
          di form ini. Usia persis & pekerjaan tidak sensitif. %>
      <div class="mt-5 rounded-2xl ring-1 ring-amber-200 bg-amber-50/60 p-4">
        <div class="flex items-start justify-between gap-3 flex-wrap">
          <div>
            <p class="text-sm font-semibold text-gray-800">Identitas Pasien</p>
            <p class="text-xs text-gray-500 mt-0.5">Disimpan terenkripsi dan disamarkan bagi pembaca lain; hanya dibuka lewat Break Glass beralasan yang tercatat.</p>
          </div>
          <span class="text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full bg-amber-100 text-amber-800">Data sensitif</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-3">
          <div>
            <%= f.label :patient_name, "Nama Pasien", class: "block text-sm font-semibold text-gray-700 mb-1" %>
            <%= f.text_field :patient_name, autocomplete: "off",
                  class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
          </div>
          <div>
            <%= f.label :patient_medical_record_number, "No. Rekam Medis", class: "block text-sm font-semibold text-gray-700 mb-1" %>
            <%= f.text_field :patient_medical_record_number, autocomplete: "off",
                  class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
          </div>
          <div>
            <%= f.label :patient_birth_date, "Tanggal Lahir", class: "block text-sm font-semibold text-gray-700 mb-1" %>
            <%= f.date_field :patient_birth_date, value: clinical_case.patient_birth_date,
                  class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
          </div>
          <div>
            <%= f.label :patient_phone, "Telepon", class: "block text-sm font-semibold text-gray-700 mb-1" %>
            <%= f.text_field :patient_phone, autocomplete: "off",
                  class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
          </div>
          <div class="sm:col-span-2">
            <%= f.label :patient_address, "Alamat", class: "block text-sm font-semibold text-gray-700 mb-1" %>
            <%= f.text_field :patient_address, autocomplete: "off",
                  class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4 mt-4">
          <div>
            <%= f.label :patient_age, "Usia (tahun)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
            <%= f.number_field :patient_age, min: 0, max: 149,
                  class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
          </div>
          <div>
            <%= f.label :patient_occupation, "Pekerjaan", class: "block text-sm font-semibold text-gray-700 mb-1" %>
            <%= f.text_field :patient_occupation,
                  class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
        <div>
          <%= f.label :clinical_setting, "Setting Klinis", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <%= f.select :clinical_setting, options_for_select(ClinicalContextOptions::CLINICAL_SETTINGS.invert, clinical_case.clinical_setting), { include_blank: "-" },
                class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
        </div>
        <div>
          <%= f.label :case_complexity, "Kompleksitas Kasus", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <%= f.select :case_complexity, options_for_select(ClinicalContextOptions::CASE_COMPLEXITY.invert, clinical_case.case_complexity), { include_blank: "-" },
                class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
        </div>
      </div>

      <div class="mt-4">
        <%= f.label :chief_complaint, "Keluhan Utama", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <p class="text-xs text-gray-400 mb-1">Keluhan utama yang membawa pasien datang.</p>
        <%= f.text_field :chief_complaint, placeholder: "Contoh: Demam 3 hari, Nyeri perut kanan bawah",
              class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
      </div>
    </div>

    <div data-wizard-target="step" hidden>
      <h2 class="text-lg font-bold text-gray-900 mb-4">Anamnesis & Pemeriksaan Fisik</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :anamnesis, "Anamnesis Lengkap", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <p class="text-xs text-gray-400 mb-1">Riwayat penyakit sekarang, dahulu, dll.</p>
          <%= f.text_area :anamnesis, rows: 4,
                class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm resize-none" %>
        </div>
        <div>
          <%= f.label :general_condition, "Keadaan Umum", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <p class="text-xs text-gray-400 mb-1">Kesan sakit, kesadaran/GCS, tampilan umum pasien.</p>
          <%= f.text_area :general_condition, rows: 4,
                class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm resize-none" %>
        </div>
        <div>
          <%= f.label :physical_examination, "Pemeriksaan Fisik Lengkap", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <p class="text-xs text-gray-400 mb-1">Keadaan lokalis dan status fisik lainnya.</p>
          <%= f.text_area :physical_examination, rows: 4,
                class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm resize-none" %>
        </div>
        <div>
          <%= f.label :family_history, "Riwayat Keluarga", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <p class="text-xs text-gray-400 mb-1">Riwayat kanker, diabetes, hipertensi, dll. dalam keluarga.</p>
          <%= f.text_area :family_history, rows: 4,
                class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm resize-none" %>
        </div>
      </div>

      <div class="mt-4 bg-gray-50 rounded-xl p-4">
        <p class="text-xs font-semibold text-gray-500 uppercase mb-3">Tanda-Tanda Vital</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <% ClinicalCase::VITAL_SIGN_FIELDS.each do |key, label| %>
            <div>
              <label class="block text-xs text-gray-500 mb-1"><%= label %></label>
              <%= number_field_tag "clinical_case[vital_signs][#{key}]", clinical_case.vital_sign(key), step: 0.1, min: 0,
                    class: "block w-full rounded-lg border-0 py-2 px-2.5 text-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500" %>
            </div>
          <% end %>
          <div>
            <label class="block text-xs text-gray-500 mb-1">BMI (kg/m²)</label>
            <p class="py-2 px-2.5 text-sm text-gray-400">— dihitung otomatis</p>
          </div>
        </div>
      </div>
    </div>

    <div data-wizard-target="step" hidden>
      <h2 class="text-lg font-bold text-gray-900 mb-4">Diagnosis & Tatalaksana</h2>
      <div>
        <%= f.label :diagnosis, "Diagnosis", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <p class="text-xs text-gray-400 mb-1">Ketik untuk memilih dari master Diagnosis SKDI — kode ICD-10 & level SKDI terisi otomatis bila cocok.</p>
        <%= f.text_field :diagnosis, list: "diagnosis-definitions", autocomplete: "off",
              class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
        <datalist id="diagnosis-definitions">
          <% DiagnosisDefinition.active.ordered.pluck(:name, :icd10_code, :skdi_level).each do |name, code, level| %>
            <option value="<%= name %>"><%= [ code, level && "SKDI #{level}" ].compact.join(" · ") %></option>
          <% end %>
        </datalist>
      </div>
      <div class="mt-4">
        <%= f.label :management, "Tatalaksana", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.text_area :management, rows: 4,
              class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm resize-none" %>
      </div>
    </div>

    <div data-wizard-target="step" hidden>
      <h2 class="text-lg font-bold text-gray-900 mb-4">Pembelajaran & Bukti</h2>
      <div>
        <%= f.label :learning_points, "Poin Pembelajaran", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <p class="text-xs text-gray-400 mb-1">Apa yang Anda pelajari dari kasus ini?</p>
        <%= f.text_area :learning_points, rows: 3,
              class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm resize-none" %>
      </div>
      <div class="mt-4">
        <%= f.label :evidence_files, "Bukti Pendukung (opsional)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.file_field :evidence_files, multiple: true, class: "text-sm" %>
      </div>
    </div>

    <div class="flex items-center justify-between pt-4 mt-2 border-t border-gray-100">
      <button type="button" data-action="wizard#prev" data-wizard-target="prevButton" hidden
            class="text-sm font-semibold text-gray-600 hover:text-indigo-600 px-4 py-2.5 cursor-pointer">
        ← Sebelumnya
      </button>
      <div class="ml-auto flex gap-2">
        <button type="button" data-action="wizard#next" data-wizard-target="nextButton"
              class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold px-5 py-2.5 rounded-xl text-sm cursor-pointer">
          Lanjut →
        </button>
        <%= f.submit clinical_case.persisted? ? "Simpan Perubahan" : "Simpan sebagai Draf",
              data: { wizard_target: "submitButton" }, hidden: true,
              class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>
