<% status_colors = {
  "draft" => "bg-gray-100 text-gray-600",
  "submitted" => "bg-amber-50 text-amber-700",
  "verified" => "bg-emerald-50 text-emerald-700",
  "needs_revision" => "bg-rose-50 text-rose-700"
} %>
<div class="max-w-2xl">
  <div class="flex items-center justify-between flex-wrap gap-3">
    <div>
      <span class="text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full <%= status_colors[@clinical_case.status] %>">
        <%= @clinical_case.status_label %>
      </span>
      <h1 class="text-xl font-bold text-gray-900 mt-2"><%= @clinical_case.chief_complaint %></h1>
      <p class="text-sm text-gray-400 mt-1">
        <%= l(@clinical_case.case_date, format: :long) %>
        <% if @clinical_case.user != current_user %> · dilaporkan oleh <%= @clinical_case.user.full_name %><% end %>
        <% if @clinical_case.patient_age_group.present? %> · <%= @clinical_case.patient_age_group %><% end %>
        <% if @clinical_case.patient_gender.present? %>, <%= @clinical_case.patient_gender %><% end %>
      </p>
      <p class="text-xs text-gray-400 mt-1">
        <% [@clinical_case.clinical_setting && ClinicalContextOptions::CLINICAL_SETTINGS[@clinical_case.clinical_setting],
             @clinical_case.case_complexity && "Kompleksitas #{ClinicalContextOptions::CASE_COMPLEXITY[@clinical_case.case_complexity]}",
             @clinical_case.entrustment_level && "Level: #{@clinical_case.entrustment_level_label}"].compact.join(" · ") %>
      </p>
      <% if @clinical_case.recommend_remediation? %>
        <span class="mt-1 inline-block text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full bg-rose-50 text-rose-700">Direkomendasikan Remediasi</span>
      <% end %>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <% if policy(@clinical_case).update? %>
        <%= link_to "Sunting", edit_clinical_case_path(@clinical_case), class: "text-sm text-gray-600 hover:text-indigo-600 font-medium" %>
      <% end %>
      <% if policy(@clinical_case).destroy? %>
        <%= button_to "Hapus", clinical_case_path(@clinical_case), method: :delete,
              class: "text-sm text-rose-600 hover:underline",
              form: { data: { turbo_confirm: "Hapus draf ini?" } } %>
      <% end %>
    </div>
  </div>

  <% if @clinical_case.status == "verified" %>
    <div class="mt-4 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 text-sm">
      Diverifikasi oleh <%= @clinical_case.verified_by&.full_name %> pada <%= l(@clinical_case.verified_at, format: :long) %>.
    </div>
  <% end %>

  <% if @clinical_case.case_verification_comments.any? %>
    <div class="mt-4 bg-white rounded-2xl ring-1 ring-gray-200 p-5">
      <p class="text-sm font-semibold text-gray-700 mb-3">Riwayat Verifikasi</p>
      <div class="space-y-3">
        <% @clinical_case.case_verification_comments.each do |comment| %>
          <div class="flex items-start gap-3">
            <span class="mt-0.5 h-2 w-2 rounded-full bg-gray-300 shrink-0"></span>
            <div class="min-w-0">
              <p class="text-xs text-gray-500">
                <span class="font-semibold text-gray-700"><%= comment.action_label %></span>
                oleh <%= comment.user.full_name %> · <%= l(comment.created_at, format: :long) %>
              </p>
              <% if comment.body.present? %>
                <p class="text-sm text-gray-700 mt-0.5 whitespace-pre-line"><%= comment.body %></p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
    <% if @clinical_case.diagnosis.present? %>
      <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
        <p class="text-xs font-semibold text-gray-500 uppercase mb-1">Diagnosis</p>
        <p class="text-sm text-gray-700 whitespace-pre-line"><%= @clinical_case.diagnosis %></p>
      </div>
    <% end %>
    <% if @clinical_case.management.present? %>
      <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
        <p class="text-xs font-semibold text-gray-500 uppercase mb-1">Tatalaksana</p>
        <p class="text-sm text-gray-700 whitespace-pre-line"><%= @clinical_case.management %></p>
      </div>
    <% end %>
  </div>

  <% if @clinical_case.learning_points.present? %>
    <div class="mt-3 bg-indigo-50/50 rounded-2xl ring-1 ring-indigo-100 p-5">
      <p class="text-xs font-semibold text-indigo-500 uppercase mb-1">Poin Pembelajaran</p>
      <p class="text-sm text-gray-700 whitespace-pre-line"><%= @clinical_case.learning_points %></p>
    </div>
  <% end %>

  <% if @clinical_case.evidence_files.attached? %>
    <div class="mt-3 bg-white rounded-2xl ring-1 ring-gray-200 p-5">
      <p class="text-xs font-semibold text-gray-500 uppercase mb-2">Bukti Pendukung</p>
      <div class="flex flex-wrap gap-2">
        <% @clinical_case.evidence_files.each do |file| %>
          <%= link_to rails_blob_path(file, disposition: "attachment"), class: "text-xs bg-gray-50 hover:bg-gray-100 rounded-lg px-3 py-2 text-gray-600" do %>
            📎 <%= file.filename %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if policy(@clinical_case).submit? %>
    <div class="mt-6">
      <%= button_to "Kirim untuk Verifikasi", submit_clinical_case_path(@clinical_case), method: :patch,
            class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm" %>
    </div>
  <% end %>

  <% if policy(@clinical_case).verify? %>
    <div class="mt-6 bg-white rounded-2xl ring-1 ring-gray-200 p-5 space-y-4">
      <div>
        <p class="text-sm font-semibold text-gray-700 mb-2">Verifikasi Kasus</p>
        <%= form_with url: verify_clinical_case_path(@clinical_case), method: :patch, class: "space-y-3" do |f| %>
          <div>
            <%= f.label :entrustment_level, "Tingkat Kepercayaan (Entrustment)", class: "block text-xs font-semibold text-gray-600 mb-1" %>
            <%= f.select :entrustment_level, options_for_select(ClinicalCase::ENTRUSTMENT_LEVELS.invert), { include_blank: "-" },
                  class: "block w-full rounded-xl border-0 py-2 px-3 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-emerald-500 text-sm" %>
          </div>
          <label class="flex items-center gap-2 text-xs text-gray-600">
            <%= f.check_box :recommend_remediation, class: "rounded border-gray-300" %>
            Rekomendasikan remediasi tambahan
          </label>
          <%= f.text_area :comment, rows: 2, placeholder: "Catatan untuk mahasiswa (opsional)...",
                class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-emerald-500 text-sm resize-none" %>
          <%= f.submit "Setujui / Verifikasi", class: "bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2 rounded-xl text-sm cursor-pointer" %>
        <% end %>
      </div>

      <div class="pt-3 border-t border-gray-100">
        <%= form_with url: request_revision_clinical_case_path(@clinical_case), method: :patch, class: "space-y-2" do |f| %>
          <%= f.text_area :comment, rows: 2, placeholder: "Catatan revisi untuk mahasiswa...",
                class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-rose-500 text-sm resize-none" %>
          <%= f.submit "Minta Revisi", class: "bg-rose-50 hover:bg-rose-100 text-rose-700 font-semibold px-4 py-2 rounded-xl text-sm cursor-pointer" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= link_to "← Kembali ke Kasus Klinis", clinical_cases_path, class: "mt-6 inline-block text-sm text-gray-500 hover:text-indigo-600" %>
</div>
