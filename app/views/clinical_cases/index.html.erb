<style>
  .pagination { display: flex; gap: 0.25rem; margin-top: 1.5rem; justify-content: center; }
  .pagination span, .pagination a { padding: 0.4rem 0.75rem; border-radius: 0.5rem; font-size: 0.8rem; }
  .pagination a { color: #4f46e5; border: 1px solid #e5e7eb; }
  .pagination a:hover { background: #eef2ff; }
  .pagination .current { background: #4f46e5; color: white; font-weight: 600; }
</style>

<div class="flex items-center justify-between flex-wrap gap-3">
  <h1 class="text-xl font-bold text-gray-900">Kasus Klinis</h1>
  <%= link_to "+ Kasus Baru", new_clinical_case_path,
        class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl text-sm" %>
</div>

<% if current_user.can_verify_clinical_cases? %>
  <div class="mt-4 flex items-center gap-2">
    <%= link_to "Punya Saya", clinical_cases_path, class: "text-xs px-3 py-1.5 rounded-full font-medium #{@scope == 'mine' ? 'bg-indigo-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
    <%= link_to "Perlu Diverifikasi", clinical_cases_path(scope: "to_verify"), class: "text-xs px-3 py-1.5 rounded-full font-medium #{@scope == 'to_verify' ? 'bg-indigo-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
  </div>
<% end %>

<% if @case_targets.present? %>
  <div class="mt-4 bg-white rounded-2xl ring-1 ring-gray-200 p-5">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <p class="text-sm font-semibold text-gray-700">Pemenuhan Target Kasus (terverifikasi)</p>
      <p class="text-[11px] text-gray-400">FKTP = Pelayanan Primer · FKRTL = rumah sakit</p>
    </div>
    <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <% @case_targets.each do |row| %>
        <% target = row[:target]; achieved = row[:achieved]; pct = target.target_count.zero? ? 100 : [ (achieved * 100.0 / target.target_count).round, 100 ].min %>
        <div>
          <div class="flex items-baseline justify-between">
            <p class="text-xs font-semibold text-gray-600"><%= target.facility_label %></p>
            <p class="text-xs text-gray-500"><span class="font-bold text-gray-800"><%= achieved %></span> / <%= target.target_count %></p>
          </div>
          <div class="mt-1.5 h-2 rounded-full bg-gray-100 overflow-hidden">
            <div class="h-full rounded-full <%= pct >= 100 ? 'bg-emerald-500' : 'bg-indigo-500' %>" style="width: <%= pct %>%"></div>
          </div>
          <% if target.academic_period %><p class="text-[10px] text-gray-400 mt-1"><%= target.academic_period.name %></p><% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<% if @stats[:total].positive? %>
  <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
      <p class="text-sm font-semibold text-gray-700 mb-3">Ringkasan Status (<%= @stats[:total] %> kasus)</p>
      <div class="flex flex-wrap gap-2">
        <% @stats[:by_status].each do |status, count| %>
          <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-gray-100 text-gray-600"><%= ClinicalCase.new(status: status).status_label %>: <%= count %></span>
        <% end %>
      </div>
    </div>
    <% if @stats[:top_diagnoses].any? %>
      <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
        <p class="text-sm font-semibold text-gray-700 mb-3">Diagnosis Terbanyak</p>
        <%= bar_chart @stats[:top_diagnoses], colors: [ "#4f46e5" ], height: "160px" %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
  <% if @clinical_cases.any? %>
    <%= render partial: "clinical_case_card", collection: @clinical_cases, as: :clinical_case %>
  <% else %>
    <p class="text-sm text-gray-400 col-span-2">
      <%= @scope == "to_verify" ? "Tidak ada kasus yang menunggu verifikasi." : "Belum ada kasus klinis tercatat." %>
    </p>
  <% end %>
</div>

<%= paginate @clinical_cases %>
