<%# Persetujuan pasien via QR/tautan: diterbitkan pemilik kasus, dijawab
    pasien tanpa login, jawabannya tampil di sini butir per butir. %>
<div class="mt-4 bg-white rounded-2xl ring-1 ring-gray-200 p-5">
  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div>
      <p class="text-xs font-semibold text-gray-500 uppercase">Persetujuan Pasien</p>
      <% if consent.nil? %>
        <p class="text-[11px] text-gray-400 mt-0.5">Belum diterbitkan. Terbitkan QR lalu minta pasien memindainya di ponselnya.</p>
      <% elsif consent.revoked? %>
        <p class="text-[11px] text-rose-600 mt-0.5">Dicabut pada <%= l(consent.revoked_at, format: :short) %>.</p>
      <% elsif consent.signed? %>
        <p class="text-[11px] text-emerald-700 mt-0.5">Dijawab oleh <%= consent.signer_name %> (<%= PatientConsent::RELATIONS[consent.signer_relation] %>) pada <%= l(consent.signed_at, format: :short) %>.</p>
      <% else %>
        <p class="text-[11px] text-amber-700 mt-0.5">Menunggu jawaban pasien.</p>
      <% end %>
    </div>
    <% if policy(clinical_case).issue_consent? %>
      <div class="flex items-center gap-2">
        <% if consent && !consent.revoked? %>
          <%= button_to "Cabut", revoke_consent_clinical_case_path(clinical_case), method: :patch,
                form: { data: { turbo_confirm: "Cabut persetujuan pasien ini?" } },
                class: "text-xs font-semibold text-rose-600 hover:underline" %>
        <% end %>
        <%= button_to (consent ? "Terbitkan Ulang QR" : "Terbitkan QR Persetujuan"), issue_consent_clinical_case_path(clinical_case), method: :post,
              class: "rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold px-3 py-2 cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <% if consent && !consent.revoked? %>
    <% url = public_patient_consent_url(consent.token) %>
    <div class="mt-4 flex flex-col sm:flex-row gap-5">
      <% unless consent.signed? %>
        <div class="shrink-0">
          <%= raw RQRCode::QRCode.new(url).as_svg(module_size: 3, standalone: true, use_path: true, color: "0f172a") %>
          <p class="text-[10px] text-gray-400 mt-1 break-all max-w-[9rem]"><%= link_to url, url, target: "_blank", rel: "noopener", class: "hover:text-indigo-600" %></p>
        </div>
      <% end %>
      <ul class="flex-1 space-y-1.5 text-sm">
        <% PatientConsent::ITEMS.each do |key, text| %>
          <li class="flex items-start gap-2">
            <% if consent.signed? %>
              <span class="<%= consent.granted?(key) ? 'text-emerald-600' : 'text-rose-500' %> font-bold"><%= consent.granted?(key) ? "✓" : "✗" %></span>
            <% else %>
              <span class="text-gray-300">○</span>
            <% end %>
            <span class="text-gray-700"><%= text %></span>
          </li>
        <% end %>
      </ul>
    </div>
    <% if consent.signed? && clinical_case.evidence_files.attached? && !consent.granted?("photo") %>
      <p class="mt-3 text-xs text-amber-700 bg-amber-50 rounded-lg px-3 py-2">Kasus ini memiliki bukti terlampir, tetapi pasien <strong>tidak</strong> menyetujui dokumentasi foto. Pastikan lampiran bukan foto klinis pasien.</p>
    <% end %>
  <% end %>
</div>
