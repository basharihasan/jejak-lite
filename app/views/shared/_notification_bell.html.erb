<details class="relative">
  <summary class="cursor-pointer list-none relative p-1.5 rounded-full hover:bg-gray-100">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-gray-600">
      <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
      <path d="M13.73 21a2 2 0 0 1-3.46 0" />
    </svg>
    <% if unread_notifications_count.positive? %>
      <span class="absolute -top-0.5 -right-0.5 h-4 min-w-4 px-1 rounded-full bg-rose-500 text-white text-[10px] font-bold flex items-center justify-center leading-none">
        <%= unread_notifications_count > 9 ? "9+" : unread_notifications_count %>
      </span>
    <% end %>
  </summary>

  <div class="absolute right-0 mt-2 w-80 bg-white rounded-xl shadow-lg ring-1 ring-gray-200 py-2 z-20 max-h-96 overflow-y-auto">
    <% if latest_notifications.any? %>
      <div class="px-1 space-y-1">
        <% latest_notifications.each do |notification| %>
          <div class="px-3 py-2 rounded-lg <%= "bg-indigo-50/60" unless notification.read? %>">
            <p class="text-sm font-medium text-gray-800 truncate"><%= notification.title %></p>
            <p class="text-xs text-gray-400 mt-0.5"><%= time_ago_in_words(notification.created_at) %> yang lalu</p>
          </div>
        <% end %>
      </div>
      <%= link_to "Lihat semua notifikasi", notifications_path,
            class: "block text-center text-xs text-indigo-600 font-medium py-2 mt-1 border-t border-gray-100" %>
    <% else %>
      <p class="text-sm text-gray-400 px-4 py-3">Belum ada notifikasi.</p>
    <% end %>
  </div>
</details>
