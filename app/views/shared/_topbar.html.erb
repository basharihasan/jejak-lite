<%# Topbar — hamburger (mobile), judul halaman, pengalih peran, tombol tema,
    bantuan, lonceng notifikasi, menu akun. Meniru shared/_topbar jejak.pro
    tanpa pengalih organisasi (jejak-lite single-tenant). %>
<header class="sticky top-0 z-30 flex h-14 items-center gap-4 border-b border-slate-200 bg-white/95 backdrop-blur px-4 sm:px-6 shadow-sm">
  <button type="button" data-action="click->sidebar#open"
          class="lg:hidden inline-flex items-center justify-center rounded-lg p-2 text-slate-500 hover:bg-slate-100 hover:text-slate-900 transition-colors">
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
    </svg>
  </button>

  <div class="flex-1 min-w-0">
    <% page_title = content_for(:page_title).presence || content_for(:title).presence %>
    <% if page_title %>
      <h1 class="text-sm font-semibold text-slate-800 truncate"><%= page_title %></h1>
    <% end %>
  </div>

  <% if current_user.roles.size > 1 %>
    <div class="hidden md:flex items-center gap-3">
      <%= form_with url: switch_roles_path, method: :patch, class: "flex items-center space-x-2" do %>
        <label for="role_code" class="text-[10px] font-bold uppercase tracking-widest text-slate-400"><%= t("chrome.topbar.active_role") %></label>
        <select name="role_code" id="role_code" onchange="this.form.requestSubmit();"
                class="text-xs font-medium rounded-md border-slate-300 py-1.5 pl-3 pr-8 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 text-slate-700 shadow-sm cursor-pointer">
          <% current_user.roles.each do |role| %>
            <option value="<%= role.code %>" <%= "selected" if role == current_user.active_role %>><%= role.name %></option>
          <% end %>
        </select>
      <% end %>
    </div>
  <% end %>

  <div class="flex items-center gap-1 sm:gap-3 ml-auto sm:ml-0">
    <%= link_to search_path, title: t("chrome.topbar.search"),
          class: "inline-flex items-center gap-2 rounded-xl p-2 text-slate-500 hover:bg-slate-100 hover:text-slate-900 transition-colors" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
    <% end %>

    <button type="button"
            data-controller="theme-toggle"
            data-action="click->theme-toggle#cycle"
            data-url="<%= update_appearance_settings_path %>"
            title="<%= t("chrome.topbar.toggle_theme") %>"
            class="inline-flex items-center justify-center rounded-xl p-2 text-slate-500 hover:bg-slate-100 hover:text-slate-900 transition-colors cursor-pointer border-0 bg-transparent">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
      </svg>
    </button>

    <%# Ganti bahasa — tombol menampilkan kode bahasa TUJUAN ("EN" saat
        antarmuka berbahasa Indonesia). Form biasa, bukan fetch: mengganti
        bahasa harus memuat ulang halaman. %>
    <% other_locale = (I18n.locale.to_s == "en" ? "id" : "en") %>
    <%= form_with url: update_locale_settings_path, method: :patch, class: "contents" do %>
      <%= hidden_field_tag :locale, other_locale %>
      <button type="submit" title="<%= t("chrome.topbar.switch_language") %>" aria-label="<%= t("chrome.topbar.switch_language") %>"
              class="inline-flex items-center justify-center rounded-xl px-2.5 py-2 text-xs font-bold tracking-wide text-slate-500 hover:bg-slate-100 hover:text-slate-900 transition-colors cursor-pointer border-0 bg-transparent">
        <%= other_locale.upcase %>
      </button>
    <% end %>

    <%= link_to panduan_path, target: "_blank", rel: "noopener", title: t("chrome.topbar.page_help"),
          class: "inline-flex items-center justify-center rounded-xl p-2 text-slate-500 hover:bg-slate-100 hover:text-slate-900 transition-colors" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z"/>
      </svg>
    <% end %>

    <%# Lonceng notifikasi %>
    <div class="relative" data-controller="notification-dropdown">
      <button type="button" data-action="click->notification-dropdown#toggle"
              class="relative inline-flex items-center justify-center rounded-xl p-2 text-slate-500 hover:bg-slate-100 hover:text-slate-900 transition-colors cursor-pointer border-0 bg-transparent">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a9.04 9.04 0 0 1-2.357.258 9.04 9.04 0 0 1-2.357-.258m4.9 0A8.986 8.986 0 0 0 18 12V7.702c0-2.21-1.49-4.084-3.6-4.578a4.82 4.82 0 0 0-3.4-.003C8.89 3.618 7.4 5.492 7.4 7.702V12c0 2.012-.465 3.86-1.285 5.503m12.188 0A17.973 17.973 0 0 1 12 18a17.973 17.973 0 0 1-6.887-1.082m12.188 0c-.22.518-.328 1.077-.328 1.637v.34c0 .6-.21 1.17-.68 1.64a1.64 1.64 0 0 1-2.32 0 1.64 1.64 0 0 1-.68-1.64v-.34c0-.56-.108-1.12-.328-1.637" />
        </svg>
        <% unread_count = unread_notifications_count %>
        <% if unread_count > 0 %>
          <span class="absolute top-1.5 right-1.5 flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-600"></span>
          </span>
        <% end %>
      </button>
      <div data-notification-dropdown-target="menu"
           class="hidden absolute right-0 mt-2 w-80 origin-top-right rounded-2xl border border-slate-100 bg-white/95 backdrop-blur-md shadow-2xl z-50 overflow-hidden transition-all duration-200 transform scale-95 opacity-0">
        <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between">
          <span class="text-xs font-bold text-slate-800"><%= t("chrome.topbar.notifications") %></span>
          <% if unread_count > 0 %>
            <span class="inline-flex items-center rounded-full bg-indigo-50 px-2 py-0.5 text-[10px] font-bold text-indigo-700"><%= t("chrome.topbar.unread_count", count: unread_count) %></span>
          <% end %>
        </div>
        <div class="max-h-64 overflow-y-auto divide-y divide-slate-50">
          <% if latest_notifications.any? %>
            <% latest_notifications.each do |n| %>
              <div class="p-3 flex items-start gap-2.5 hover:bg-slate-50 transition-colors border-l-4 border-l-indigo-500 <%= 'bg-indigo-50/5' unless n.read? %>">
                <div class="flex-1 min-w-0">
                  <p class="text-[11px] font-bold text-slate-900 truncate"><%= n.title %></p>
                  <% if n.message.present? %>
                    <p class="text-[10px] text-slate-500 font-light line-clamp-2 mt-0.5"><%= n.message %></p>
                  <% end %>
                  <p class="mt-1 text-[9px] text-slate-400"><%= t("chrome.topbar.time_ago", time: time_ago_in_words(n.created_at)) %></p>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-xs text-slate-400 px-4 py-6 text-center"><%= t("chrome.topbar.no_notifications") %></p>
          <% end %>
        </div>
        <%= link_to t("chrome.topbar.see_all_notifications"), notifications_path,
              class: "block text-center text-xs text-indigo-600 font-bold py-2.5 border-t border-slate-100 hover:bg-slate-50" %>
      </div>
    </div>

    <%# Menu akun %>
    <div class="relative" data-controller="notification-dropdown">
      <button type="button" data-action="click->notification-dropdown#toggle"
              class="h-8 w-8 rounded-full bg-gradient-to-br from-indigo-400 to-indigo-600 text-white flex items-center justify-center text-sm font-bold shadow cursor-pointer border-0">
        <%= current_user.full_name.first.upcase %>
      </button>
      <div data-notification-dropdown-target="menu"
           class="hidden absolute right-0 mt-2 w-52 origin-top-right rounded-2xl border border-slate-100 bg-white/95 backdrop-blur-md shadow-2xl z-50 overflow-hidden transition-all duration-200 transform scale-95 opacity-0 py-1">
        <div class="px-4 py-2.5 border-b border-slate-100">
          <p class="text-xs font-bold text-slate-800 truncate"><%= current_user.full_name %></p>
          <p class="text-[10px] text-slate-400 truncate"><%= current_user.email %></p>
        </div>
        <%= link_to t("chrome.my_profile"), profile_path, class: "block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
        <%= link_to t("chrome.my_settings"), my_settings_path, class: "block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
        <%= button_to t("chrome.sign_out"), destroy_user_session_path, method: :delete,
              class: "w-full text-left px-4 py-2 text-sm text-rose-600 hover:bg-rose-50" %>
      </div>
    </div>
  </div>
</header>
