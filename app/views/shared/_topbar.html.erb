<header class="bg-white border-b border-gray-200">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <div class="flex items-center gap-6">
      <%= link_to "Jejak Lite", dashboard_path, class: "font-bold text-lg text-indigo-600" %>
      <nav class="hidden sm:flex items-center gap-4 text-sm text-gray-600">
        <%= link_to "Logbook", activity_logs_path, class: "hover:text-indigo-600" %>
        <%= link_to "Kasus Klinis", clinical_cases_path, class: "hover:text-indigo-600" %>
        <%= link_to "Jadwal Rotasi", clinical_rotations_path, class: "hover:text-indigo-600" %>
        <%= link_to "Refleksi", reflection_entries_path, class: "hover:text-indigo-600" %>
        <%= link_to "Portfolio", portfolio_path, class: "hover:text-indigo-600" %>

        <details class="relative">
          <summary class="cursor-pointer list-none hover:text-indigo-600 list-image-none">Lainnya</summary>
          <div class="absolute left-0 mt-2 w-44 bg-white rounded-xl shadow-lg ring-1 ring-gray-200 py-1 z-10">
            <%= link_to "Cari", search_path, class: "block px-4 py-2 text-sm hover:bg-gray-50" %>
            <%= link_to "Panduan", panduan_path, class: "block px-4 py-2 text-sm hover:bg-gray-50" %>
            <% if current_user.has_role?("admin") %>
              <%= link_to "Periode Akademik", academic_periods_path, class: "block px-4 py-2 text-sm hover:bg-gray-50" %>
            <% end %>
          </div>
        </details>
      </nav>
    </div>

    <div class="flex items-center gap-4">
      <% if current_user.roles.size > 1 %>
        <details class="relative">
          <summary class="cursor-pointer list-none text-sm px-3 py-1.5 rounded-full bg-indigo-50 text-indigo-700 font-medium">
            <%= current_user.active_role&.name || "Pilih peran" %>
          </summary>
          <div class="absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-lg ring-1 ring-gray-200 py-1 z-10">
            <% current_user.roles.each do |role| %>
              <%= button_to role.name, switch_roles_path(role_code: role.code), method: :patch,
                    class: "w-full text-left px-4 py-2 text-sm hover:bg-gray-50 #{'font-semibold text-indigo-600' if role == current_user.active_role}" %>
            <% end %>
          </div>
        </details>
      <% end %>

      <%= render "shared/notification_bell" %>

      <details class="relative">
        <summary class="cursor-pointer list-none flex items-center gap-2">
          <span class="h-8 w-8 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center text-sm font-semibold">
            <%= current_user.full_name.first.upcase %>
          </span>
        </summary>
        <div class="absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-lg ring-1 ring-gray-200 py-1 z-10">
          <%= link_to "Profil Saya", profile_path, class: "block px-4 py-2 text-sm hover:bg-gray-50" %>
          <%= button_to "Keluar", destroy_user_session_path, method: :delete,
                class: "w-full text-left px-4 py-2 text-sm hover:bg-gray-50 text-rose-600" %>
        </div>
      </details>
    </div>
  </div>
</header>
