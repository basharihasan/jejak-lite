<% if notice %>
  <div class="mb-4 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 text-sm">
    <%= notice %>
  </div>
<% end %>
<% if alert %>
  <div class="mb-4 rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
    <%= alert %>
  </div>
<% end %>
