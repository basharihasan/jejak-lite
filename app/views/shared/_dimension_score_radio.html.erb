<%#
  Radio-card 1-9 dengan pita warna (1-3 merah/4-6 kuning/7-9 hijau) meniru
  gaya skor DOPS/Mini-CEX JEJAK asli — dipakai bersama oleh form DOPS &
  Mini-CEX supaya tidak duplikasi markup.

  Locals wajib: form_name (string, mis. "dops_evaluation"), key, label,
  required (boolean), current_value.
%>
<div>
  <label class="block text-sm text-gray-700 mb-1.5"><%= label %><%= " *" if required %></label>
  <div class="flex flex-wrap gap-1.5">
    <% (1..9).each do |n| %>
      <% band_classes = if n <= 3
           "peer-checked:ring-rose-500 peer-checked:bg-rose-50 peer-checked:text-rose-700"
         elsif n <= 6
           "peer-checked:ring-amber-500 peer-checked:bg-amber-50 peer-checked:text-amber-700"
         else
           "peer-checked:ring-emerald-500 peer-checked:bg-emerald-50 peer-checked:text-emerald-700"
         end %>
      <label class="cursor-pointer">
        <input type="radio" name="<%= form_name %>[scores][<%= key %>]" value="<%= n %>"
               class="peer sr-only" <%= "checked" if current_value.to_s == n.to_s %>>
        <span class="flex h-9 w-9 items-center justify-center rounded-lg text-sm font-semibold ring-1 ring-inset ring-gray-200 text-gray-500 peer-checked:ring-2 <%= band_classes %>"><%= n %></span>
      </label>
    <% end %>
    <% unless required %>
      <label class="cursor-pointer">
        <input type="radio" name="<%= form_name %>[scores][<%= key %>]" value=""
               class="peer sr-only" <%= "checked" if current_value.blank? %>>
        <span class="flex h-9 px-2.5 items-center justify-center rounded-lg text-xs font-semibold ring-1 ring-inset ring-gray-200 text-gray-400 peer-checked:ring-2 peer-checked:ring-gray-400 peer-checked:bg-gray-100">N/A</span>
      </label>
    <% end %>
  </div>
</div>
