<div class="max-w-xl">
  <h1 class="text-xl font-bold text-gray-900 mb-1"><%= @template.name %></h1>
  <p class="text-sm text-gray-500 mb-6"><%= @template.description %></p>

  <%= form_with model: @submission, url: assessment_form_template_assessment_form_submissions_path(@template), class: "space-y-5" do |f| %>
    <% if @submission.errors.any? %>
      <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
        <%= @submission.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <% if @template.requires_subject_user? %>
      <div>
        <%= f.label :subject_user_id, (params[:subject_role].to_s == "mahasiswa" ? "Mahasiswa yang Dinilai" : "Dosen yang Dinilai"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.collection_select :subject_user_id, @subject_candidates, :id, :full_name, { include_blank: "Pilih..." },
              class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm", data: { controller: "searchable-select" } %>
      </div>
    <% else %>
      <div>
        <%= f.label :subject_label, "Subjek (opsional, mis. nama blok)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.text_field :subject_label,
              class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
      </div>
    <% end %>

    <% @template.assessment_form_fields.ordered.each do |field| %>
      <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-4">
        <label class="block text-sm font-semibold text-gray-700 mb-1">
          <%= field.label %><%= " *" if field.required? %>
          <% if field.scorable? %><span class="ml-1 text-[10px] font-normal text-gray-400">skala <%= field.min_value %>–<%= field.max_score %> · bobot <%= field.weight.to_f.round(2) %></span><% end %>
        </label>
        <% if field.help_text.present? %><p class="text-xs text-gray-400 mb-2"><%= field.help_text %></p><% end %>

        <% case field.field_type %>
        <% when "rating" %>
          <div class="flex items-center gap-3">
            <% (1..field.max_score).each do |n| %>
              <label class="flex flex-col items-center text-xs text-gray-500 gap-1 cursor-pointer">
                <%= radio_button_tag "answers[#{field.id}]", n, false, class: "text-indigo-600" %>
                <%= n %>
              </label>
            <% end %>
          </div>
        <% when "rubric_level" %>
          <div class="space-y-2">
            <% field.option_rows.each do |row| %>
              <label class="flex items-start gap-3 rounded-xl border border-gray-200 px-3 py-2.5 text-sm cursor-pointer hover:bg-gray-50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
                <%= radio_button_tag "answers[#{field.id}]", row[:label], nil.to_s == row[:label].to_s, class: "mt-0.5 text-indigo-600" %>
                <span>
            <span class="font-semibold text-gray-800"><%= row[:label] %></span>
            <span class="text-[11px] text-gray-400">· skor <%= row[:score] %></span>
            <% if row[:description].present? %><span class="block text-xs text-gray-500"><%= row[:description] %></span><% end %>
                </span>
              </label>
            <% end %>
          </div>
        <% when "select" %>
          <%= select_tag "answers[#{field.id}]", options_for_select(field.option_values, nil),
                include_blank: "— pilih —", class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
        <% when "yes_no" %>
          <div class="flex items-center gap-4">
            <label class="flex items-center gap-1.5 text-sm text-gray-600 cursor-pointer">
              <%= radio_button_tag "answers[#{field.id}]", "ya", false %> Ya
            </label>
            <label class="flex items-center gap-1.5 text-sm text-gray-600 cursor-pointer">
              <%= radio_button_tag "answers[#{field.id}]", "tidak", false %> Tidak
            </label>
          </div>
        <% when "score" %>
          <div class="flex items-center gap-2">
            <%= number_field_tag "answers[#{field.id}]", nil, min: 0, max: field.max_score, step: "0.01",
                  class: "w-28 rounded-xl border-0 py-2 px-3 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
            <span class="text-xs text-gray-400">/ <%= field.max_score %></span>
          </div>
        <% when "textarea" %>
          <%= text_area_tag "answers[#{field.id}]", nil, rows: 3,
                class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm resize-none" %>
        <% else %>
          <%= text_field_tag "answers[#{field.id}]", nil,
                class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
        <% end %>
      </div>
    <% end %>

    <%= f.submit "Kirim Jawaban", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm cursor-pointer" %>
  <% end %>
</div>
