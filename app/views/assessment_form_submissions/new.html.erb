<div class="max-w-xl">
  <h1 class="text-xl font-bold text-gray-900 mb-1"><%= @template.name %></h1>
  <p class="text-sm text-gray-500 mb-6"><%= @template.description %></p>

  <%= form_with model: @submission, url: assessment_form_template_assessment_form_submissions_path(@template), class: "space-y-5" do |f| %>
    <% if @submission.errors.any? %>
      <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
        <%= @submission.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <% if @template.requires_subject_user? %>
      <div>
        <%= f.label :subject_user_id, "Dosen yang Dinilai", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.collection_select :subject_user_id, @subject_candidates, :id, :full_name, { include_blank: "Pilih dosen..." },
              class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
      </div>
    <% else %>
      <div>
        <%= f.label :subject_label, "Subjek (opsional, mis. nama blok)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.text_field :subject_label,
              class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
      </div>
    <% end %>

    <% @template.assessment_form_fields.each do |field| %>
      <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-4">
        <label class="block text-sm font-semibold text-gray-700 mb-2"><%= field.label %><%= " *" if field.required? %></label>

        <% case field.field_type %>
        <% when "rating" %>
          <div class="flex items-center gap-3">
            <% (1..5).each do |n| %>
              <label class="flex flex-col items-center text-xs text-gray-500 gap-1 cursor-pointer">
                <%= radio_button_tag "answers[#{field.id}]", n, false, class: "text-indigo-600" %>
                <%= n %>
              </label>
            <% end %>
          </div>
        <% when "yes_no" %>
          <div class="flex items-center gap-4">
            <label class="flex items-center gap-1.5 text-sm text-gray-600 cursor-pointer">
              <%= radio_button_tag "answers[#{field.id}]", "ya", false %> Ya
            </label>
            <label class="flex items-center gap-1.5 text-sm text-gray-600 cursor-pointer">
              <%= radio_button_tag "answers[#{field.id}]", "tidak", false %> Tidak
            </label>
          </div>
        <% when "textarea" %>
          <%= text_area_tag "answers[#{field.id}]", nil, rows: 3,
                class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm resize-none" %>
        <% else %>
          <%= text_field_tag "answers[#{field.id}]", nil,
                class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
        <% end %>
      </div>
    <% end %>

    <%= f.submit "Kirim Jawaban", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm cursor-pointer" %>
  <% end %>
</div>
