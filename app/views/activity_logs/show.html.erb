<% content_for :title, @activity_log.title %>
<div class="max-w-2xl">
  <div class="flex items-center justify-between">
    <div>
      <div class="flex items-center gap-2 flex-wrap">
        <%= activity_domain_badge(@activity_log) %>
        <% if @activity_log.verified? %>
          <span class="text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700">✓ Terverifikasi</span>
        <% else %>
          <span class="text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full bg-amber-50 text-amber-700">Menunggu Verifikasi</span>
        <% end %>
      </div>
      <h1 class="text-xl font-bold text-gray-900 mt-2"><%= @activity_log.title %></h1>
      <% if (detail = @activity_log.taxonomy_detail) %>
        <p class="text-sm text-gray-600 mt-1"><%= detail %></p>
      <% end %>
      <p class="text-sm text-gray-400 mt-1">
        <%= l(@activity_log.activity_date, format: :long) %>
        <% if @activity_log.started_at %>
          · <%= l(@activity_log.started_at, format: "%H:%M") %><%= "–#{l(@activity_log.ended_at, format: @activity_log.ended_at.to_date == @activity_log.started_at.to_date ? '%H:%M' : '%-d %b %H:%M')}" if @activity_log.ended_at %>
        <% end %>
        <%= " · #{@activity_log.location}" if @activity_log.location.present? %>
        <%= " · #{@activity_log.delivery_mode_label}" if @activity_log.delivery_mode.present? %>
        <% if @activity_log.user_id != current_user.id %> · dicatat oleh <%= @activity_log.user.full_name %><% end %>
      </p>
      <% if @activity_log.verified? %>
        <p class="text-xs text-emerald-600 mt-1">Diverifikasi oleh <%= @activity_log.verified_by.full_name %> · <%= l(@activity_log.verified_at, format: :long) %></p>
      <% end %>
      <% if @activity_log.competency_items.any? %>
        <div class="mt-2 flex flex-wrap gap-1">
          <% @activity_log.competency_items.each do |item| %>
            <span class="text-[11px] px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-600"><%= item.title %></span>
          <% end %>
        </div>
      <% end %>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <% if policy(@activity_log).verify? %>
        <%= button_to "Verifikasi", verify_activity_log_path(@activity_log), method: :patch,
              class: "text-sm bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2 rounded-xl cursor-pointer" %>
      <% end %>
      <% if policy(@activity_log).update? %>
        <%= link_to "Sunting", edit_activity_log_path(@activity_log), class: "text-sm text-gray-600 hover:text-indigo-600 font-medium" %>
        <%= button_to "Hapus", activity_log_path(@activity_log), method: :delete,
              class: "text-sm text-rose-600 hover:underline",
              form: { data: { turbo_confirm: "Hapus kegiatan ini?" } } %>
      <% end %>
    </div>
  </div>

  <% context_rows = [
       [ term("terms.clinical_rotation"), @activity_log.clinical_rotation&.then { |r| [ r.station_name, r.institution_name.presence ].compact.join(" — ") } ],
       [ term("terms.academic_period"), @activity_log.academic_period&.name ],
       [ term("terms.participant_count"), @activity_log.participant_count ]
     ].select { |_, value| value.present? } %>
  <% if context_rows.any? %>
    <dl class="mt-6 bg-white rounded-2xl ring-1 ring-gray-200 p-5 grid grid-cols-1 sm:grid-cols-3 gap-4">
      <% context_rows.each do |label, value| %>
        <div>
          <dt class="text-xs font-semibold text-gray-500 uppercase"><%= label %></dt>
          <dd class="text-sm text-gray-800 mt-0.5"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  <% end %>

  <% if @activity_log.description.present? %>
    <div class="mt-4 bg-white rounded-2xl ring-1 ring-gray-200 p-5">
      <p class="text-xs font-semibold text-gray-500 uppercase mb-1"><%= term("terms.activity_notes") %></p>
      <p class="text-sm text-gray-700 whitespace-pre-line"><%= @activity_log.description %></p>
    </div>
  <% end %>

  <% if @activity_log.reflection.present? %>
    <div class="mt-4 bg-indigo-50/50 rounded-2xl ring-1 ring-indigo-100 p-5">
      <p class="text-xs font-semibold text-indigo-500 uppercase mb-1">Refleksi</p>
      <p class="text-sm text-gray-700 whitespace-pre-line"><%= @activity_log.reflection %></p>
    </div>
  <% end %>

  <% links = [ [ term("terms.evidence_url"), @activity_log.evidence_url ], [ term("terms.document_url"), @activity_log.document_url ] ].select { |_, url| url.present? } %>
  <% if @activity_log.evidence_files.attached? || links.any? %>
    <div class="mt-4 bg-white rounded-2xl ring-1 ring-gray-200 p-5">
      <p class="text-xs font-semibold text-gray-500 uppercase mb-2"><%= term("terms.evidence_section") %></p>
      <% links.each do |label, url| %>
        <p class="text-sm mb-1.5">
          <span class="text-gray-500"><%= label %>:</span>
          <%= link_to url, url, target: "_blank", rel: "noopener noreferrer nofollow", class: "text-indigo-600 hover:underline break-all" %>
        </p>
      <% end %>
      <div class="flex flex-wrap gap-2">
        <% @activity_log.evidence_files.each do |file| %>
          <%= link_to rails_blob_path(file, disposition: "attachment"), class: "text-xs bg-gray-50 hover:bg-gray-100 rounded-lg px-3 py-2 text-gray-600" do %>
            📎 <%= file.filename %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @activity_log.clinical? %>
    <div class="mt-4 bg-white rounded-2xl ring-1 ring-gray-200 p-5">
      <p class="text-xs font-semibold text-gray-500 uppercase mb-2">Kode Pasien (anonim)</p>
      <% if @activity_log.patient_code.present? %>
        <div class="flex items-center gap-4">
          <%= raw RQRCode::QRCode.new(@activity_log.patient_code).as_svg(module_size: 4, use_path: true, svg_attributes: { class: "h-24 w-24" }) %>
          <div>
            <p class="text-sm font-mono text-gray-700"><%= @activity_log.patient_code %></p>
            <p class="text-xs text-gray-400 mt-1">Tempel/pindai kode ini untuk menautkan kegiatan lain ke pasien yang sama — tanpa menyimpan identitas pasien.</p>
          </div>
        </div>
      <% else %>
        <%= button_to "Buat Kode Pasien", generate_patient_code_activity_log_path(@activity_log), method: :post,
              class: "text-sm bg-indigo-50 text-indigo-700 font-medium px-4 py-2 rounded-xl hover:bg-indigo-100" %>
      <% end %>
    </div>
  <% end %>

  <%= link_to "← Kembali ke Logbook", activity_logs_path, class: "mt-6 inline-block text-sm text-gray-500 hover:text-indigo-600" %>
</div>
