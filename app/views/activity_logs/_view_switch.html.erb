<%# Daftar & Kalender = dua tampilan atas data yang sama, jadi sidebar hanya
    memuat satu menu (Logbook Kegiatan) dan perpindahannya lewat sakelar ini. %>
<% seg = ->(on) { "px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors #{on ? 'bg-white text-indigo-700 shadow-sm' : 'text-gray-500 hover:text-gray-800'}" } %>
<nav aria-label="Tampilan logbook" class="inline-flex items-center gap-0.5 rounded-xl bg-gray-100 p-0.5">
  <%= link_to "Daftar", activity_logs_path, class: seg.call(current == :list),
        aria: { current: (current == :list ? "page" : nil) } %>
  <%= link_to term("nav.calendar"), activity_logs_calendar_path, class: seg.call(current == :calendar),
        aria: { current: (current == :calendar ? "page" : nil) } %>
</nav>
