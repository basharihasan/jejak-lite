<%= link_to activity_log_path(activity_log), class: "block bg-white rounded-2xl ring-1 ring-gray-200 p-5 hover:ring-indigo-300 transition" do %>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <div class="flex items-center gap-2">
        <span class="text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full <%= activity_log.category == "klinis" ? "bg-sky-50 text-sky-700" : "bg-emerald-50 text-emerald-700" %>">
          <%= activity_log.category_label %>
        </span>
        <% if activity_log.activity_type.present? %>
          <span class="text-xs text-gray-400"><%= activity_log.activity_type %></span>
        <% end %>
      </div>
      <p class="mt-1.5 font-semibold text-gray-800 truncate"><%= activity_log.title %></p>
      <p class="text-xs text-gray-400 mt-1"><%= l(activity_log.activity_date, format: :long) %></p>
    </div>
    <% if activity_log.evidence_files.attached? %>
      <span class="text-xs text-gray-400 shrink-0">📎 <%= activity_log.evidence_files.count %></span>
    <% end %>
  </div>
<% end %>
