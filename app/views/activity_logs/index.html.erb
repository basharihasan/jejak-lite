<style>
  .pagination { display: flex; gap: 0.25rem; margin-top: 1.5rem; justify-content: center; }
  .pagination span, .pagination a { padding: 0.4rem 0.75rem; border-radius: 0.5rem; font-size: 0.8rem; }
  .pagination a { color: #4f46e5; border: 1px solid #e5e7eb; }
  .pagination a:hover { background: #eef2ff; }
  .pagination .current { background: #4f46e5; color: white; font-weight: 600; }
  .pagination .page.disabled { color: #d1d5db; }
</style>

<div class="flex items-center justify-between flex-wrap gap-3">
  <h1 class="text-xl font-bold text-gray-900">Logbook Kegiatan</h1>
  <div class="flex items-center gap-2">
    <%= link_to "Kalender", activity_logs_calendar_path, class: "text-sm text-gray-600 hover:text-indigo-600 font-medium" %>
    <%= link_to "Portfolio", portfolio_path, class: "text-sm text-gray-600 hover:text-indigo-600 font-medium" %>
    <%= link_to "+ Catat Kegiatan", new_activity_log_path,
          class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl text-sm" %>
  </div>
</div>

<div class="mt-4 flex items-center gap-2">
  <%= link_to "Semua", activity_logs_path, class: "text-xs px-3 py-1.5 rounded-full font-medium #{@category.nil? ? 'bg-indigo-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
  <% ActivityLog::CATEGORIES.each do |code, label| %>
    <%= link_to label, activity_logs_path(category: code), class: "text-xs px-3 py-1.5 rounded-full font-medium #{@category == code ? 'bg-indigo-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
  <% end %>
</div>

<div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
  <% if @activity_logs.any? %>
    <%= render partial: "activity_log_card", collection: @activity_logs, as: :activity_log %>
  <% else %>
    <p class="text-sm text-gray-400 col-span-2">Belum ada kegiatan tercatat.</p>
  <% end %>
</div>

<%= paginate @activity_logs %>
