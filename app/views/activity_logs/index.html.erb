<div class="flex items-center justify-between flex-wrap gap-3">
  <h1 class="text-xl font-bold text-gray-900">Logbook Kegiatan</h1>
  <div class="flex items-center gap-2">
    <%= link_to "Kalender", activity_logs_calendar_path, class: "text-sm text-gray-600 hover:text-indigo-600 font-medium" %>
    <%= link_to "Portfolio", portfolio_path, class: "text-sm text-gray-600 hover:text-indigo-600 font-medium" %>
    <%= link_to "+ Catat Kegiatan", new_activity_log_path,
          class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl text-sm" %>
  </div>
</div>

<div class="mt-4 flex flex-wrap items-center gap-2">
  <%= link_to "Semua", activity_logs_path, class: "text-xs px-3 py-1.5 rounded-full font-medium #{@category.nil? ? 'bg-indigo-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
  <% ActivityLog::CATEGORIES.each do |code, label| %>
    <%= link_to label, activity_logs_path(category: code), class: "text-xs px-3 py-1.5 rounded-full font-medium #{@category == code ? 'bg-indigo-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
  <% end %>
</div>

<% if @all_competency_items.any? %>
  <div class="mt-2 flex flex-wrap items-center gap-1.5">
    <span class="text-xs text-gray-400">Kompetensi:</span>
    <% @all_competency_items.each do |item| %>
      <%= link_to item.title, activity_logs_path(category: @category, competency_item_id: item.id),
            class: "text-[11px] px-2 py-1 rounded-full font-medium #{@competency_item_id == item.id.to_s ? 'bg-indigo-100 text-indigo-700' : 'bg-gray-50 text-gray-500 hover:bg-gray-100'}" %>
    <% end %>
    <% if @competency_item_id %>
      <%= link_to "✕ Hapus filter", activity_logs_path(category: @category), class: "text-[11px] text-gray-400 hover:text-rose-600" %>
    <% end %>
  </div>
<% end %>

<div class="mt-4 space-y-6">
  <% if @activity_logs_by_date.any? %>
    <% @activity_logs_by_date.each do |date, logs| %>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2"><%= l(date, format: :long) %></p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <%= render partial: "activity_log_card", collection: logs, as: :activity_log %>
        </div>
      </div>
    <% end %>
  <% else %>
    <p class="text-sm text-gray-400">Belum ada kegiatan tercatat.</p>
  <% end %>
</div>
