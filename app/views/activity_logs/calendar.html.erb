<% content_for :title, term("terms.activity_calendar") %>
<div class="flex items-center justify-between flex-wrap gap-3">
  <h1 class="text-xl font-bold text-gray-900"><%= term("terms.activity_calendar") %></h1>
  <div class="flex items-center gap-3 flex-wrap">
    <%= render "view_switch", current: :calendar %>
    <%= link_to "‹", activity_logs_calendar_path(bulan: (@month - 1.month).strftime("%Y-%m")), class: "h-8 w-8 flex items-center justify-center rounded-lg bg-white ring-1 ring-gray-200 hover:bg-gray-50 text-gray-500" %>
    <span class="text-sm font-semibold text-gray-700 w-32 text-center"><%= l(@month, format: "%B %Y") %></span>
    <%= link_to "›", activity_logs_calendar_path(bulan: (@month + 1.month).strftime("%Y-%m")), class: "h-8 w-8 flex items-center justify-center rounded-lg bg-white ring-1 ring-gray-200 hover:bg-gray-50 text-gray-500" %>
    <%= link_to "+ Catat Kegiatan", new_activity_log_path,
          class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl text-sm" %>
  </div>
</div>

<div class="mt-4 bg-white rounded-2xl ring-1 ring-gray-200 p-4">
  <div class="grid grid-cols-7 gap-1 text-center text-xs font-semibold text-gray-400 mb-2">
    <% %w[Min Sen Sel Rab Kam Jum Sab].each do |d| %>
      <div><%= d %></div>
    <% end %>
  </div>
  <div class="grid grid-cols-7 gap-1">
    <% @month.wday.times do %>
      <div></div>
    <% end %>
    <% (@month..@month.end_of_month).each do |day| %>
      <div class="aspect-square rounded-lg border p-1 text-xs relative <%= day == Date.current ? "border-indigo-300 bg-indigo-50" : "border-gray-100" %>">
        <span class="text-gray-600"><%= day.day %></span>
        <% if @logs_by_day[day].present? %>
          <div class="absolute bottom-1 left-1 right-1 flex justify-center gap-0.5">
            <span class="h-1.5 w-1.5 rounded-full <%= @logs_by_day[day].all?(&:verified?) ? "bg-emerald-500" : "bg-indigo-500" %>"
                  title="<%= @logs_by_day[day].all?(&:verified?) ? "Semua kegiatan hari ini terverifikasi" : "Ada kegiatan yang belum diverifikasi" %>"></span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div class="mt-2 flex items-center gap-4 text-[11px] text-gray-400">
  <span class="flex items-center gap-1"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500 inline-block"></span> Semua terverifikasi</span>
  <span class="flex items-center gap-1"><span class="h-1.5 w-1.5 rounded-full bg-indigo-500 inline-block"></span> Ada yang belum diverifikasi</span>
</div>

<div class="mt-6 space-y-2">
  <% @logs_by_day.sort.each do |day, logs| %>
    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase mb-1"><%= l(day, format: :long) %></p>
      <div class="space-y-1.5">
        <%= render partial: "activity_log_card", collection: logs, as: :activity_log %>
      </div>
    </div>
  <% end %>
  <% if @logs_by_day.empty? %>
    <p class="text-sm text-gray-400">Tidak ada kegiatan tercatat di bulan ini.</p>
  <% end %>
</div>

<div class="mt-8 bg-gray-50 rounded-2xl ring-1 ring-gray-200 p-4 flex items-center justify-between gap-3 flex-wrap">
  <div>
    <p class="text-sm font-semibold text-gray-700">Feed Kalender (iCal)</p>
    <p class="text-xs text-gray-400 mt-0.5">Tempel tautan ini di Google Calendar/Apple Calendar untuk sinkron otomatis.</p>
    <code class="text-xs text-indigo-600 break-all"><%= activity_logs_feed_url(token: current_user.calendar_feed_token!) %></code>
  </div>
  <%= button_to "Perbarui Tautan", reset_calendar_feed_token_path, method: :post,
        class: "text-xs text-gray-500 hover:text-rose-600 font-medium whitespace-nowrap",
        form: { data: { turbo_confirm: "Tautan lama akan berhenti berfungsi. Lanjutkan?" } } %>
</div>
