<% content_for :title, "Peta EPA & Tingkat Entrustment" %>
<% level_cls = { nil => "bg-gray-100 text-gray-500", 1 => "bg-rose-100 text-rose-700", 2 => "bg-amber-100 text-amber-700", 3 => "bg-sky-100 text-sky-700", 4 => "bg-emerald-100 text-emerald-700", 5 => "bg-indigo-100 text-indigo-700" } %>
<div class="space-y-5">
  <div>
    <h1 class="text-xl font-bold text-gray-900">Peta EPA & Tingkat Entrustment</h1>
    <p class="text-sm text-gray-500 mt-0.5">
      <%= @student == current_user ? "Level kepercayaan klinis Anda" : "Level kepercayaan klinis #{@student.full_name}" %> per ranah kompetensi (skala 1–5). Terisi otomatis saat kasus diverifikasi dengan ranah EPA terpilih, atau manual oleh pembimbing. Penilaian baru menggantikan yang lama; riwayat tetap tersimpan.
    </p>
  </div>

  <% if @framework.nil? %>
    <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-6 text-sm text-gray-400">Belum ada kerangka kompetensi. Admin membuatnya di Konfigurasi → Kerangka Kompetensi.</div>
  <% else %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @map.each do |item, decision| %>
        <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5 flex flex-col">
          <div class="flex items-start justify-between gap-2">
            <p class="text-sm font-semibold text-gray-800"><%= item.title %></p>
            <span class="shrink-0 text-lg font-black h-9 w-9 rounded-full flex items-center justify-center <%= level_cls[decision&.level] %>"><%= decision&.level || "–" %></span>
          </div>
          <% if decision %>
            <p class="text-xs text-gray-600 mt-1"><%= decision.level_label %></p>
            <p class="text-xs text-gray-500 mt-2 whitespace-pre-line flex-1"><%= decision.justification %></p>
            <p class="text-[10px] text-gray-400 mt-2"><%= decision.decided_by.full_name %> · <%= l(decision.created_at, format: :short) %><%= " · dari kasus" if decision.clinical_case %></p>
          <% else %>
            <p class="text-xs text-gray-400 mt-1 flex-1">Belum ada penilaian.</p>
          <% end %>
          <% if @can_decide %>
            <details class="mt-3">
              <summary class="cursor-pointer text-xs font-semibold text-indigo-600 hover:underline list-none"><%= decision ? "Perbarui Penilaian" : "Isi Penilaian" %></summary>
              <%= form_with url: entrustment_decisions_path, method: :post, class: "mt-2 space-y-2" do |f| %>
                <%= hidden_field_tag :student_id, @student.id %>
                <%= hidden_field_tag :competency_item_id, item.id %>
                <%= select_tag :level, options_for_select(EntrustmentDecision::LEVELS.map { |n, l| [ "#{n} — #{l}", n ] }, decision&.level), class: "block w-full rounded-xl border-0 py-2 pl-3 pr-8 text-xs ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500" %>
                <%= text_area_tag :justification, nil, rows: 3, required: true, minlength: EntrustmentDecision::MIN_JUSTIFICATION, placeholder: "Justifikasi naratif (observasi yang mendasari)...", class: "block w-full rounded-xl border-0 py-2 px-3 text-xs ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500" %>
                <%= submit_tag "Simpan", class: "rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold px-3 py-1.5 cursor-pointer" %>
              <% end %>
            </details>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @history.any? %>
      <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
        <p class="text-sm font-semibold text-gray-800 mb-3">Riwayat keputusan</p>
        <div class="divide-y divide-gray-100">
          <% @history.each do |d| %>
            <div class="py-2 flex items-start gap-3 text-sm <%= 'opacity-50' if d.superseded_at %>">
              <span class="shrink-0 text-xs font-black h-6 w-6 rounded-full flex items-center justify-center <%= level_cls[d.level] %>"><%= d.level %></span>
              <div class="min-w-0">
                <p class="text-gray-800"><span class="font-semibold"><%= d.competency_item.title %></span> <span class="text-xs text-gray-400">· <%= d.decided_by.full_name %> · <%= l(d.created_at, format: :short) %><%= d.revoked? ? " · dicabut (verifikasi dibatalkan)" : (" · tergantikan" if d.superseded_at) %></span></p>
                <p class="text-xs text-gray-500"><%= d.justification %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
