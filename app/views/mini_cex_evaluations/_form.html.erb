<%= form_with model: mini_cex_evaluation, class: "space-y-4" do |f| %>
  <% if mini_cex_evaluation.errors.any? %>
    <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
      <%= mini_cex_evaluation.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :student_id, "Mahasiswa", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.collection_select :student_id, @students, :id, :full_name, { include_blank: "Pilih mahasiswa..." },
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm", data: { controller: "searchable-select" } %>
    </div>
    <div>
      <%= f.label :clinical_rotation_id, "Rotasi", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.collection_select :clinical_rotation_id, @clinical_rotations, :id, ->(r) { "#{r.station_name} — #{r.user.full_name}" }, { include_blank: "Pilih rotasi..." },
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm",
            data: { controller: "searchable-select", searchable_select_placeholder_value: "Ketik nama stase atau mahasiswa…" } %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :case_description, "Kasus yang Diamati", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :case_description, placeholder: "Contoh: Anamnesis pasien demam berdarah",
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
    <div>
      <%= f.label :evaluated_at, "Tanggal Penilaian", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.date_field :evaluated_at,
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div>
      <%= f.label :clinical_setting, "Setting Klinis", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.select :clinical_setting, options_for_select(ClinicalContextOptions::CLINICAL_SETTINGS.invert, mini_cex_evaluation.clinical_setting), { include_blank: "-" },
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
    <div>
      <%= f.label :patient_age_group, "Usia Pasien", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.select :patient_age_group, options_for_select(ClinicalContextOptions::AGE_GROUPS.invert, mini_cex_evaluation.patient_age_group), { include_blank: "-" },
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
    <div>
      <%= f.label :case_complexity, "Kompleksitas", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.select :case_complexity, options_for_select(ClinicalContextOptions::CASE_COMPLEXITY.invert, mini_cex_evaluation.case_complexity), { include_blank: "-" },
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
    <div>
      <%= f.label :observation_minutes, "Durasi Observasi (menit)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.number_field :observation_minutes, min: 0,
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
  </div>

  <div class="bg-white rounded-2xl ring-1 ring-gray-200 p-5">
    <p class="text-sm font-semibold text-gray-700 mb-1">Rubrik Penilaian (skala 1–9)</p>
    <p class="text-xs text-gray-400 mb-3">1–3 di bawah harapan · 4–6 sesuai harapan · 7–9 melebihi harapan. Dimensi bertanda * wajib diisi.</p>
    <div class="space-y-4">
      <% MiniCexEvaluation::DIMENSIONS.each do |key, label| %>
        <%= render "shared/dimension_score_radio", form_name: "mini_cex_evaluation", key: key, label: label,
              required: MiniCexEvaluation::REQUIRED_DIMENSIONS.include?(key), current_value: mini_cex_evaluation.score_for(key) %>
      <% end %>
    </div>
  </div>

  <div class="bg-indigo-50/50 rounded-2xl ring-1 ring-indigo-100 p-5">
    <p class="text-sm font-semibold text-gray-700 mb-3">Penilaian Global *</p>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
      <% MiniCexEvaluation::GLOBAL_RATING_OPTIONS.each do |value, label| %>
        <label class="cursor-pointer">
          <input type="radio" name="mini_cex_evaluation[global_rating]" value="<%= value %>"
                 class="peer sr-only" <%= "checked" if mini_cex_evaluation.global_rating == value %>>
          <span class="flex items-center justify-center text-center h-full px-2 py-2.5 rounded-xl text-xs font-semibold ring-1 ring-inset ring-gray-200 bg-white text-gray-500 peer-checked:ring-2 peer-checked:ring-indigo-500 peer-checked:bg-indigo-50 peer-checked:text-indigo-700"><%= label %></span>
        </label>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :video_recording_url, "Tautan Rekaman Video (opsional)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.url_field :video_recording_url, placeholder: "https://...",
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
    <div>
      <%= f.label :feedback_minutes, "Durasi Umpan Balik (menit)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.number_field :feedback_minutes, min: 0,
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" %>
    </div>
  </div>

  <div>
    <%= f.label :overall_feedback, "Umpan Balik Keseluruhan", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.text_area :overall_feedback, rows: 3,
          class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm resize-none" %>
  </div>

  <div class="flex items-center gap-3">
    <button type="submit" name="mini_cex_evaluation[status]" value="draft"
          class="bg-white hover:bg-gray-50 text-gray-700 font-semibold px-5 py-2.5 rounded-xl text-sm ring-1 ring-inset ring-gray-300 cursor-pointer">
      Simpan Draf
    </button>
    <button type="submit" name="mini_cex_evaluation[status]" value="submitted"
          class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm cursor-pointer">
      Kirim Evaluasi
    </button>
  </div>
<% end %>
