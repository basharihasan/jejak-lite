# Salin berkas ini jadi ".env" (jangan commit ".env" ke git — sudah
# gitignored), isi tiap nilainya, lalu `docker compose up -d`.

# Kata sandi database Postgres milik kontainer ini sendiri — bebas pilih,
# cukup panjang & acak (mis. `openssl rand -hex 24`). Tidak perlu dicatat
# di tempat lain; hanya dipakai kontainer db & web saling terhubung.
POSTGRES_PASSWORD=

# Kunci penanda tangan sesi/cookie. Bangkitkan SEKALI lalu simpan:
#   openssl rand -hex 64
# Image self-hosted tidak memuat config/credentials.yml.enc, jadi
# RAILS_MASTER_KEY TIDAK diperlukan lagi.
SECRET_KEY_BASE=

# Hasil `bin/rails db:encryption:init` — jalankan sekali di komputer Anda,
# salin 3 nilainya ke sini. KHUSUS untuk deployment NAS ini; jangan pakai
# ulang kunci yang sama untuk deployment lain (trial online, dsb.).
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=

# Alamat NAS Anda diakses dari jaringan — IP lokal (mis. 192.168.1.50:3000),
# domain DDNS QNAP (mis. namananda.myqnapcloud.com:3000), atau domain sendiri
# kalau sudah diarahkan. Dipakai tautan di email konfirmasi/reset password.
APP_HOST=192.168.1.50:3000

# Port di NAS yang dipetakan ke container (default 3000). Ganti kalau port
# itu sudah dipakai layanan lain di NAS Anda.
HOST_PORT=3000

# Opsional — simpan unggahan di Cloudflare R2 alih-alih volume lokal.
# Kosongkan bila volume storage di NAS sudah persisten.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
