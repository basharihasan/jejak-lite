# Salin jadi ".env" ATAU jalankan generator (tanpa Ruby):
#   Linux/macOS:  ./script/setup-env.sh
#   Windows:      script\setup-env.cmd
# Lalu: docker compose pull && docker compose up -d

# Kata sandi Postgres antar-kontainer (acak, mis. openssl rand -hex 24).
POSTGRES_PASSWORD=

# Penanda tangan sesi. Image self-hosted tidak memuat credentials.yml.enc —
# RAILS_MASTER_KEY tidak dipakai di Compose. Mis. openssl rand -hex 64
SECRET_KEY_BASE=

# Enkripsi identitas pasien — tiga nilai BERBEDA per deployment.
# openssl rand -hex 16  (×3)  — setara db:encryption:init, tanpa Ruby.
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=

# URL yang dibuka browser (harus cocok), mis. 192.168.1.50:3000
APP_HOST=192.168.1.50:3000

# Port di HOST → dipetakan ke 3000 di dalam kontainer.
HOST_PORT=3000

# LAN HTTP: false (kalau true di HTTP polos, login sering 422).
ASSUME_SSL=false
FORCE_SSL=false

# Opsional — Cloudflare R2 (kosong = volume lokal).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Opsional — hanya untuk docker-compose.https.yml
# CADDY_DOMAIN=jejak.example.com
