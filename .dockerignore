# Meniru .gitignore untuk konteks build Docker — jangan salin apa pun yang
# gitignored (rahasia, artefak lokal) ke dalam image.
.git/
.github/
.gitignore
.dockerignore
tmp/*
!tmp/.keep
log/*
!log/.keep
storage/*
!storage/.keep
public/assets
public/packs
node_modules/
.env
.env.*
config/master.key
# credentials.yml.enc sengaja TIDAK ikut: image self-hosted memasok seluruh
# rahasia lewat ENV (SECRET_KEY_BASE + AR_ENCRYPTION_*). Dengan berkas ini
# absen, Rails tidak pernah perlu RAILS_MASTER_KEY — menghapus satu langkah
# rapuh (salah tempel kunci = gagal boot) pada pemasangan pelanggan.
config/credentials.yml.enc
coverage/
test/screenshots/
*.pem
Dockerfile
docker-compose*.yml
# Dokumentasi repo di root — TAPI BUKAN app/views/panduan/panduan.md, yang
# dibaca runtime oleh PanduanController (halaman /panduan pengguna).
/*.md

